---
import Base from '../layouts/Base.astro';
import Flight from '../components/Flight.astro';
import Hero from '../components/Hero.astro';
import Pain from '../components/Pain.astro';
import ServicesPinned from '../components/ServicesPinned.astro';
import Services from '../components/Services.astro';
import Calculator from '../components/Calculator.astro';
import Proof from '../components/Proof.astro';
import Method from '../components/Method.astro';
import CaseList from '../components/CaseList.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
---

<Base
  locale="ru"
  altPath="/en/"
  darkHero
  title="Разработка систем, которые работают без вас"
  description="AI-автоматизация, чат-боты, сайты и веб-сервисы, мобильные приложения, бэкенд и интеграции, торговые системы. Фиксированная смета, код и доступы ваши с первого дня."
>
  <Flight locale="ru" />
  <Pain locale="ru" />
  <ServicesPinned locale="ru" />
  <Services locale="ru" />
  <Calculator locale="ru" />
  <Proof locale="ru" />
  <Method locale="ru" />
  <CaseList locale="ru" limit={4} />
  <Pricing locale="ru" />
  <Faq locale="ru" />
  <Contact locale="ru" />
</Base>
