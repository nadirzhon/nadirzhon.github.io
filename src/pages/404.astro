---
import Base from '../layouts/Base.astro';
---

<Base locale="ru" altPath="/en/" title="Страница не найдена" description="Такой страницы нет.">
  <section class="shell flex min-h-[60vh] flex-col justify-center py-20">
    <p class="plate">Ошибка 404</p>
    <h1 class="mt-6 text-big">Такой страницы нет</h1>
    <p class="mt-5 max-w-lg text-[1.02rem] leading-relaxed text-slate-2">
      Ссылка устарела или в адресе опечатка. С главной можно дойти до всего остального.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">На главную</a>
      <a href="/keysy/" class="btn btn-ghost">Кейсы</a>
    </div>
  </section>
</Base>
