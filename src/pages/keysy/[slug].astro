---
import Shots from '../../components/Shots.astro';
import { url } from '../../data/site';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { tr } from '../../data/i18n';

export async function getStaticPaths() {
  const items = await getCollection('cases', (c) => c.data.lang === 'ru' && !c.data.draft);
  return items.map((item) => ({ params: { slug: item.id.replace(/-ru$/, '') }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);

// Экраны рабочей системы. Пока они есть только у HEAN — привязываем по slug,
// чтобы не тащить пути в тексты кейсов.
const shotsBySlug: Record<string, { src: string; title: string; note: string }[]> = {
  'hean-ru': [
    { src: '/work/hean/live-dashboard.jpg', title: 'Живая панель',
      note: 'Состояние счёта, кривая капитала, риск-статус и открытые позиции в реальном времени' },
    { src: '/work/hean/tactical-center.jpg', title: 'Тактический центр',
      note: 'Что система решает прямо сейчас и почему — сигналы, фильтры, причины отказов' },
    { src: '/work/hean/risk-center.jpg', title: 'Риск-контур',
      note: 'Лимиты, просадка, аварийная остановка. Защита депозита отдельным слоем' },
    { src: '/work/hean/physics-lab.jpg', title: 'Физическая лаборатория',
      note: 'Рыночная термодинамика: температура, энтропия, определение фазы рынка' },
    { src: '/work/hean/neuro-map.jpg', title: 'Нейрокарта',
      note: 'Связи между инструментами и переток влияния между ними' },
    { src: '/work/hean/sota-modules.jpg', title: 'Модули интеллекта',
      note: 'Пятнадцать стратегий и слой принятия решений: что включено и как себя ведёт' },
  ],
};
const shots = shotsBySlug[item.id] ?? [];
const d = item.data;
---

<Base locale="ru" altPath={`/en/work/${item.id.replace(/-ru$/, '')}/`} title={d.title} description={d.summary} ogType="article">
  <article>
    <header class="border-b border-slate-1/20 py-14 md:py-20">
      <div class="shell">
        <nav class="flex items-center gap-2 font-mono text-[0.7rem] tracking-widest text-slate-1 uppercase">
          <a href={url("/keysy/")} class="transition-colors hover:text-steel-50">{tr('casesAll', 'ru')}</a>
          <span aria-hidden="true">/</span><span>{d.year}</span>
        </nav>

        <h1 class="mt-8 max-w-4xl text-big">{d.title}</h1>
        <p class="mt-6 max-w-2xl text-[1.08rem] leading-relaxed text-steel-300">{d.summary}</p>

        <dl class="mt-10 grid gap-px border border-slate-1/25 bg-slate-1/25 sm:grid-cols-3">
          <div class="bg-ink-800 px-5 py-4">
            <dt class="plate">{tr('caseYear', 'ru')}</dt>
            <dd class="mt-1.5 font-mono text-[0.95rem]">{d.year}</dd>
          </div>
          <div class="bg-ink-800 px-5 py-4">
            <dt class="plate">{tr('caseRole', 'ru')}</dt>
            <dd class="mt-1.5 text-[0.95rem]">{d.role}</dd>
          </div>
          <div class="bg-ink-800 px-5 py-4">
            <dt class="plate">{tr('serviceStack', 'ru')}</dt>
            <dd class="mt-1.5 text-[0.9rem] text-steel-300">{d.stack.join(' · ')}</dd>
          </div>
        </dl>

        {
          d.outcomes.length > 0 && (
            <dl class="mt-px grid gap-px border-x border-b border-slate-1/25 bg-slate-1/25 sm:grid-cols-2 lg:grid-cols-4">
              {d.outcomes.map((o) => (
                <div class="bg-ink px-5 py-6">
                  <dt class="font-display text-[1.8rem] leading-none font-bold text-brass">{o.value}</dt>
                  <dd class="mt-2.5 text-[0.82rem] leading-snug text-steel-300">{o.label}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </header>

    <div class="shell py-14 md:py-20">
      <div class="prose"><Content /></div>

      <div class="mt-16 border-t border-slate-1/25 pt-10">
        <a href={url("/#kontakt")} class="btn btn-primary mag">{tr('navContact', 'ru')} <span aria-hidden="true">→</span></a>
      </div>
    </div>

    {
      shots.length > 0 && (
        <Shots
          shots={shots}
          plate="Экраны"
          lead="Снимки рабочей системы, а не макеты. Нажмите на любой — откроется во весь экран."
        />
      )
    }
  </article>
</Base>
