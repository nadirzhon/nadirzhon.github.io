---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { tr } from '../../../data/i18n';

export async function getStaticPaths() {
  const items = await getCollection('cases', (c) => c.data.lang === 'en' && !c.data.draft);
  return items.map((item) => ({ params: { slug: item.id.replace(/-en$/, '') }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
---

<Base locale="en" altPath={`/keysy/${item.id.replace(/-en$/, '')}/`} title={d.title} description={d.summary} ogType="article">
  <article>
    <header class="border-b border-slate-1/20 py-14 md:py-20">
      <div class="shell">
        <nav class="flex items-center gap-2 font-mono text-[0.7rem] tracking-widest text-slate-1 uppercase">
          <a href="/en/work/" class="transition-colors hover:text-ink">{tr('casesAll', 'en')}</a>
          <span aria-hidden="true">/</span><span>{d.year}</span>
        </nav>

        <h1 class="mt-8 max-w-4xl text-big">{d.title}</h1>
        <p class="mt-6 max-w-2xl text-[1.08rem] leading-relaxed text-slate-2">{d.summary}</p>

        <dl class="mt-10 grid gap-px border border-slate-1/25 bg-slate-1/25 sm:grid-cols-3">
          <div class="bg-steel-50 px-5 py-4">
            <dt class="plate">{tr('caseYear', 'en')}</dt>
            <dd class="mt-1.5 font-mono text-[0.95rem]">{d.year}</dd>
          </div>
          <div class="bg-steel-50 px-5 py-4">
            <dt class="plate">{tr('caseRole', 'en')}</dt>
            <dd class="mt-1.5 text-[0.95rem]">{d.role}</dd>
          </div>
          <div class="bg-steel-50 px-5 py-4">
            <dt class="plate">{tr('serviceStack', 'en')}</dt>
            <dd class="mt-1.5 text-[0.9rem] text-slate-2">{d.stack.join(' · ')}</dd>
          </div>
        </dl>

        {
          d.outcomes.length > 0 && (
            <dl class="mt-px grid gap-px border-x border-b border-slate-1/25 bg-slate-1/25 sm:grid-cols-2 lg:grid-cols-4">
              {d.outcomes.map((o) => (
                <div class="bg-ink px-5 py-6">
                  <dt class="font-display text-[1.8rem] leading-none font-bold text-brass">{o.value}</dt>
                  <dd class="mt-2.5 text-[0.82rem] leading-snug text-steel-300">{o.label}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </header>

    <div class="shell py-14 md:py-20">
      <div class="prose"><Content /></div>

      <div class="mt-16 border-t border-slate-1/25 pt-10">
        <a href="/en/#contact" class="btn btn-primary">{tr('navContact', 'en')} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </article>
</Base>
