---
import Base from '../../../layouts/Base.astro';
import CaseList from '../../../components/CaseList.astro';
import { tr } from '../../../data/i18n';
---

<Base
  locale="en"
  altPath="/keysy/"
  title="Selected work"
  description="Project write-ups: what it was, what was built, where it hurt, and what changed in numbers."
>
  <section class="border-b border-slate-1/20 py-14 md:py-20">
    <div class="shell">
      <p class="plate">{tr('casesPlate', 'en')}</p>
      <h1 class="mt-6 text-big">{tr('casesTitle', 'en')}</h1>
      <p class="mt-5 max-w-2xl text-[1.02rem] leading-relaxed text-steel-300">
        Every write-up follows the same shape: the problem, what was built, where it hurt, the outcome. The only numbers
        here are measurable ones — you can verify them yourself by opening the code or timing the page.
      </p>
    </div>
  </section>
  <CaseList locale="en" showHeading={false} />
</Base>
