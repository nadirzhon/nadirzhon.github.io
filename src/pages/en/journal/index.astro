---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { tr } from '../../../data/i18n';
---

<Base
  locale="en"
  altPath="/blog/"
  title="Engineering journal"
  description="Write-ups on reliability, automation and trading infrastructure — problems that burned me and solutions that held."
>
  <section class="border-b border-slate-1/20 py-14 md:py-20">
    <div class="shell">
      <p class="plate">{tr('blogPlate', 'en')}</p>
      <h1 class="mt-6 text-big">{tr('blogTitle', 'en')}</h1>
      <p class="mt-5 max-w-2xl text-[1.02rem] leading-relaxed text-steel-300">{tr('blogLead', 'en')}</p>
    </div>
  </section>

  <div class="shell py-14 md:py-16"><PostList locale="en" /></div>
</Base>
