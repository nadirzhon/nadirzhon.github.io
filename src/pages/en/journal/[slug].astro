---
import { url } from '../../../data/site';
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { tr } from '../../../data/i18n';

export async function getStaticPaths() {
  const items = await getCollection('posts', (p) => p.data.lang === 'en' && !p.data.draft);
  return items.map((item) => ({ params: { slug: item.id.replace(/-en$/, '') }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
const date = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(d.date);
---

<Base locale="en" altPath="/blog/" title={d.title} description={d.description} ogType="article">
  <article class="shell py-14 md:py-20">
    <nav class="flex items-center gap-2 font-mono text-[0.7rem] tracking-widest text-slate-1 uppercase">
      <a href={url("/en/journal/")} class="transition-colors hover:text-steel-50">{tr('blogBack', 'en')}</a>
      <span aria-hidden="true">/</span><span>{date}</span>
      <span aria-hidden="true">/</span><span>{d.readingTime} {tr('minRead', 'en')}</span>
    </nav>

    <h1 class="mt-8 max-w-4xl text-big">{d.title}</h1>
    <p class="mt-5 max-w-2xl text-[1.08rem] leading-relaxed text-steel-300">{d.description}</p>

    <hr class="mt-10 border-slate-1/25" />

    <div class="prose mt-12"><Content /></div>

    <aside class="mt-16 max-w-2xl border border-slate-1/30 bg-ink-700/60 p-7">
      <p class="plate">Next</p>
      <p class="mt-3 text-[1rem] leading-relaxed text-steel-300">
        If you have a similar problem — silent failures, routine work that should belong to a machine, or a system
        nobody dares to touch — tell me about it. The first call is free and commits you to nothing.
      </p>
      <a href={url("/en/#contact")} class="btn btn-primary mt-6">Start a project <span aria-hidden="true">→</span></a>
    </aside>
  </article>
</Base>
