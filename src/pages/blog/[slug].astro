---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { tr } from '../../data/i18n';

export async function getStaticPaths() {
  const items = await getCollection('posts', (p) => p.data.lang === 'ru' && !p.data.draft);
  return items.map((item) => ({ params: { slug: item.id.replace(/-ru$/, '') }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
const date = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).format(d.date);
---

<Base locale="ru" altPath="/en/journal/" title={d.title} description={d.description} ogType="article">
  <article class="shell py-14 md:py-20">
    <nav class="flex items-center gap-2 font-mono text-[0.7rem] tracking-widest text-slate-1 uppercase">
      <a href="/blog/" class="transition-colors hover:text-ink">{tr('blogBack', 'ru')}</a>
      <span aria-hidden="true">/</span><span>{date}</span>
      <span aria-hidden="true">/</span><span>{d.readingTime} {tr('minRead', 'ru')}</span>
    </nav>

    <h1 class="mt-8 max-w-4xl text-big">{d.title}</h1>
    <p class="mt-5 max-w-2xl text-[1.08rem] leading-relaxed text-slate-2">{d.description}</p>

    <hr class="mt-10 border-slate-1/25" />

    <div class="prose mt-12"><Content /></div>

    <aside class="mt-16 max-w-2xl border border-slate-1/30 bg-steel-100/60 p-7">
      <p class="plate">Дальше</p>
      <p class="mt-3 text-[1rem] leading-relaxed text-slate-2">
        Если у вас похожая задача — молчаливые отказы, рутина, которую пора отдать машине, или система, которую страшно
        трогать, — расскажите о ней. Первый разговор бесплатный и ни к чему не обязывает.
      </p>
      <a href="/#kontakt" class="btn btn-primary mt-6">Обсудить задачу <span aria-hidden="true">→</span></a>
    </aside>
  </article>
</Base>
