---
/**
 * Временная страница диагностики формы.
 * Показывает полный ответ Web3Forms прямо на экране.
 * После того как форма заработает, файл можно удалить.
 */
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base locale="ru" altPath="/en/" title="Проверка формы" description="Служебная страница диагностики.">
  <section class="shell py-16 md:py-24">
    <p class="plate">Служебная страница</p>
    <h1 class="mt-5 text-big">Проверка отправки заявок</h1>
    <p class="mt-5 max-w-2xl text-[1.02rem] leading-relaxed text-slate-2">
      Нажмите кнопку. Внизу появится полный ответ сервиса — по нему видно, дошла заявка или нет и что
      именно пошло не так.
    </p>

    <dl class="mt-8 max-w-2xl divide-y divide-slate-1/20 border-y border-slate-1/20 font-mono text-[0.82rem]">
      <div class="flex gap-4 py-3">
        <dt class="w-32 shrink-0 text-slate-1">ключ</dt>
        <dd class="break-all">{site.formAccessKey || '— не задан —'}</dd>
      </div>
      <div class="flex gap-4 py-3">
        <dt class="w-32 shrink-0 text-slate-1">адрес приёма</dt>
        <dd class="break-all">{site.formEndpoint}</dd>
      </div>
      <div class="flex gap-4 py-3">
        <dt class="w-32 shrink-0 text-slate-1">откуда</dt>
        <dd id="origin" class="break-all">—</dd>
      </div>
    </dl>

    <button id="run" class="btn btn-primary mt-8">Отправить проверочную заявку</button>

    <pre
      id="out"
      class="mt-8 max-w-2xl overflow-x-auto border border-slate-1/30 bg-ink p-5 font-mono text-[0.78rem] leading-relaxed whitespace-pre-wrap text-steel-100">Результат появится здесь</pre>
  </section>
</Base>

<script>
  const btn = document.getElementById('run') as HTMLButtonElement | null;
  const out = document.getElementById('out');
  const origin = document.getElementById('origin');
  if (origin) origin.textContent = location.origin;

  btn?.addEventListener('click', async () => {
    if (!out) return;
    btn.disabled = true;
    out.textContent = 'Отправляю…';

    const key = document.querySelector('dd')?.textContent?.trim() ?? '';
    const payload = {
      access_key: key,
      subject: 'ПРОВЕРКА — форма сайта',
      from_name: 'Диагностика',
      name: 'Проверочная заявка',
      contact: 'проверка',
      task: 'Служебная отправка со страницы /proverka/. Если письмо пришло — форма работает.',
    };

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const text = await res.text();
      let pretty = text;
      try {
        pretty = JSON.stringify(JSON.parse(text), null, 2);
      } catch {
        /* сервис вернул не JSON — показываем как есть */
      }
      out.textContent = `HTTP ${res.status} ${res.statusText}\n\n${pretty}`;
    } catch (err) {
      out.textContent = `Запрос не ушёл: ${String(err)}\n\nОбычно это блокировка расширением, VPN или отсутствие сети.`;
    } finally {
      btn.disabled = false;
    }
  });
</script>
