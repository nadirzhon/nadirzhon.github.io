---
import type { Locale } from '../data/site';
import { tr, faq } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="border-b border-slate-1/20 py-20 md:py-28">
  <div class="shell grid gap-10 md:grid-cols-[auto_1fr] md:gap-14">
    <p class="plate md:pt-3">{tr('faqPlate', locale)}</p>

    <div>
      <h2 class="reveal text-big">{tr('faqTitle', locale)}</h2>

      <div class="mt-10 border-t border-slate-1/25">
        {
          faq.map((f) => (
            <details class="reveal group border-b border-slate-1/25">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-[1.05rem] font-semibold transition-colors hover:text-brass md:text-[1.15rem]">
                <span>{f.q[locale]}</span>
                <span
                  aria-hidden="true"
                  class="mt-1 shrink-0 font-mono text-lg leading-none transition-transform duration-300 group-open:rotate-45"
                >
                  +
                </span>
              </summary>
              <p class="max-w-2xl pr-8 pb-7 text-[0.95rem] leading-relaxed text-slate-2">{f.a[locale]}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q[Astro.props.locale as 'ru' | 'en'],
      acceptedAnswer: { '@type': 'Answer', text: f.a[Astro.props.locale as 'ru' | 'en'] },
    })),
  })}
/>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
