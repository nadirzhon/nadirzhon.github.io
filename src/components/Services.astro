---
import { type Locale } from '../data/site';
import { tr, extraServices } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="border-b border-slate-1/20 py-20 md:py-24">
  <div class="shell">
    <!-- Задачи поменьше -->
    <div class="grid gap-6 md:grid-cols-[auto_1fr] md:gap-14">
      <p class="reveal plate md:pt-3">{tr('extraPlate', locale)}</p>
      <div>
        <h3 class="reveal text-[1.6rem] md:text-[2rem]">{tr('extraTitle', locale)}</h3>
        <p class="reveal mt-4 max-w-2xl text-[1rem] leading-relaxed text-steel-300">{tr('extraLead', locale)}</p>

        <ul data-stagger class="mt-9 grid gap-3 md:gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            extraServices.map((e) => (
              <li class="group flex items-start gap-3 panel rounded-2xl p-5 transition-colors hover:bg-ink-700">
                <span
                  aria-hidden="true"
                  class="mt-2 h-1 w-3 shrink-0 rounded-full bg-gradient-to-r from-cyan to-violet transition-all duration-300 group-hover:w-4"
                />
                <span class="text-[0.92rem] leading-snug text-steel-300">{e[locale]}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
