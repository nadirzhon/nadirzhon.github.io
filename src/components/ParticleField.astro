---
/**
 * Живое облако частиц в герое.
 * Проходит три состояния, и это не украшение — это сюжет страницы:
 * рассыпанный хаос (рутина) → сфера (система) → поток (работа без вас).
 * Частицы расступаются под курсором, форма меняется по скроллу.
 */
---

<div id="pf-wrap" class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
  <canvas id="pf-canvas" class="h-full w-full opacity-0 transition-opacity duration-1000"></canvas>
</div>

<script>
  const canvas = document.getElementById('pf-canvas') as HTMLCanvasElement | null;
  const wrap = document.getElementById('pf-wrap');
  if (canvas && wrap) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = matchMedia('(pointer: coarse)').matches;

    // Модуль тяжёлый — грузим только когда герой действительно на экране.
    const boot = async () => {
      const THREE = await import('three');

      const COUNT = coarse ? 6000 : 14000;
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(52, 1, 0.1, 100);
      camera.position.z = 7.2;

      const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false, powerPreference: 'high-performance' });
      renderer.setClearColor(0x000000, 0);

      // --- Три формы, между которыми переливается облако ---
      const chaos = new Float32Array(COUNT * 3);
      const sphere = new Float32Array(COUNT * 3);
      const stream = new Float32Array(COUNT * 3);
      const seed = new Float32Array(COUNT);

      const GOLDEN = Math.PI * (3 - Math.sqrt(5));
      for (let i = 0; i < COUNT; i++) {
        const i3 = i * 3;
        seed[i] = Math.random();

        // 1. Хаос: рассыпанное облако без порядка
        chaos[i3] = (Math.random() - 0.5) * 13;
        chaos[i3 + 1] = (Math.random() - 0.5) * 8;
        chaos[i3 + 2] = (Math.random() - 0.5) * 8;

        // 2. Сфера: точки Фибоначчи — равномерно, без швов и полюсов
        const y = 1 - (i / (COUNT - 1)) * 2;
        const r = Math.sqrt(Math.max(0, 1 - y * y));
        const th = GOLDEN * i;
        sphere[i3] = Math.cos(th) * r * 2.55;
        sphere[i3 + 1] = y * 2.55;
        sphere[i3 + 2] = Math.sin(th) * r * 2.55;

        // 3. Поток: двойная спираль, уходящая вдаль
        const t = (i / COUNT) * Math.PI * 14;
        const arm = i % 2 === 0 ? 0 : Math.PI;
        const fall = 1 - i / COUNT;
        stream[i3] = Math.cos(t + arm) * (1.15 + fall * 1.7);
        stream[i3 + 1] = (i / COUNT) * 7.5 - 3.75;
        stream[i3 + 2] = Math.sin(t + arm) * (1.15 + fall * 1.7);
      }

      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(chaos.slice(), 3));
      geo.setAttribute('aChaos', new THREE.BufferAttribute(chaos, 3));
      geo.setAttribute('aSphere', new THREE.BufferAttribute(sphere, 3));
      geo.setAttribute('aStream', new THREE.BufferAttribute(stream, 3));
      geo.setAttribute('aSeed', new THREE.BufferAttribute(seed, 1));

      const uniforms = {
        uTime: { value: 0 },
        uMorph: { value: 0 }, // 0 — хаос, 1 — сфера, 2 — поток
        uMouse: { value: new THREE.Vector3(99, 99, 0) },
        uSize: { value: Math.min(devicePixelRatio, 2) * (coarse ? 2.1 : 2.6) },
        uBrass: { value: new THREE.Color(0xc89b3c) },
        uMoss: { value: new THREE.Color(0x7fb094) },
        uSteel: { value: new THREE.Color(0xf2f4ef) },
        uIntro: { value: 0 },
      };

      const material = new THREE.ShaderMaterial({
        uniforms,
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        vertexShader: `
          uniform float uTime, uMorph, uSize, uIntro;
          uniform vec3 uMouse;
          attribute vec3 aChaos, aSphere, aStream;
          attribute float aSeed;
          varying float vGlow;
          varying float vSeed;

          void main() {
            // Плавный переход между тремя формами
            vec3 pos = mix(aChaos, aSphere, clamp(uMorph, 0.0, 1.0));
            pos = mix(pos, aStream, clamp(uMorph - 1.0, 0.0, 1.0));

            // Появление на загрузке: точки прилетают из глубины
            pos = mix(aChaos * 2.4, pos, uIntro);

            // Живое дыхание — форма никогда не застывает
            float t = uTime * 0.42 + aSeed * 6.283;
            pos.x += sin(t) * 0.075;
            pos.y += cos(t * 0.85) * 0.075;
            pos.z += sin(t * 1.2) * 0.075;

            // Курсор расталкивает частицы
            float d = distance(pos.xy, uMouse.xy);
            float push = smoothstep(2.1, 0.0, d);
            pos.xy += normalize(pos.xy - uMouse.xy + 0.0001) * push * 0.95;

            vec4 mv = modelViewMatrix * vec4(pos, 1.0);
            gl_Position = projectionMatrix * mv;
            gl_PointSize = uSize * (300.0 / -mv.z) * (0.55 + aSeed * 0.7);

            vGlow = push;
            vSeed = aSeed;
          }
        `,
        fragmentShader: `
          uniform vec3 uBrass, uMoss, uSteel;
          uniform float uMorph, uIntro;
          varying float vGlow;
          varying float vSeed;

          void main() {
            // Круглая точка с мягким краем
            float r = length(gl_PointCoord - 0.5);
            if (r > 0.5) discard;
            float alpha = smoothstep(0.5, 0.06, r);

            // Латунь — основа, мох проступает по мере сборки в систему,
            // сталь вспыхивает там, где прошёл курсор
            vec3 col = mix(uBrass, uMoss, smoothstep(0.6, 1.6, uMorph) * vSeed);
            col = mix(col, uSteel, vGlow * 0.85);

            gl_FragColor = vec4(col, alpha * (0.34 + vSeed * 0.46) * uIntro);
          }
        `,
      });

      const points = new THREE.Points(geo, material);
      scene.add(points);

      // --- Размер ---
      const resize = () => {
        const { clientWidth: w, clientHeight: h } = wrap;
        renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      };
      resize();
      addEventListener('resize', resize, { passive: true });

      // --- Курсор ---
      const mouse = { x: 99, y: 99, tx: 99, ty: 99 };
      if (!coarse) {
        addEventListener(
          'pointermove',
          (e) => {
            const r = wrap.getBoundingClientRect();
            mouse.tx = ((e.clientX - r.left) / r.width - 0.5) * (camera.aspect * 7.4);
            mouse.ty = -((e.clientY - r.top) / r.height - 0.5) * 7.4;
          },
          { passive: true },
        );
        addEventListener('pointerleave', () => {
          mouse.tx = 99;
          mouse.ty = 99;
        });
      }

      // --- Скролл управляет формой ---
      let morphTarget = 0;
      const onScroll = () => {
        const p = Math.min(1, Math.max(0, scrollY / (innerHeight * 0.9)));
        morphTarget = p * 2; // хаос → сфера → поток
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // --- Цикл ---
      let raf = 0;
      let running = true;
      let last = performance.now();

      const loop = (now: number = performance.now()) => {
        raf = requestAnimationFrame(loop);
        if (!running) {
          last = now;
          return;
        }

        // Ограничиваем шаг: после сворачивания вкладки он был бы огромным
        const dt = Math.min((now - last) / 1000, 0.05);
        last = now;
        uniforms.uTime.value += dt;
        uniforms.uIntro.value += (1 - uniforms.uIntro.value) * dt * 1.1;
        uniforms.uMorph.value += (morphTarget - uniforms.uMorph.value) * dt * 3.2;

        mouse.x += (mouse.tx - mouse.x) * dt * 7;
        mouse.y += (mouse.ty - mouse.y) * dt * 7;
        uniforms.uMouse.value.set(mouse.x, mouse.y, 0);

        points.rotation.y += dt * 0.055;
        points.rotation.x = Math.sin(uniforms.uTime.value * 0.14) * 0.13;

        renderer.render(scene, camera);
      };

      // Не жжём батарею, когда герой ушёл с экрана или вкладка неактивна
      new IntersectionObserver((es) => es.forEach((e) => (running = e.isIntersecting))).observe(wrap);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancelAnimationFrame(raf);
        else raf = requestAnimationFrame(loop);
      });

      canvas.style.opacity = '1';
      loop();
    };

    if (reduce) {
      // Движение отключено системно — показываем спокойный статичный градиент
      wrap.style.background = 'radial-gradient(circle at 62% 45%, rgba(200,155,60,0.17), transparent 62%)';
    } else {
      const io = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          io.disconnect();
          boot();
        }
      });
      io.observe(wrap);
    }
  }
</script>
