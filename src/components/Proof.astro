---
import type { Locale } from '../data/site';
import { tr, proofPoints } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="on-dark relative overflow-hidden border-b border-steel-300/15 bg-ink py-20 text-steel-100 md:py-28">
  <!-- Латунное свечение, реагирующее на положение курсора -->
  <div id="proof-glow" class="pointer-events-none absolute -inset-40 opacity-0 transition-opacity duration-700" aria-hidden="true"></div>

  <div class="shell relative">
    <div class="reveal grid gap-6 md:grid-cols-[auto_1fr] md:gap-14">
      <p class="plate !text-brass md:pt-3">{tr('proofPlate', locale)}</p>
      <div>
        <h2 class="text-big text-steel-50">{tr('proofTitle', locale)}</h2>
        <p class="mt-5 max-w-2xl text-[1.02rem] leading-relaxed text-steel-300">{tr('proofLead', locale)}</p>
      </div>
    </div>

    <div data-stagger class="mt-14 grid gap-px bg-steel-300/15 sm:grid-cols-2">
      {
        proofPoints.map((p) => (
          <article class="group relative bg-ink p-8 transition-colors duration-500 hover:bg-ink-800 md:p-10">
            <span class="font-mono text-[0.72rem] tracking-widest text-brass">{p.n}</span>
            <h3 class="mt-5 text-[1.25rem] text-steel-50 md:text-[1.4rem]">{p.title[locale]}</h3>
            <p class="mt-4 max-w-md text-[0.96rem] leading-relaxed text-steel-300">{p.text[locale]}</p>
            <span
              aria-hidden="true"
              class="absolute bottom-0 left-0 h-px w-0 bg-brass transition-[width] duration-500 ease-out group-hover:w-full"
            />
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Свечение следует за курсором — тонко, только на устройствах с мышью
  const glow = document.getElementById('proof-glow');
  if (glow && !matchMedia('(pointer: coarse)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const section = glow.closest('section')!;
    section.addEventListener(
      'pointermove',
      (e) => {
        const r = section.getBoundingClientRect();
        glow.style.background = `radial-gradient(420px circle at ${e.clientX - r.left + 160}px ${
          e.clientY - r.top + 160
        }px, rgba(200,155,60,0.13), transparent 68%)`;
        glow.style.opacity = '1';
      },
      { passive: true },
    );
    section.addEventListener('pointerleave', () => (glow.style.opacity = '0'));
  }
</script>
