---
import type { Locale } from '../data/site';
import { tr } from '../data/i18n';
import ParticleField from './ParticleField.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const ctaPrimary = locale === 'ru' ? '/#raschet' : '/en/#calculator';
const ctaSecond = locale === 'ru' ? '/#uslugi' : '/en/#services';

// Разбиваем заголовок на слова — каждое всплывает отдельно
const lines = [tr('heroLine1', locale), tr('heroLine2', locale), tr('heroLine3', locale)];

const marks = locale === 'ru'
  ? ['Фиксированная цена', 'Код ваш с первого дня', 'Первый разговор бесплатный']
  : ['Fixed price', 'Code yours from day one', 'First call free'];
---

<section id="hero-dark" class="on-dark relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-ink text-steel-100">
  <ParticleField />

  <!-- Затемнение под текстом, чтобы частицы не мешали читать -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-[1] bg-[linear-gradient(100deg,#121611_8%,rgba(18,22,17,0.86)_38%,rgba(18,22,17,0.15)_70%)]"
  >
  </div>

  <div class="shell relative z-[2] flex flex-1 flex-col justify-center pt-28 pb-16 md:pt-32">
    <p class="hero-fade plate !text-brass flex items-center gap-3" style="--d:0.1s">
      <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-brass"></span>
      {tr('heroPlate', locale)}
    </p>

    <h1 class="mt-7 max-w-4xl text-mega">
      {
        lines.map((line, li) => (
          <span class="block overflow-hidden">
            <span class="hero-rise block" style={`--d:${0.18 + li * 0.11}s`}>
              {li === 2 ? <span class="text-brass">{line}</span> : line}
            </span>
          </span>
        ))
      }
    </h1>

    <p class="hero-fade mt-8 max-w-xl text-[1.05rem] leading-relaxed text-steel-300 md:text-[1.12rem]" style="--d:0.55s">
      {tr('heroSub', locale)}
    </p>

    <div class="hero-fade mt-10 flex flex-wrap items-center gap-3" style="--d:0.68s">
      <a href={ctaPrimary} class="btn !border-brass !bg-brass !text-ink hover:!bg-brass-200">
        {tr('heroCta', locale)}
        <span aria-hidden="true">→</span>
      </a>
      <a href={ctaSecond} class="btn btn-ghost">{tr('heroCta2', locale)}</a>
    </div>

    <ul class="hero-fade mt-12 flex flex-wrap gap-x-8 gap-y-3" style="--d:0.82s">
      {
        marks.map((m) => (
          <li class="flex items-center gap-2.5 font-mono text-[0.72rem] tracking-wider text-steel-300 uppercase">
            <span class="h-1 w-1 bg-moss-200" aria-hidden="true" />
            {m}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Маркер прокрутки -->
  <div class="hero-fade shell relative z-[2] pb-8" style="--d:1s">
    <div class="flex items-center gap-4">
      <span class="scroll-line block h-8 w-px bg-steel-300/40"></span>
      <span class="font-mono text-[0.66rem] tracking-[0.2em] text-steel-300/70 uppercase">
        {locale === 'ru' ? 'Ниже — сколько это стоит' : 'Below — what it costs you'}
      </span>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-rise {
      transform: translateY(105%);
      animation: rise 1.05s var(--ease-station) forwards;
      animation-delay: var(--d);
    }
    @keyframes rise {
      to {
        transform: none;
      }
    }

    .hero-fade {
      opacity: 0;
      transform: translateY(14px);
      animation: fade-up 0.85s var(--ease-station) forwards;
      animation-delay: var(--d);
    }
    @keyframes fade-up {
      to {
        opacity: 1;
        transform: none;
      }
    }

    .scroll-line {
      transform-origin: top;
      animation: drop 2.1s var(--ease-station) infinite;
    }
    @keyframes drop {
      0% {
        transform: scaleY(0);
        opacity: 0;
      }
      35% {
        transform: scaleY(1);
        opacity: 1;
      }
      75% {
        transform: scaleY(1) translateY(100%);
        opacity: 0;
      }
      100% {
        transform: scaleY(0) translateY(100%);
        opacity: 0;
      }
    }
  }
</style>
