---
/**
 * Единый список каналов связи — используется в форме заявки и в футере, чтобы
 * контакты нигде не расходились. Почты отдаются обфусцированными (base64 в
 * data-mailb64, mailto собирается скриптом футера); телефон и WhatsApp —
 * открытыми ссылками tel:/wa.me, так клиенту удобнее.
 */
import { site, type Locale } from '../data/site';

interface Props {
  locale: Locale;
  variant?: 'aside' | 'footer';
}
const { locale, variant = 'aside' } = Astro.props;
const ru = locale === 'ru';

const b64 = (s: string) => Buffer.from(s, 'utf-8').toString('base64');

// Красиво читаемый телефон: +7 915 402-54-46.
function prettyPhone(p: string): string {
  const d = p.replace(/[^\d]/g, '');
  if (d.length === 11 && (d[0] === '7' || d[0] === '8')) {
    return `+7 ${d.slice(1, 4)} ${d.slice(4, 7)}-${d.slice(7, 9)}-${d.slice(9)}`;
  }
  if (d.length >= 11) return `+${d.slice(0, 3)} ${d.slice(3, 6)} ${d.slice(6, 9)} ${d.slice(9)}`;
  return p;
}

const ICONS: Record<string, string> = {
  telegram:
    'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212-.07-.062-.174-.041-.249-.024-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z',
  whatsapp:
    'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.887 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.359.101 11.945c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652a11.964 11.964 0 0 0 5.71 1.454h.005c6.585 0 11.946-5.359 11.949-11.945a11.868 11.868 0 0 0-3.480-8.408',
  phone:
    'M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z',
  mail:
    'M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z',
};

// Порядок каналов: мессенджеры (быстрый ответ) → звонок → почта.
const channels = [
  { key: 'telegram', icon: 'telegram', label: 'Telegram', value: '@' + site.telegramUrl.split('/').pop(), href: site.telegramUrl, ext: true },
  site.whatsapp && { key: 'whatsapp', icon: 'whatsapp', label: 'WhatsApp', value: prettyPhone(site.whatsapp), href: `https://wa.me/${site.whatsapp}`, ext: true },
  site.phone && { key: 'phone', icon: 'phone', label: site.phoneOwner ? (ru ? `${site.phoneOwner} · прямой` : `${site.phoneOwner} · direct`) : (ru ? 'Позвонить' : 'Call'), value: prettyPhone(site.phone), href: `tel:${site.phone.replace(/[^\d+]/g, '')}`, ext: false },
].filter(Boolean) as { key: string; icon: string; label: string; value: string; href: string; ext: boolean }[];

const mails = [site.email, site.email2].filter(Boolean) as string[];
---

{
  variant === 'footer' ? (
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5 text-[0.9rem]">
      {channels.map((c) => (
        <a
          href={c.href}
          {...(c.ext ? { target: '_blank', rel: 'noopener' } : {})}
          class="inline-flex items-center gap-2 text-steel-100 transition-colors hover:text-brass"
          aria-label={c.label}
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true"><path d={ICONS[c.icon]} /></svg>
          {c.label}
        </a>
      ))}
      {mails.map((m) => (
        <a
          data-mailb64={b64(m)}
          href="#"
          class="footer-mail inline-flex items-center gap-2 text-steel-100 transition-colors hover:text-brass"
          aria-label="Email"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true"><path d={ICONS.mail} /></svg>
          {ru ? 'Почта' : 'Email'}
        </a>
      ))}
    </div>
  ) : (
    <ul class="grid gap-2.5 sm:grid-cols-2">
      {channels.map((c) => (
        <li>
          <a
            href={c.href}
            {...(c.ext ? { target: '_blank', rel: 'noopener' } : {})}
            class="group flex items-center gap-3 rounded-xl border border-steel-300/20 bg-ink-800/50 px-4 py-3 transition-colors hover:border-cyan/50"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-cyan" fill="currentColor" aria-hidden="true"><path d={ICONS[c.icon]} /></svg>
            <span class="min-w-0">
              <span class="block font-mono text-[0.64rem] tracking-widest text-slate-1 uppercase">{c.label}</span>
              <span class="block truncate text-[0.9rem] text-steel-50">{c.value}</span>
            </span>
          </a>
        </li>
      ))}
      {mails.map((m) => (
        <li>
          <a
            data-mailb64={b64(m)}
            data-mail-show="1"
            href="#"
            class="footer-mail group flex items-center gap-3 rounded-xl border border-steel-300/20 bg-ink-800/50 px-4 py-3 transition-colors hover:border-cyan/50"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-cyan" fill="currentColor" aria-hidden="true"><path d={ICONS.mail} /></svg>
            <span class="min-w-0">
              <span class="block font-mono text-[0.64rem] tracking-widest text-slate-1 uppercase">{ru ? 'Почта' : 'Email'}</span>
              <span class="block truncate text-[0.9rem] text-steel-50">{ru ? 'нажмите, чтобы написать' : 'click to email'}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}
