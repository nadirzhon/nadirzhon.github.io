---
/**
 * Машинный зал: сквозной полёт камеры вместо страницы с секциями.
 *
 * AUTONOMA продаёт системы, которые работают без человека. Значит и сайт
 * должен быть такой системой: одна сцена, пять станций конвейера, по проводам
 * идут пакеты данных. Прокрутка ведёт камеру по маршруту, на станции панель
 * пристыковывается сбоку — и это обычный DOM, а не спрайт: текст остаётся
 * текстом, выделяется, читается скринридером и индексируется.
 *
 * Плоский режим — не деградация, а равноправный второй режим. Ниже 1024 px,
 * при prefers-reduced-motion и без WebGL те же панели показываются обычным
 * вертикальным списком. Разметка одна на оба случая.
 */
import type { Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ru = locale === 'ru';

/** Станции маршрута — это путь, который проходит рутина клиента. */
const stations = [
  {
    accent: '#25E8C8',
    tag: 'INGEST',
    title: { ru: 'Приём', en: 'Intake' },
    body: {
      ru: [
        'Сюда падает всё, что сегодня разбирает человек: заявки с сайта, письма, документы, выгрузки из чужих систем. Разный формат, разная задержка, разная степень вранья в данных.',
        'Первое, что делает система, — приводит это к одному виду и отмечает время по единым часам. Дальше уже никто не спорит, какая версия документа свежее.',
      ],
      en: [
        'Everything a person sorts by hand today lands here: web enquiries, email, documents, exports from other systems. Different formats, different delays, different amounts of lying in the data.',
        'The first thing the system does is bring it to one shape and stamp it with a single clock. After that nobody argues which version is newer.',
      ],
    },
    meta: { label: { ru: 'РАЗБИРАЛ ЧЕЛОВЕК', en: 'DONE BY HAND' }, value: { ru: 'каждый день', en: 'every day' } },
  },
  {
    accent: '#6E5BFF',
    tag: 'PROCESS',
    title: { ru: 'Разбор', en: 'Parsing' },
    body: {
      ru: [
        'Здесь процесс раскладывается на шаги, и находятся те, что человек повторяет одинаково каждый раз. Именно они уходят машине — остальное остаётся людям.',
        'Это самая недооценённая станция. Автоматизировать не разобравшись — значит ускорить беспорядок, а не убрать его.',
      ],
      en: [
        'Here the process is broken into steps, and the ones a person repeats identically every time are found. Those go to the machine — the rest stays with people.',
        'This is the most underrated station. Automating without understanding just speeds up the mess instead of removing it.',
      ],
    },
    meta: { label: { ru: 'НА ВЫХОДЕ', en: 'YOU GET' }, value: { ru: 'карта процесса', en: 'a process map' } },
  },
  {
    accent: '#FFB13D',
    tag: 'DECIDE',
    title: { ru: 'Решение', en: 'Decision' },
    body: {
      ru: [
        'Ядро контура. Модель предлагает, но решают правила, которые вы задали: что система делает сама, что только советует, а где обязана позвать человека.',
        'Граница проходит здесь, и она записана в договоре. Никакой «магии ИИ», за которую потом некому отвечать.',
      ],
      en: [
        'The core of the loop. The model proposes, but the rules you set decide: what the system does alone, what it only suggests, and where it must call a human.',
        'The boundary sits here, and it is written into the contract. No "AI magic" nobody can be held to afterwards.',
      ],
    },
    meta: { label: { ru: 'ГРАНИЦА', en: 'BOUNDARY' }, value: { ru: 'в договоре', en: 'in the contract' } },
  },
  {
    accent: '#25E8C8',
    tag: 'EXECUTE',
    title: { ru: 'Исполнение', en: 'Execution' },
    body: {
      ru: [
        'Система не советует, а делает: заводит заявку в CRM, отвечает клиенту, готовит документ, переносит данные, ставит задачу. Ровно то, на что человек тратил часы.',
        'Каждое действие обратимо и записано. Если что-то пошло не так, видно что именно и когда — а не «система почему-то сломалась».',
      ],
      en: [
        'The system does not advise, it acts: creates the record in your CRM, answers the client, prepares the document, moves the data, files the task. Exactly what used to eat hours.',
        'Every action is reversible and logged. If something goes wrong, you see what and when — not "the system broke somehow".',
      ],
    },
    meta: { label: { ru: 'РЕЖИМ', en: 'MODE' }, value: { ru: 'круглосуточно', en: '24/7' } },
  },
  {
    accent: '#6E5BFF',
    tag: 'OBSERVE',
    title: { ru: 'Наблюдение', en: 'Observability' },
    body: {
      ru: [
        'Панель, на которой видно: что обработано, что ушло на ручную проверку, где система ошиблась и сколько часов она вернула команде за месяц.',
        'Самое дорогое в автоматизации — не упущенная выгода, а незамеченный отказ. Поэтому эта станция стоит в контуре, а не в списке допов.',
      ],
      en: [
        'A panel that shows what was processed, what went to manual review, where the system was wrong, and how many hours it gave the team back this month.',
        'The expensive failure in automation is not missed upside — it is the failure nobody noticed. That is why this station is inside the loop, not in a list of extras.',
      ],
    },
    meta: { label: { ru: 'ОТКАЗ ВИДЕН', en: 'FAILURES VISIBLE' }, value: { ru: 'сразу', en: 'immediately' } },
  },
];

const routeLabels = stations.map((s) => s.title[locale].toUpperCase());
---

<section class="fl" id="hero-dark">
  <canvas id="fl-gl" aria-hidden="true"></canvas>
  <div id="fl-vignette" aria-hidden="true"></div>

  <div class="fl-doc">
    <header class="fl-bookend">
      <p class="fl-tag mono">AUTONOMA {ru ? '· МАШИННЫЙ ЗАЛ' : '· MACHINE ROOM'}</p>
      <h1>
        {ru ? 'Мы строим системы,' : 'We build systems'}<br />
        {ru ? 'которые ' : 'that '}<em>{ru ? 'работают сами' : 'run themselves'}</em>.
      </h1>
      <p class="fl-lede">
        {
          ru
            ? 'Ниже — маршрут через контур автономности: пять станций, по которым рутина проходит путь от входящего письма до проверенного действия. Прокрутите, чтобы пролететь конвейер.'
            : 'Below is a route through the autonomy loop: five stations where routine work travels from an incoming message to a verified action. Scroll to fly the conveyor.'
        }
      </p>
      <p class="fl-hint mono"><span></span>{ru ? 'ПРОКРУТКА = ДВИЖЕНИЕ КАМЕРЫ' : 'SCROLL = CAMERA MOVES'}</p>
    </header>

    <div id="fl-track">
      <div id="fl-panels">
        {
          stations.map((s, i) => (
            <article class="fl-panel" data-i={i} style={`--accent:${s.accent}`}>
              <p class="fl-idx mono">
                <b>{String(i + 1).padStart(2, '0')}</b>
                <i />
                {s.tag}
              </p>
              <h2>{s.title[locale]}</h2>
              {s.body[locale].map((t) => (
                <p>{t}</p>
              ))}
              <p class="fl-meta mono">
                <span>{s.meta.label[locale]}</span>
                <b>{s.meta.value[locale]}</b>
              </p>
            </article>
          ))
        }
      </div>
    </div>

    <footer class="fl-bookend">
      <p class="fl-tag mono">{ru ? 'КОНЕЦ МАРШРУТА' : 'END OF ROUTE'}</p>
      <h2 class="fl-end">{ru ? 'Контур ' : 'The loop is '}<em>{ru ? 'замкнут' : 'closed'}</em>.</h2>
      <p class="fl-lede">
        {
          ru
            ? 'Дальше — во что это обходится вашей команде сейчас, что я собираю и как считаю стоимость.'
            : 'Next — what this costs your team today, what I build, and how I price it.'
        }
      </p>
    </footer>
  </div>

  <nav id="fl-route" aria-hidden="true">
    <div class="rail">
      <div class="rail-fill"></div>
      <div class="nodes"></div>
    </div>
    <div class="route-labels mono">{routeLabels.map((l) => <span>{l}</span>)}</div>
  </nav>
</section>

<style>

/* ------------------------------------------------------------------
   Палитра вынесена в переменные: при интеграции в Astro/Tailwind 4
   эти же токены объявляются в @theme, а JS читает их из getComputedStyle
   (см. массив PALETTE в скрипте — он намеренно продублирован строками,
   потому что three.js нужен числовой hex, а не CSS-строка).
------------------------------------------------------------------- */
:root{
  --bg:#05070C;
  --teal:#25E8C8;
  --violet:#6E5BFF;
  --amber:#FFB13D;
  --ink:#E8EDF5;
  --ink-dim:#8A97AB;
  --panel-w:390px;
  --edge:clamp(20px, 4vw, 56px);
}

*{box-sizing:border-box}
html{scroll-behavior:auto}          /* плавность даёт lenis, не браузер */
body{
  margin:0;
  background:var(--bg);
  color:var(--ink);
  font:16px/1.6 -apple-system,BlinkMacSystemFont,"Inter","Segoe UI",Roboto,sans-serif;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
.mono{
  font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
  font-size:11px;
  letter-spacing:.18em;
  text-transform:uppercase;
}

/* Canvas всегда под контентом и никогда не ловит события:
   весь UX — на обычном DOM, 3D только «декорация со смыслом». */
#fl-gl{
  position:fixed; inset:0;
  width:100vw; height:100vh;
  display:block;
  z-index:0;
  pointer-events:none;
  /* opacity выставляем сразу, без transition — иначе headless-скриншот
     ловит кадр до окончания перехода и получается чёрный экран */
  opacity:1;
}

/* Виньетка поверх 3D: гасит края, чтобы текст панелей читался
   на любом кадре полёта без затемняющей подложки под самой панелью */
#fl-vignette{
  position:fixed; inset:0; z-index:1; pointer-events:none;
  background:
    radial-gradient(120% 90% at 50% 45%, transparent 35%, rgba(5,7,12,.55) 78%, rgba(5,7,12,.92) 100%);
}

main{position:relative; z-index:2}

/* ---------- Вступление и финал: обычные секции потока ---------- */
.fl-bookend{
  min-height:100vh;
  display:flex; flex-direction:column; justify-content:center;
  padding:0 var(--edge);
  max-width:820px;
}
.fl-bookend h1{
  font-size:clamp(38px,6.4vw,84px);
  line-height:1.02; letter-spacing:-.03em; font-weight:600;
  margin:.2em 0 .35em;
}
.fl-bookend h1 em{font-style:normal; color:var(--teal)}
.fl-bookend p{color:var(--ink-dim); font-size:clamp(15px,1.6vw,19px); max-width:56ch}
.fl-tag{color:var(--teal)}
.fl-hint{margin-top:2.2em; color:var(--ink-dim); display:flex; align-items:center; gap:.7em}
.fl-hint span{display:inline-block; width:1px; height:34px; background:linear-gradient(var(--teal),transparent)}

/* ---------- Трек прокрутки ----------
   Высоту задаёт JS (STATION_SCROLL_VH), чтобы длину полёта можно было
   крутить одним числом, не трогая CSS. */
#fl-track{position:relative}

/* ---------- Панели ----------
   В 3D-режиме #fl-panels — фиксированный слой, панели позиционируются
   транформом по спроецированным координатам станции.
   В плоском режиме тот же самый DOM превращается в обычный список. */
#fl-panels{position:fixed; inset:0; z-index:3; pointer-events:none}

.fl-panel{
  position:absolute; top:0; left:0;
  width:var(--panel-w);
  padding:26px 28px 28px;
  border:1px solid rgba(255,255,255,.09);
  border-left:2px solid var(--accent,var(--teal));
  background:linear-gradient(180deg, rgba(10,14,22,.86), rgba(7,10,17,.78));
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  border-radius:2px 10px 10px 2px;
  opacity:0;
  pointer-events:none;
  will-change:transform,opacity;
  /* transition только на opacity/blur — позиция управляется каждым кадром
     из рендер-цикла, ей transition противопоказан (будет «резина») */
  transition:opacity .28s ease, filter .28s ease;
  filter:blur(6px);
}
.fl-panel.is-live{opacity:1; filter:blur(0); pointer-events:auto}

.fl-panel .fl-idx{color:var(--accent); display:flex; gap:.9em; align-items:center}
.fl-panel .fl-idx b{font-weight:600}
.fl-panel .fl-idx i{flex:1; height:1px; background:currentColor; opacity:.35; font-style:normal}
.fl-panel h2{
  font-size:26px; line-height:1.15; letter-spacing:-.02em;
  font-weight:600; margin:.5em 0 .5em;
}
.fl-panel p{margin:0 0 .9em; font-size:14.5px; line-height:1.65; color:#B9C4D4}
.fl-panel p:last-child{margin-bottom:0}
.fl-panel .fl-meta{
  margin-top:16px; padding-top:14px;
  border-top:1px solid rgba(255,255,255,.08);
  color:var(--ink-dim);
  display:flex; justify-content:space-between; gap:1em;
}
.fl-panel .fl-meta b{color:var(--accent); font-weight:500}

/* ---------- Индикатор маршрута ---------- */
#fl-route{
  position:fixed; z-index:5;
  left:50%; transform:translateX(-50%);
  bottom:26px;
  width:min(640px, calc(100vw - 2*var(--edge)));
  pointer-events:none;
  opacity:0; transition:opacity .4s ease;
}
#route.is-on{opacity:1}
.rail{position:relative; height:1px; background:rgba(255,255,255,.14); margin:0 0 12px}
.rail-fill{
  position:absolute; left:0; top:0; height:1px; width:0;
  background:linear-gradient(90deg,var(--teal),var(--violet));
  box-shadow:0 0 10px rgba(37,232,200,.6);
}
.nodes{position:absolute; inset:0}
.node{
  position:absolute; top:50%;
  width:7px; height:7px; margin:-3.5px 0 0 -3.5px;
  border-radius:50%;
  background:#0B1018; border:1px solid rgba(255,255,255,.3);
  transition:transform .3s ease, background .3s ease, box-shadow .3s ease, border-color .3s ease;
}
.node.is-past{background:rgba(255,255,255,.3); border-color:transparent}
.node.is-now{
  transform:scale(1.9);
  background:var(--accent); border-color:transparent;
  box-shadow:0 0 12px 2px var(--accent);
}
.route-labels{display:flex; justify-content:space-between}
.route-labels span{
  color:var(--ink-dim); transition:color .3s ease;
  flex:1; text-align:center; font-size:9.5px; letter-spacing:.14em;
}
.route-labels span:first-child{text-align:left}
.route-labels span:last-child{text-align:right}
.route-labels span.is-now{color:var(--ink)}

/* ---------- ПЛОСКИЙ РЕЖИМ ----------
   Включается при prefers-reduced-motion, при ширине < 1024px и при
   отсутствии WebGL. Один и тот же DOM: панели просто возвращаются в поток. */
.fl-flat #fl-gl, .fl-flat #fl-vignette, .fl-flat #fl-route{display:none}
.fl-flat #fl-panels{position:static; pointer-events:auto}
.fl-flat #fl-track{height:auto !important; padding:0 var(--edge) 10vh}
.fl-flat .fl-panel{
  position:static;
  transform:none !important;
  opacity:1 !important;
  filter:none !important;
  pointer-events:auto;
  width:100%;
  max-width:720px;
  margin:0 auto 20px;
  backdrop-filter:none;
  background:rgba(10,14,22,.6);
}
.fl-flat .fl-bookend{min-height:auto; padding-top:14vh; padding-bottom:8vh}
.fl-flat .fl-hint{display:none}

@media (max-width:520px){
  .fl-panel{padding:20px 20px 22px}
  .fl-panel h2{font-size:22px}
}

</style>

<script>
const boot = async () => {
  const THREE = await import('three');



  /* ==================================================================
     НАСТРОЙКИ. Всё, что имеет смысл крутить при интеграции, собрано здесь.
     ================================================================== */
  const CFG = {
    // Позиции станций в мировых координатах. Маршрут уходит вглубь по -Z
    // и петляет по X/Y, чтобы полёт не читался как прямой тоннель.
    stations: [
      { pos: [  0,  0,    0], color: 0x25E8C8, shape: 'octa' },
      { pos: [ 15,  4,  -30], color: 0x6E5BFF, shape: 'box'  },
      { pos: [-11, -5,  -60], color: 0xFFB13D, shape: 'ico'  },
      { pos: [ 17,  7,  -92], color: 0x25E8C8, shape: 'tetra'},
      { pos: [ -7,  2, -124], color: 0x6E5BFF, shape: 'dodec'}
    ],
    // Смещение камеры относительно станции в точке «стоянки».
    // Знак X чередуется — камера обходит конвейер то слева, то справа.
    camOffsets: [
      [ 11,  3.5, 14],
      [-12,  4.5, 13],
      [ 12, -3.0, 14],
      [-13,  5.5, 13],
      [ 10,  3.5, 15]
    ],
    camEntry: [ 14,  7,  32],   // смещение точки входа относительно станции 0
    camExit : [  1,  8, -30],   // смещение точки выхода относительно станции 4

    scrollPerStationVh: 130,    // сколько vh прокрутки приходится на станцию
    scrollTailVh: 60,           // хвост после последней станции

    dwellHalf: 0.055,           // полуширина «стоянки» у станции в долях прогресса
    // Рампа должна быть заметно уже половины расстояния между станциями,
    // иначе в середине перелёта фокус обеих соседних станций остаётся высоким
    // и две панели дерутся за экран. При 5 станциях шаг ~0.184.
    focusRamp: 0.048,
    panelLiveAt: 0.35,          // порог фокуса, при котором панель показывается

    camDamp: 0.00008,           // демпфер прогресса: меньше = резче реакция на скролл
    camLerp: 0.0006,            // демпфер позиции/цели камеры

    packetCount: 300,           // плотность пакетов данных на проводе
    packetSpeed: 0.028,         // базовая скорость (доли длины провода в секунду)
    packetSpeedJitter: 0.65,    // разброс скоростей, чтобы поток не был «поездом»
    packetBoost: 3.2,           // во сколько раз ускоряются пакеты у активной станции
    // Размер держим маленьким: sizeAttenuation раздувает пакеты, пролетающие
    // вплотную к объективу, и при 0.85 они превращались в кляксы на пол-экрана
    packetSize: 0.55,

    wireSamples: 1400,          // разрешение полилинии провода (для быстрой выборки)
    fogDensity: 0.0125,         // FogExp2 — гасит дальние станции, даёт глубину
    starCount: 900,

    panelGap: 112,               // отступ панели от спроецированной станции, px
    breakpoint: 1024            // ниже — плоский режим без 3D
  };

  const PALETTE = { bg: 0x05070C };

  /* ==================================================================
     РЕЖИМ. Плоский список — это не «деградация», а равноправный режим:
     тот же DOM, просто без камеры. Проверяем сразу три условия.
     ================================================================== */
  const params = new URLSearchParams(location.search);
  const forcedProgress = params.has('p') ? Math.min(1, Math.max(0, parseFloat(params.get('p')))) : null;

  function webglOK(){
    try{
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    }catch(e){ return false; }
  }

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const flat = params.get('fl-flat') === '1' ||
               reduceMotion ||
               innerWidth < CFG.breakpoint ||
               !webglOK();

  const panelEls = [...document.querySelectorAll('.fl-panel')];
  const routeEl  = document.getElementById('fl-route');
  const flightEl = document.getElementById('fl-track');
  const canvas   = document.getElementById('fl-gl');

  if (flat) {
    document.body.classList.add('fl-flat');
    // В плоском режиме WebGL-контекст не создаётся вовсе — экономим и батарею,
    // и память; никаких скрытых работающих рендереров.
    canvas.remove();
  }

  /* ==================================================================
     Разметка индикатора маршрута — строится из CFG, а не из HTML,
     чтобы число станций правил один массив.
     ================================================================== */
  const nodesWrap = routeEl.querySelector('.nodes');
  const railFill  = routeEl.querySelector('.rail-fill');
  const nodeEls = CFG.stations.map((s, i) => {
    const el = document.createElement('div');
    el.className = 'node';
    el.style.left = (i / (CFG.stations.length - 1) * 100) + '%';
    el.style.setProperty('--accent', '#' + s.color.toString(16).padStart(6,'0'));
    nodesWrap.appendChild(el);
    return el;
  });
  const labelEls = [...routeEl.querySelectorAll('.route-labels span')];

  /* ==================================================================
     ОСНОВНОЙ КОД СЦЕНЫ
     ================================================================== */
  function boot(){

  const N = CFG.stations.length;

  flightEl.style.height = (N * CFG.scrollPerStationVh + CFG.scrollTailVh) + 'vh';
  routeEl.classList.add('is-on');

  const renderer = new THREE.WebGLRenderer({ canvas, antialias:true, powerPreference:'high-performance' });
  renderer.setClearColor(PALETTE.bg, 1);
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.setSize(innerWidth, innerHeight, false);

  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(PALETTE.bg, CFG.fogDensity);

  const camera = new THREE.PerspectiveCamera(52, innerWidth/innerHeight, 0.1, 500);

  /* ---------- Спрайт для пакетов: рисуем один раз в offscreen-canvas ----------
     Дешевле, чем тянуть PNG, и не зависит от сети. */
  const dotTex = (() => {
    const c = document.createElement('canvas'); c.width = c.height = 64;
    const g = c.getContext('2d');
    const grd = g.createRadialGradient(32,32,0, 32,32,32);
    grd.addColorStop(0.0, 'rgba(255,255,255,1)');
    grd.addColorStop(0.25,'rgba(255,255,255,.85)');
    grd.addColorStop(1.0, 'rgba(255,255,255,0)');
    g.fillStyle = grd; g.fillRect(0,0,64,64);
    const t = new THREE.CanvasTexture(c);
    t.colorSpace = THREE.SRGBColorSpace;
    return t;
  })();

  /* ---------- Кривая провода ----------
     Точки: вынос до первой станции, сами станции, вынос после последней.
     При 7 контрольных точках CatmullRomCurve3.getPoint(i/6) попадает
     ровно в i-ю точку — поэтому станция i всегда лежит на u=(i+1)/6.
     Это позволяет считать «где мы» без дорогой arc-length переразметки. */
  const stationPos = CFG.stations.map(s => new THREE.Vector3(...s.pos));

  const leadIn  = stationPos[0].clone().add(
    stationPos[0].clone().sub(stationPos[1]).normalize().multiplyScalar(26));
  const leadOut = stationPos[N-1].clone().add(
    stationPos[N-1].clone().sub(stationPos[N-2]).normalize().multiplyScalar(26));

  const wireCurve = new THREE.CatmullRomCurve3(
    [leadIn, ...stationPos, leadOut], false, 'catmullrom', 0.35);

  const stationU = CFG.stations.map((_, i) => (i + 1) / (N + 1));

  /* Полилиния провода в плоском Float32Array: выборка позиции пакета
     сводится к двум чтениям и lerp — никаких вызовов getPointAt в кадре. */
  const WS = CFG.wireSamples;
  const wirePts = new Float32Array(WS * 3);
  {
    const v = new THREE.Vector3();
    for (let i = 0; i < WS; i++){
      wireCurve.getPoint(i / (WS - 1), v);
      wirePts[i*3] = v.x; wirePts[i*3+1] = v.y; wirePts[i*3+2] = v.z;
    }
  }

  /* ---------- Сам провод + две направляющие «рельсы» ----------
     Рельсы смещены по нормали и делают конвейер объёмным, не добавляя
     ни одного треугольника. */
  function polyLine(offset, color, opacity){
    const pos = new Float32Array(WS * 3);
    const v = new THREE.Vector3(), tan = new THREE.Vector3();
    const up = new THREE.Vector3(0,1,0), side = new THREE.Vector3(), nrm = new THREE.Vector3();
    for (let i = 0; i < WS; i++){
      const u = i / (WS - 1);
      wireCurve.getPoint(u, v);
      wireCurve.getTangent(u, tan);
      side.crossVectors(tan, up).normalize();
      nrm.crossVectors(side, tan).normalize();
      v.addScaledVector(side, offset[0]).addScaledVector(nrm, offset[1]);
      pos[i*3] = v.x; pos[i*3+1] = v.y; pos[i*3+2] = v.z;
    }
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    return new THREE.Line(g, new THREE.LineBasicMaterial({
      color, transparent:true, opacity, depthWrite:false
    }));
  }
  scene.add(polyLine([0,0], 0x2A3B52, 0.85));
  scene.add(polyLine([ 3.1, -1.4], 0x1B2A3D, 0.55));
  scene.add(polyLine([-3.1, -1.4], 0x1B2A3D, 0.55));

  /* ---------- Станции ----------
     Каждая — каркас: рёбра многогранника + два кольца + облако точек.
     Материалы у каждой станции свои, потому что подсветка меняет
     именно opacity/color конкретной станции. */
  const SHAPES = {
    octa : () => new THREE.OctahedronGeometry(2.6),
    box  : () => new THREE.BoxGeometry(3.4, 3.4, 3.4),
    ico  : () => new THREE.IcosahedronGeometry(2.8),
    tetra: () => new THREE.TetrahedronGeometry(3.2),
    dodec: () => new THREE.DodecahedronGeometry(2.7)
  };

  function ringGeom(radius, seg){
    const pts = new Float32Array((seg + 1) * 3);
    for (let i = 0; i <= seg; i++){
      const a = i / seg * Math.PI * 2;
      pts[i*3] = Math.cos(a) * radius; pts[i*3+1] = 0; pts[i*3+2] = Math.sin(a) * radius;
    }
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.BufferAttribute(pts, 3));
    return g;
  }

  const stations = CFG.stations.map((def, i) => {
    const group = new THREE.Group();
    group.position.copy(stationPos[i]);
    scene.add(group);

    const col = new THREE.Color(def.color);

    const edges = new THREE.LineSegments(
      new THREE.EdgesGeometry(SHAPES[def.shape]()),
      new THREE.LineBasicMaterial({ color: col.clone(), transparent:true, opacity:.35, depthWrite:false })
    );
    group.add(edges);

    // Кольца в разных плоскостях: читаются как «работающий механизм»
    const rings = [];
    [[4.6, 0, 0], [6.1, Math.PI/2.4, Math.PI/5]].forEach(([r, rx, rz]) => {
      const l = new THREE.LineLoop(ringGeom(r, 96),
        new THREE.LineBasicMaterial({ color: col.clone(), transparent:true, opacity:.18, depthWrite:false }));
      l.rotation.set(rx, 0, rz);
      group.add(l); rings.push(l);
    });

    // Облако точек вокруг узла — «рабочее тело» станции
    const HN = 90;
    const hp = new Float32Array(HN * 3);
    for (let k = 0; k < HN; k++){
      const th = Math.acos(2*Math.random() - 1), ph = Math.random() * Math.PI * 2;
      const rr = 3.2 + Math.random() * 3.4;
      hp[k*3]   = rr * Math.sin(th) * Math.cos(ph);
      hp[k*3+1] = rr * Math.cos(th) * 0.7;
      hp[k*3+2] = rr * Math.sin(th) * Math.sin(ph);
    }
    const hg = new THREE.BufferGeometry();
    hg.setAttribute('position', new THREE.BufferAttribute(hp, 3));
    const halo = new THREE.Points(hg, new THREE.PointsMaterial({
      color: col.clone(), size:.55, map:dotTex, transparent:true, opacity:.35,
      depthWrite:false, blending:THREE.AdditiveBlending, sizeAttenuation:true
    }));
    group.add(halo);

    // Ядро — одна крупная точка, она и «разгорается» сильнее всего
    const cg = new THREE.BufferGeometry();
    cg.setAttribute('position', new THREE.BufferAttribute(new Float32Array([0,0,0]), 3));
    const core = new THREE.Points(cg, new THREE.PointsMaterial({
      color: col.clone(), size:5.5, map:dotTex, transparent:true, opacity:.5,
      depthWrite:false, blending:THREE.AdditiveBlending, sizeAttenuation:true
    }));
    group.add(core);

    return { group, edges, rings, halo, core, color: col, energy: 0 };
  });

  /* ---------- Пакеты данных ----------
     Один Points на весь конвейер. Позиции и цвета пишутся в готовые
     типизированные массивы — в кадре не создаётся ни одного объекта. */
  const PC = CFG.packetCount;
  const pkPos   = new Float32Array(PC * 3);
  const pkCol   = new Float32Array(PC * 3);
  const pkT     = new Float32Array(PC);
  const pkSpeed = new Float32Array(PC);
  const pkBase  = new Float32Array(PC * 3);   // «эталонный» цвет пакета

  for (let i = 0; i < PC; i++){
    pkT[i] = Math.random();
    pkSpeed[i] = CFG.packetSpeed * (1 - CFG.packetSpeedJitter/2 + Math.random() * CFG.packetSpeedJitter);
    // цвет пакета = цвет ближайшей по маршруту станции: поток «окрашивается»
    // по мере прохождения этапов
    let near = 0, best = 1e9;
    for (let s = 0; s < N; s++){
      const d = Math.abs(pkT[i] - stationU[s]);
      if (d < best){ best = d; near = s; }
    }
    const c = stations[near].color;
    pkBase[i*3] = c.r; pkBase[i*3+1] = c.g; pkBase[i*3+2] = c.b;
  }

  const pkGeom = new THREE.BufferGeometry();
  pkGeom.setAttribute('position', new THREE.BufferAttribute(pkPos, 3));
  pkGeom.setAttribute('color',    new THREE.BufferAttribute(pkCol, 3));
  const packets = new THREE.Points(pkGeom, new THREE.PointsMaterial({
    size: CFG.packetSize, map: dotTex, vertexColors:true, transparent:true,
    opacity:.95, depthWrite:false, blending:THREE.AdditiveBlending, sizeAttenuation:true
  }));
  scene.add(packets);

  /* ---------- Фоновая пыль ----------
     Даёт параллакс при движении камеры — без неё полёт «не чувствуется». */
  {
    const sp = new Float32Array(CFG.starCount * 3);
    for (let i = 0; i < CFG.starCount; i++){
      sp[i*3]   = (Math.random()-.5) * 220;
      sp[i*3+1] = (Math.random()-.5) * 120;
      sp[i*3+2] = -Math.random() * 190 + 30;
    }
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.BufferAttribute(sp, 3));
    scene.add(new THREE.Points(g, new THREE.PointsMaterial({
      color:0x3E5A78, size:.42, map:dotTex, transparent:true,
      opacity:.45, depthWrite:false, sizeAttenuation:true
    })));
  }

  /* ---------- Кривая камеры ----------
     Отдельная от провода: камера не «сидит на проводе», а обходит его.
     Контрольные точки: вход, стоянка у каждой станции, выход. */
  const camPts = [
    stationPos[0].clone().add(new THREE.Vector3(...CFG.camEntry)),
    ...stationPos.map((p, i) => p.clone().add(new THREE.Vector3(...CFG.camOffsets[i]))),
    stationPos[N-1].clone().add(new THREE.Vector3(...CFG.camExit))
  ];
  const camCurve = new THREE.CatmullRomCurve3(camPts, false, 'catmullrom', 0.4);
  const camAnchorU = CFG.stations.map((_, i) => (i + 1) / (camPts.length - 1));

  /* ---------- Варп прогресса ----------
     Ключевые точки (scrollProgress → u на кривой камеры). Плато у каждой
     станции = камера «притормаживает»: скролл идёт, u стоит.
     Это честнее, чем менять скорость по времени — движение остаётся
     строго привязанным к прокрутке и не «догоняет» пользователя. */
  const sCenter = CFG.stations.map((_, i) => (i + 0.5) / N * 0.92 + 0.04);
  const keys = [[0, 0]];
  for (let i = 0; i < N; i++){
    keys.push([sCenter[i] - CFG.dwellHalf, camAnchorU[i]]);
    keys.push([sCenter[i] + CFG.dwellHalf, camAnchorU[i]]);
  }
  keys.push([1, 1]);

  const smooth = t => t * t * (3 - 2 * t);

  function warp(p){
    if (p <= 0) return 0;
    if (p >= 1) return 1;
    for (let i = 0; i < keys.length - 1; i++){
      const [p0, u0] = keys[i], [p1, u1] = keys[i+1];
      if (p >= p0 && p <= p1){
        if (p1 - p0 < 1e-6) return u1;
        return u0 + (u1 - u0) * smooth((p - p0) / (p1 - p0));
      }
    }
    return 1;
  }

  /* ==================================================================
     Рендер-цикл. Все временные векторы созданы заранее.
     ================================================================== */
  const vPos = new THREE.Vector3();
  const vTan = new THREE.Vector3();
  const vAim = new THREE.Vector3();
  const vBlend = new THREE.Vector3();
  const vProj = new THREE.Vector3();

  const camPos = new THREE.Vector3().copy(camPts[0]);
  const camAim = new THREE.Vector3().copy(stationPos[0]);
  const focus  = new Float32Array(N);

  let progress = forcedProgress ?? 0;
  let targetProgress = progress;
  let panelH = 260;
  let panelW = 390;
  const liveState = new Array(N).fill(null);   // чтобы не трогать DOM без нужды
  let firstFrame = true;
  let frameCount = 0;
  let last = performance.now();

  function readScroll(){
    const r = flightEl.getBoundingClientRect();
    const span = r.height - innerHeight;
    if (span <= 0) return 0;
    return Math.min(1, Math.max(0, -r.top / span));
  }

  function measurePanels(){
    // Геометрию панелей меряем вне кадра анимации: offsetHeight и
    // getComputedStyle заставляют браузер пересчитать layout — в рендер-цикле
    // это стоило бы кадров на каждом тике.
    panelH = Math.max(...panelEls.map(el => el.offsetHeight || 260));
    panelW = parseFloat(getComputedStyle(document.documentElement)
               .getPropertyValue('--panel-w')) || 390;
  }

  function resize(){
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.setSize(innerWidth, innerHeight, false);
    camera.aspect = innerWidth / innerHeight;
    camera.updateProjectionMatrix();
    measurePanels();
  }
  addEventListener('resize', resize);

  // Панели надо померить видимыми, иначе offsetHeight = 0 при opacity:0 —
  // нет, opacity не влияет на layout, поэтому меряем сразу.
  measurePanels();

  function frame(now){
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;

    /* --- прогресс: демпфирование, независимое от частоты кадров --- */
    targetProgress = forcedProgress ?? readScroll();
    const kP = 1 - Math.pow(CFG.camDamp, dt);
    progress += (targetProgress - progress) * (firstFrame ? 1 : kP);

    /* --- фокус на станциях: 1 на стоянке, 0 в полёте --- */
    let focusSum = 0, activeIdx = 0, activeBest = -1;
    for (let i = 0; i < N; i++){
      const d = Math.abs(progress - sCenter[i]);
      const f = 1 - smooth(Math.min(1, Math.max(0,
        (d - CFG.dwellHalf) / CFG.focusRamp)));
      focus[i] = f;
      focusSum += f;
      if (f > activeBest){ activeBest = f; activeIdx = i; }
    }

    /* --- позиция и цель камеры --- */
    const u = warp(progress);
    camCurve.getPoint(u, vPos);
    camCurve.getTangent(u, vTan);

    // «Куда смотрим»: в полёте — вперёд по касательной, на стоянке —
    // на станцию. Между ними плавный переход по суммарному фокусу.
    vAim.copy(vPos).addScaledVector(vTan, 16);
    if (focusSum > 0.001){
      vBlend.set(0,0,0);
      for (let i = 0; i < N; i++)
        if (focus[i] > 0) vBlend.addScaledVector(stationPos[i], focus[i] / focusSum);
      vAim.lerp(vBlend, Math.min(1, focusSum));
    }

    // Лёгкое дыхание камеры: без него кадр на стоянке выглядит мёртвым.
    const t = now * 0.001;
    vPos.x += Math.sin(t * 0.31) * 0.45;
    vPos.y += Math.cos(t * 0.24) * 0.35;

    const kC = 1 - Math.pow(CFG.camLerp, dt);
    camPos.lerp(vPos, firstFrame ? 1 : kC);
    camAim.lerp(vAim, firstFrame ? 1 : kC);
    camera.position.copy(camPos);
    camera.lookAt(camAim);

    /* --- состояние станций --- */
    for (let i = 0; i < N; i++){
      const st = stations[i];
      const passed = progress > sCenter[i] + CFG.dwellHalf;
      // пройденная станция гаснет сильнее, чем ещё не достигнутая:
      // взгляд не должен возвращаться назад
      const base = passed ? 0.08 : 0.30;
      st.energy = base + focus[i] * (1 - base);

      st.edges.material.opacity = 0.12 + st.energy * 0.88;
      st.core.material.opacity  = 0.20 + st.energy * 0.80;
      st.core.material.size     = 4.0 + st.energy * 5.5;
      st.halo.material.opacity  = 0.10 + st.energy * 0.55;

      const spin = 0.12 + st.energy * 0.9;
      st.rings[0].rotation.y += dt * spin;
      st.rings[1].rotation.y -= dt * spin * 0.65;
      st.rings.forEach(r => { r.material.opacity = 0.06 + st.energy * 0.42; });

      const s = 1 + focus[i] * 0.14 + Math.sin(t * 1.7 + i) * 0.012 * st.energy;
      st.group.scale.setScalar(s);
      st.group.rotation.y += dt * 0.06 * (1 + st.energy);
    }

    /* --- пакеты --- */
    for (let i = 0; i < PC; i++){
      // ускорение у активной станции: пакет «оживает», когда камера рядом
      let boost = 1;
      for (let s = 0; s < N; s++){
        if (focus[s] < 0.02) continue;
        const d = Math.abs(pkT[i] - stationU[s]);
        if (d < 0.13) boost += (CFG.packetBoost - 1) * focus[s] * (1 - d / 0.13);
      }

      let tt = pkT[i] + pkSpeed[i] * boost * dt;
      if (tt >= 1) tt -= 1;
      pkT[i] = tt;

      // выборка из полилинии: floor + lerp, без вызовов кривой
      const f = tt * (WS - 1);
      const i0 = f | 0, i1 = i0 + 1 < WS ? i0 + 1 : i0;
      const w = f - i0;
      const a = i0 * 3, b = i1 * 3, o = i * 3;
      pkPos[o]   = wirePts[a]   + (wirePts[b]   - wirePts[a])   * w;
      pkPos[o+1] = wirePts[a+1] + (wirePts[b+1] - wirePts[a+1]) * w;
      pkPos[o+2] = wirePts[a+2] + (wirePts[b+2] - wirePts[a+2]) * w;

      const bright = Math.min(1, 0.45 + (boost - 1) * 0.45);
      pkCol[o]   = pkBase[o]   * bright;
      pkCol[o+1] = pkBase[o+1] * bright;
      pkCol[o+2] = pkBase[o+2] * bright;
    }
    pkGeom.attributes.position.needsUpdate = true;
    pkGeom.attributes.color.needsUpdate = true;

    /* --- DOM-панели: стыковка к спроецированной станции --- */
    const halfW = innerWidth / 2, halfH = innerHeight / 2;
    const PW = panelW;

    for (let i = 0; i < N; i++){
      const el = panelEls[i];
      const live = focus[i] > CFG.panelLiveAt;
      if (liveState[i] !== live){        // атрибуты пишем только на переходе
        liveState[i] = live;
        el.classList.toggle('is-live', live);
        el.setAttribute('aria-hidden', live ? 'false' : 'true');
      }
      if (focus[i] < 0.01) continue;   // невидимую панель не двигаем

      vProj.copy(stationPos[i]).project(camera);
      let x = (vProj.x * 0.5 + 0.5) * innerWidth;
      let y = (-vProj.y * 0.5 + 0.5) * innerHeight;

      // если станция за спиной — проекция инвертируется; прижимаем к краю
      if (vProj.z > 1){ x = halfW; y = halfH; }

      // панель встаёт с той стороны, где больше места
      x = x < halfW ? x + CFG.panelGap : x - CFG.panelGap - PW;

      const m = 24;
      x = Math.min(innerWidth - PW - m, Math.max(m, x));
      y = Math.min(innerHeight - panelH - 90, Math.max(m + 40, y - panelH * 0.42));

      el.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
    }

    /* --- индикатор маршрута --- */
    railFill.style.width = (progress * 100).toFixed(2) + '%';
    for (let i = 0; i < N; i++){
      const now_ = focus[i] > CFG.panelLiveAt;
      nodeEls[i].classList.toggle('is-now', now_);
      nodeEls[i].classList.toggle('is-past', !now_ && progress > sCenter[i]);
      labelEls[i].classList.toggle('is-now', now_);
    }

    renderer.render(scene, camera);
    firstFrame = false;
    frameCount++;
    requestAnimationFrame(frame);
  }

  resize();
  requestAnimationFrame(frame);

  // Диагностика для headless-проверки: со стороны страницы видно,
  // что цикл реально крутится и сколько объектов в сцене.
  window.__proto = { get progress(){ return progress; },
                     get target(){ return targetProgress; },
                     get raw(){ return readScroll(); },
                     get frames(){ return frameCount; },
                     objects: scene.children.length,
                     ok: true };
  }

  // Запуск в самом конце модуля: boot() читает const-переменные индикатора,
  // объявленные выше по файлу, — вызов раньше упёрся бы в temporal dead zone.
  if (!flat) boot();
};

const start = () => { boot().catch(() => document.documentElement.classList.add('fl-flat')); };
if (document.readyState === 'loading') addEventListener('DOMContentLoaded', start, { once: true });
else start();
</script>
