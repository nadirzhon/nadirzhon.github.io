---
import { url, type Locale } from '../data/site';
import { tr, packages } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const cta = url(locale === 'ru' ? '/#kontakt' : '/en/#contact');
---

<section id={locale === 'ru' ? 'ceny' : 'pricing'} class="scroll-mt-20 border-b border-slate-1/20 py-20 md:py-28">
  <div class="shell">
    <div class="reveal grid gap-6 md:grid-cols-[auto_1fr] md:gap-14">
      <p class="plate md:pt-3">{tr('pricePlate', locale)}</p>
      <div>
        <h2 class="text-big">{tr('priceTitle', locale)}</h2>
        <p class="mt-5 max-w-2xl text-[1.02rem] leading-relaxed text-steel-300">{tr('priceLead', locale)}</p>
      </div>
    </div>

    <div class="mt-14 grid gap-3 md:gap-4 lg:grid-cols-3">
      {
        packages.map((p) => (
          <div
            class:list={[
              'reveal flex flex-col rounded-2xl p-7 md:p-9',
              p.accent ? 'panel panel-lit on-dark' : 'panel rounded-2xl',
            ]}
          >
            <div class="flex items-center justify-between">
              <span class:list={['plate', p.accent && '!text-cyan']}>{p.code}</span>
              {p.accent && (
                <span class="rounded-full bg-gradient-to-r from-cyan to-violet px-3 py-1 font-mono text-[0.62rem] tracking-widest text-void uppercase">
                  {locale === 'ru' ? 'чаще всего' : 'most chosen'}
                </span>
              )}
            </div>

            <h3 class:list={['mt-5 text-[1.5rem]', p.accent && 'text-steel-50']}>{p.name[locale]}</h3>

            <p class:list={['mt-5 text-[0.92rem] leading-relaxed', p.accent ? 'text-steel-200' : 'text-steel-300']}>
              {p.for[locale]}
            </p>

            <ul class:list={['mt-7 flex-1 space-y-3 border-t pt-6', p.accent ? 'border-steel-300/25' : 'border-slate-1/25']}>
              {p.items[locale].map((i) => (
                <li class="flex gap-3 text-[0.9rem] leading-snug">
                  <span class:list={['mt-2 h-1 w-1 shrink-0', p.accent ? 'bg-cyan' : 'bg-slate-1']} aria-hidden="true" />
                  <span class={p.accent ? 'text-steel-200' : 'text-steel-300'}>{i}</span>
                </li>
              ))}
            </ul>

            <a
              href={cta}
              class:list={['btn mag mt-8 justify-center', p.accent ? 'btn-primary' : 'btn-ghost']}
            >
              {tr('priceCta', locale)}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
