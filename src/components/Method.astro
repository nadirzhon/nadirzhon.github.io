---
import type { Locale } from '../data/site';
import { tr, method } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section id={locale === 'ru' ? 'metod' : 'method'} class="scroll-mt-20 border-b border-slate-1/20 py-20 md:py-28">
  <div class="shell">
    <div class="reveal grid gap-6 md:grid-cols-[auto_1fr] md:gap-14">
      <p class="plate md:pt-3">{tr('methodPlate', locale)}</p>
      <div>
        <h2 class="text-big">{tr('methodTitle', locale)}</h2>
        <p class="mt-5 max-w-2xl text-[1.02rem] leading-relaxed text-steel-300">{tr('methodLead', locale)}</p>
      </div>
    </div>

    <ol data-stagger class="mt-14 grid gap-3 md:gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        method.map((m) => (
          <li class="group relative panel rounded-2xl p-7 md:p-8">
            <span class="grad-text font-mono text-[2.6rem] leading-none font-bold transition-opacity group-hover:opacity-80">
              {m.n}
            </span>
            <h3 class="mt-4 text-[1.15rem] leading-tight">{m.title[locale]}</h3>
            <p class="mt-1.5 font-mono text-[0.7rem] tracking-wider text-cyan uppercase">{m.dur[locale]}</p>
            <p class="mt-4 text-[0.92rem] leading-relaxed text-steel-300">{m.text[locale]}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
