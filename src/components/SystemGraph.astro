---
/**
 * Живая схема системы в герое.
 *
 * Это не абстрактное украшение, а буквальная иллюстрация того, что студия
 * продаёт: узлы соединяются в конвейер, и по нему сами собой идут данные.
 * Сюжет за десять секунд: рассыпанные точки (рутина без порядка) →
 * собранная схема (система) → бегущие импульсы (она работает без вас).
 *
 * Слои схемы читаются слева направо, как на инженерном чертеже:
 * приём → обработка → решение → выдача.
 */
---

<div id="sg-wrap" class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
  <canvas id="sg-canvas" class="h-full w-full opacity-0 transition-opacity duration-[1200ms]"></canvas>
</div>

<script>
  const canvas = document.getElementById('sg-canvas') as HTMLCanvasElement | null;
  const wrap = document.getElementById('sg-wrap');

  if (canvas && wrap) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = matchMedia('(pointer: coarse)').matches;

    const boot = async () => {
      const THREE = await import('three');

      /* ─── Топология: четыре слоя конвейера ─────────────────────────────── */
      const LAYERS = [8, 14, 14, 9];      // сколько узлов в каждом слое
      const SPAN_X = 4.6;                 // ширина схемы
      const nodes: { x: number; y: number; z: number; layer: number }[] = [];
      const layerStart: number[] = [];

      LAYERS.forEach((count, li) => {
        layerStart.push(nodes.length);
        const x = -SPAN_X / 2 + (li / (LAYERS.length - 1)) * SPAN_X;
        for (let i = 0; i < count; i++) {
          // Узлы слоя расходятся по вертикали, слегка гуляя по глубине —
          // чтобы схема читалась объёмной, а не плоским чертежом.
          const spread = count > 1 ? (i / (count - 1) - 0.5) : 0;
          nodes.push({
            x,
            y: spread * (2.5 + li * 0.2),
            z: Math.sin(i * 2.399 + li) * 0.85,
            layer: li,
          });
        }
      });

      /* ─── Связи: каждый узел тянется к 1–3 узлам следующего слоя ───────── */
      const edges: [number, number][] = [];
      for (let li = 0; li < LAYERS.length - 1; li++) {
        const from = layerStart[li];
        const to = layerStart[li + 1];
        for (let i = 0; i < LAYERS[li]; i++) {
          const fanout = 1 + ((i * 7 + li * 3) % 3);
          for (let k = 0; k < fanout; k++) {
            const j = (i + k * 2 + li) % LAYERS[li + 1];
            edges.push([from + i, to + j]);
          }
        }
      }

      const N = nodes.length;
      const E = edges.length;

      /* ─── Узлы ─────────────────────────────────────────────────────────── */
      const target = new Float32Array(N * 3);
      const scatter = new Float32Array(N * 3);
      const seed = new Float32Array(N);
      const rank = new Float32Array(N); // 0..1 — положение в конвейере

      nodes.forEach((n, i) => {
        const i3 = i * 3;
        target[i3] = n.x;
        target[i3 + 1] = n.y;
        target[i3 + 2] = n.z;
        // Стартовый хаос — та самая рутина до системы
        scatter[i3] = (Math.random() - 0.5) * 15;
        scatter[i3 + 1] = (Math.random() - 0.5) * 9;
        scatter[i3 + 2] = (Math.random() - 0.5) * 9;
        seed[i] = Math.random();
        rank[i] = n.layer / (LAYERS.length - 1);
      });

      const nodeGeo = new THREE.BufferGeometry();
      nodeGeo.setAttribute('position', new THREE.BufferAttribute(scatter.slice(), 3));
      nodeGeo.setAttribute('aTarget', new THREE.BufferAttribute(target, 3));
      nodeGeo.setAttribute('aScatter', new THREE.BufferAttribute(scatter, 3));
      nodeGeo.setAttribute('aSeed', new THREE.BufferAttribute(seed, 1));
      nodeGeo.setAttribute('aRank', new THREE.BufferAttribute(rank, 1));

      const uniforms = {
        uTime: { value: 0 },
        uAssemble: { value: 0 },        // 0 — хаос, 1 — собранная схема
        uMouse: { value: new THREE.Vector3(99, 99, 0) },
        uDpr: { value: Math.min(devicePixelRatio, 2) },
        uBrass: { value: new THREE.Color(0xc89b3c) },
        uMoss: { value: new THREE.Color(0x7fb094) },
        uSteel: { value: new THREE.Color(0xf2f4ef) },
      };

      const nodeMat = new THREE.ShaderMaterial({
        uniforms,
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        vertexShader: `
          uniform float uTime, uAssemble, uDpr;
          uniform vec3 uMouse;
          attribute vec3 aTarget, aScatter;
          attribute float aSeed, aRank;
          varying float vGlow, vSeed, vRank;

          void main() {
            // Слои собираются по очереди, слева направо
            float stagger = clamp((uAssemble - aRank * 0.28) / 0.72, 0.0, 1.0);
            float e = 1.0 - pow(1.0 - stagger, 3.0);
            vec3 pos = mix(aScatter, aTarget, e);

            // Собранная схема продолжает дышать — она живая, а не картинка
            float t = uTime * 0.5 + aSeed * 6.283;
            pos += vec3(sin(t), cos(t * 0.9), sin(t * 1.3)) * 0.055 * e;

            // Курсор подсвечивает узел, к которому подошёл
            float d = distance(pos.xy, uMouse.xy);
            float near = smoothstep(1.9, 0.0, d);
            pos.xy += normalize(pos.xy - uMouse.xy + 0.0001) * near * 0.28;

            vec4 mv = modelViewMatrix * vec4(pos, 1.0);
            gl_Position = projectionMatrix * mv;

            // Узлы решающего слоя крупнее — иерархия читается сразу
            float base = 3.8 + aRank * 2.6 + aSeed * 1.9;
            gl_PointSize = base * uDpr * (44.0 / -mv.z) * (0.8 + near * 0.7);

            vGlow = near;
            vSeed = aSeed;
            vRank = aRank;
          }
        `,
        fragmentShader: `
          uniform vec3 uBrass, uMoss, uSteel;
          varying float vGlow, vSeed, vRank;

          void main() {
            float r = length(gl_PointCoord - 0.5);
            if (r > 0.5) discard;
            float core = smoothstep(0.46, 0.3, r);
            float halo = smoothstep(0.5, 0.0, r) * 0.22;

            // Мох на входе (штатный режим) → латунь на выходе (результат)
            vec3 col = mix(uMoss, uBrass, vRank);
            col = mix(col, uSteel, vGlow * 0.9);

            gl_FragColor = vec4(col, (core * 1.0 + halo) * (0.72 + vSeed * 0.28));
          }
        `,
      });

      const nodePoints = new THREE.Points(nodeGeo, nodeMat);

      /* ─── Связи ────────────────────────────────────────────────────────── */
      const edgePos = new Float32Array(E * 6);
      const edgeRank = new Float32Array(E * 2);
      const edgeSeed = new Float32Array(E * 2);

      edges.forEach(([a, b], i) => {
        edgeRank[i * 2] = rank[a];
        edgeRank[i * 2 + 1] = rank[b];
        const s = Math.random();
        edgeSeed[i * 2] = s;
        edgeSeed[i * 2 + 1] = s;
      });

      const edgeGeo = new THREE.BufferGeometry();
      edgeGeo.setAttribute('position', new THREE.BufferAttribute(edgePos, 3));
      edgeGeo.setAttribute('aRank', new THREE.BufferAttribute(edgeRank, 1));
      edgeGeo.setAttribute('aSeed', new THREE.BufferAttribute(edgeSeed, 1));

      const edgeMat = new THREE.ShaderMaterial({
        uniforms,
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        vertexShader: `
          uniform float uAssemble;
          attribute float aRank, aSeed;
          varying float vRank, vSeed;
          void main() {
            vRank = aRank; vSeed = aSeed;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          uniform vec3 uBrass, uMoss;
          uniform float uAssemble, uTime;
          varying float vRank, vSeed;
          void main() {
            // Провода проявляются только после того, как узлы встали на места
            float on = smoothstep(0.55, 1.0, uAssemble);
            vec3 col = mix(uMoss, uBrass, vRank);
            float flicker = 0.72 + 0.28 * sin(uTime * 1.6 + vSeed * 12.0);
            gl_FragColor = vec4(col, on * 0.72 * flicker);
          }
        `,
      });

      const edgeLines = new THREE.LineSegments(edgeGeo, edgeMat);

      /* ─── Импульсы: данные, которые идут по схеме сами ─────────────────── */
      const PULSES = coarse ? 40 : 90;
      const pulseEdge = new Int32Array(PULSES);
      const pulseT = new Float32Array(PULSES);
      const pulseSpeed = new Float32Array(PULSES);
      const pulsePos = new Float32Array(PULSES * 3);
      const pulseSeed = new Float32Array(PULSES);

      for (let i = 0; i < PULSES; i++) {
        pulseEdge[i] = (Math.random() * E) | 0;
        pulseT[i] = Math.random();
        pulseSpeed[i] = 0.22 + Math.random() * 0.42;
        pulseSeed[i] = Math.random();
      }

      const pulseGeo = new THREE.BufferGeometry();
      pulseGeo.setAttribute('position', new THREE.BufferAttribute(pulsePos, 3));
      pulseGeo.setAttribute('aSeed', new THREE.BufferAttribute(pulseSeed, 1));

      const pulseMat = new THREE.ShaderMaterial({
        uniforms,
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        vertexShader: `
          uniform float uDpr, uAssemble;
          attribute float aSeed;
          varying float vSeed;
          void main() {
            vSeed = aSeed;
            vec4 mv = modelViewMatrix * vec4(position, 1.0);
            gl_Position = projectionMatrix * mv;
            gl_PointSize = (2.4 + aSeed * 1.8) * uDpr * (44.0 / -mv.z) * smoothstep(0.7, 1.0, uAssemble);
          }
        `,
        fragmentShader: `
          uniform vec3 uSteel, uBrass;
          varying float vSeed;
          void main() {
            float r = length(gl_PointCoord - 0.5);
            if (r > 0.5) discard;
            float a = smoothstep(0.5, 0.05, r);
            gl_FragColor = vec4(mix(uBrass, uSteel, vSeed), a * 0.95);
          }
        `,
      });

      const pulsePoints = new THREE.Points(pulseGeo, pulseMat);

      /* ─── Сцена ────────────────────────────────────────────────────────── */
      const scene = new THREE.Scene();
      const group = new THREE.Group();
      group.add(edgeLines, nodePoints, pulsePoints);
      scene.add(group);

      const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
      camera.position.z = 8.2;

      const renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: false,
        powerPreference: 'high-performance',
      });
      renderer.setClearColor(0x000000, 0);

      const resize = () => {
        const w = wrap.clientWidth || 1;
        const h = wrap.clientHeight || 1;
        renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        // На узком экране отводим камеру, чтобы схема влезала целиком
        camera.position.z = w / h < 1 ? 12.0 : 8.2;
        camera.updateProjectionMatrix();
        // На широком экране уводим схему вправо: слева живёт заголовок,
        // и перекрывать его затемнением ради фона — плохой обмен.
        const halfH = Math.tan((camera.fov * Math.PI) / 360) * camera.position.z;
        group.position.x = w / h > 1.15 ? halfH * camera.aspect * 0.34 : 0;
        uniforms.uDpr.value = Math.min(devicePixelRatio, 2);
      };
      resize();
      addEventListener('resize', resize, { passive: true });

      /* ─── Курсор ───────────────────────────────────────────────────────── */
      const mouse = { x: 99, y: 99, tx: 99, ty: 99 };
      if (!coarse) {
        addEventListener(
          'pointermove',
          (e) => {
            const r = wrap.getBoundingClientRect();
            if (e.clientY > r.bottom) {
              mouse.tx = 99;
              mouse.ty = 99;
              return;
            }
            // Экранные координаты → мировые на плоскости схемы
            const nx = ((e.clientX - r.left) / r.width) * 2 - 1;
            const ny = -(((e.clientY - r.top) / r.height) * 2 - 1);
            const halfH = Math.tan((camera.fov * Math.PI) / 360) * camera.position.z;
            mouse.tx = nx * halfH * camera.aspect;
            mouse.ty = ny * halfH;
          },
          { passive: true }
        );
      }

      /* ─── Цикл ─────────────────────────────────────────────────────────── */
      const clock = new THREE.Clock();
      let assemble = 0;
      let visible = true;
      let scrollShift = 0;

      new IntersectionObserver(
        ([e]) => {
          visible = e.isIntersecting;
        },
        { threshold: 0 }
      ).observe(wrap);

      const tmpA = new THREE.Vector3();
      const tmpB = new THREE.Vector3();
      const nodePosAttr = nodeGeo.getAttribute('position') as any;

      const tick = () => {
        requestAnimationFrame(tick);
        if (!visible) return;

        const dt = Math.min(clock.getDelta(), 0.05);
        const t = clock.getElapsedTime();

        // Сборка схемы — один раз, за первые 2.4 секунды по часам,
        // а не по накоплению кадров: иначе на слабом железе она не доедет.
        assemble = Math.min(1, t / 2.4);
        uniforms.uAssemble.value = assemble;
        uniforms.uTime.value = t;

        mouse.x += (mouse.tx - mouse.x) * 0.09;
        mouse.y += (mouse.ty - mouse.y) * 0.09;
        uniforms.uMouse.value.set(mouse.x, mouse.y, 0);

        // Схема слегка поворачивается вслед за курсором и уходит по скроллу
        scrollShift = Math.min(1, scrollY / Math.max(1, innerHeight));
        const px = coarse ? 0 : mouse.x * 0.012;
        const py = coarse ? 0 : mouse.y * 0.012;
        group.rotation.y += ((t * 0.045 + px) - group.rotation.y) * 0.04;
        group.rotation.x += (-py * 0.6 - group.rotation.x) * 0.04;
        group.position.y = scrollShift * 1.4;
        group.position.z = -scrollShift * 3.2;

        // Позиции узлов считаем на CPU: их мало, зато провода и импульсы
        // могут цепляться ровно за те же точки, что видит глаз.
        const pos = nodePosAttr.array as Float32Array;
        for (let i = 0; i < N; i++) {
          const i3 = i * 3;
          const stagger = Math.min(1, Math.max(0, (assemble - rank[i] * 0.28) / 0.72));
          const e = 1 - Math.pow(1 - stagger, 3);
          const bt = t * 0.5 + seed[i] * 6.283;
          pos[i3] = scatter[i3] + (target[i3] - scatter[i3]) * e + Math.sin(bt) * 0.055 * e;
          pos[i3 + 1] = scatter[i3 + 1] + (target[i3 + 1] - scatter[i3 + 1]) * e + Math.cos(bt * 0.9) * 0.055 * e;
          pos[i3 + 2] = scatter[i3 + 2] + (target[i3 + 2] - scatter[i3 + 2]) * e + Math.sin(bt * 1.3) * 0.055 * e;
        }
        nodePosAttr.needsUpdate = true;

        // Провода тянем по актуальным позициям узлов
        for (let i = 0; i < E; i++) {
          const [a, b] = edges[i];
          const o = i * 6;
          edgePos[o] = pos[a * 3];
          edgePos[o + 1] = pos[a * 3 + 1];
          edgePos[o + 2] = pos[a * 3 + 2];
          edgePos[o + 3] = pos[b * 3];
          edgePos[o + 4] = pos[b * 3 + 1];
          edgePos[o + 5] = pos[b * 3 + 2];
        }
        edgeGeo.getAttribute('position').needsUpdate = true;

        // Импульсы бегут по проводам; добежав — перескакивают на следующий
        for (let i = 0; i < PULSES; i++) {
          pulseT[i] += pulseSpeed[i] * dt;
          if (pulseT[i] > 1) {
            pulseT[i] -= 1;
            pulseEdge[i] = (Math.random() * E) | 0;
          }
          const [a, b] = edges[pulseEdge[i]];
          tmpA.set(pos[a * 3], pos[a * 3 + 1], pos[a * 3 + 2]);
          tmpB.set(pos[b * 3], pos[b * 3 + 1], pos[b * 3 + 2]);
          tmpA.lerp(tmpB, pulseT[i]);
          pulsePos[i * 3] = tmpA.x;
          pulsePos[i * 3 + 1] = tmpA.y;
          pulsePos[i * 3 + 2] = tmpA.z;
        }
        pulseGeo.getAttribute('position').needsUpdate = true;

        renderer.render(scene, camera);
      };

      canvas.style.opacity = '1';

      if (reduce) {
        // Без движения: показываем собранную схему одним кадром
        assemble = 1;
        uniforms.uAssemble.value = 1;
        for (let i = 0; i < N; i++) {
          const i3 = i * 3;
          (nodePosAttr.array as Float32Array)[i3] = target[i3];
          (nodePosAttr.array as Float32Array)[i3 + 1] = target[i3 + 1];
          (nodePosAttr.array as Float32Array)[i3 + 2] = target[i3 + 2];
        }
        nodePosAttr.needsUpdate = true;
        for (let i = 0; i < E; i++) {
          const [a, b] = edges[i];
          const o = i * 6;
          edgePos[o] = target[a * 3];
          edgePos[o + 1] = target[a * 3 + 1];
          edgePos[o + 2] = target[a * 3 + 2];
          edgePos[o + 3] = target[b * 3];
          edgePos[o + 4] = target[b * 3 + 1];
          edgePos[o + 5] = target[b * 3 + 2];
        }
        edgeGeo.getAttribute('position').needsUpdate = true;
        renderer.render(scene, camera);
      } else {
        tick();
      }
    };

    // Модуль тяжёлый — поднимаем только когда герой действительно на экране
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          boot().catch(() => {
            // WebGL недоступен — герой остаётся с обычным фоном, ничего не ломается
          });
        }
      },
      { rootMargin: '200px' }
    );
    io.observe(wrap);
  }
</script>
