---
/**
 * Галерея экранов рабочей системы.
 *
 * Это не иллюстрации к тексту, а доказательство: слова про «одиннадцать
 * сервисов и риск-контур» проверяются глазами за секунду. Поэтому снимки
 * стоят крупно, открываются на весь экран и подписаны тем, что на них видно.
 */
interface Shot {
  src: string;
  title: string;
  note: string;
  type?: 'image' | 'video';
  poster?: string;
}
interface Props {
  shots: Shot[];
  plate?: string;
  lead?: string;
}
const { shots, plate = 'Экраны', lead } = Astro.props;
---

<section class="shots border-t border-slate-1/25 py-14 md:py-20">
  <div class="shell">
    <div class="grid gap-6 md:grid-cols-[auto_1fr] md:gap-14">
      <p class="plate md:pt-3">{plate}</p>
      {lead && <p class="max-w-2xl text-[1rem] leading-relaxed text-steel-300">{lead}</p>}
    </div>

    <ul class="mt-10 grid gap-4 md:mt-14 md:grid-cols-2">
      {
        shots.map((s, i) => (
          <li class:list={['reveal', i === 0 && 'md:col-span-2']}>
            <button
              type="button"
              class="shot panel group block w-full overflow-hidden rounded-2xl text-left"
              data-full={s.src}
              data-title={s.title}
              data-type={s.type ?? 'image'}
            >
              <span class="relative block overflow-hidden">
                {s.type === 'video' ? (
                  <video
                    src={s.src}
                    poster={s.poster}
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    class="block w-full transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  />
                ) : (
                  <img
                    src={s.src}
                    alt={s.title}
                    loading="lazy"
                    decoding="async"
                    class="block w-full transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  />
                )}
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_top,rgba(5,7,12,0.85),transparent_46%)]"
                />
                {s.type === 'video' && (
                  <span class="pointer-events-none absolute inset-0 grid place-items-center">
                    <span class="grid h-14 w-14 place-items-center rounded-full border border-steel-50/40 bg-void/60 text-steel-50 backdrop-blur-sm transition-transform duration-300 group-hover:scale-110">
                      <span aria-hidden="true" class="ml-0.5 text-[1.1rem]">▶</span>
                    </span>
                  </span>
                )}
                <span class="absolute right-4 bottom-4 rounded-full border border-steel-300/25 bg-void/70 px-3 py-1.5 font-mono text-[0.62rem] tracking-widest text-steel-200 uppercase backdrop-blur-sm">
                  {s.type === 'video' ? 'смотреть' : 'открыть'}
                </span>
              </span>
              <span class="block px-5 py-4">
                <span class="block font-display text-[1.02rem] leading-tight font-bold">{s.title}</span>
                <span class="mt-1.5 block text-[0.88rem] leading-snug text-steel-300">{s.note}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Просмотр во весь экран -->
<div
  id="shot-view"
  class="fixed inset-0 z-[60] hidden place-items-center bg-void/95 p-4 backdrop-blur-xl md:p-10"
  role="dialog"
  aria-modal="true"
>
  <button
    id="shot-close"
    type="button"
    class="absolute top-4 right-4 grid h-11 w-11 place-items-center rounded-full border border-steel-300/25 text-steel-100 transition-colors hover:border-cyan hover:text-cyan md:top-8 md:right-8"
    aria-label="Закрыть"
  >
    ✕
  </button>
  <figure class="w-full max-w-[92rem]">
    <img id="shot-img" src="" alt="" class="max-h-[80svh] w-full rounded-xl object-contain" />
    <video
      id="shot-video"
      class="hidden max-h-[80svh] w-full rounded-xl object-contain"
      controls
      playsinline
    ></video>
    <figcaption id="shot-cap" class="mt-4 text-center font-mono text-[0.72rem] tracking-widest text-steel-300 uppercase"></figcaption>
  </figure>
</div>

<script>
  const view = document.getElementById('shot-view');
  const img = document.getElementById('shot-img') as HTMLImageElement | null;
  const video = document.getElementById('shot-video') as HTMLVideoElement | null;
  const cap = document.getElementById('shot-cap');
  let opener: HTMLElement | null = null;

  const open = (src: string, title: string, type: string, from: HTMLElement) => {
    if (!view || !img || !cap) return;
    opener = from;
    if (type === 'video' && video) {
      img.classList.add('hidden');
      img.src = '';
      video.classList.remove('hidden');
      video.src = src;
      video.play().catch(() => {});
    } else {
      video?.classList.add('hidden');
      if (video) video.src = '';
      img.classList.remove('hidden');
      img.src = src;
      img.alt = title;
    }
    cap.textContent = title;
    view.classList.remove('hidden');
    view.classList.add('grid');
    document.body.style.overflow = 'hidden';
    (document.getElementById('shot-close') as HTMLElement | null)?.focus();
  };

  const close = () => {
    if (!view) return;
    if (video) {
      video.pause();
      video.src = '';
    }
    view.classList.add('hidden');
    view.classList.remove('grid');
    document.body.style.overflow = '';
    opener?.focus();
  };

  document.querySelectorAll<HTMLElement>('.shot').forEach((el) => {
    el.addEventListener('click', () =>
      open(el.dataset.full ?? '', el.dataset.title ?? '', el.dataset.type ?? 'image', el),
    );
  });

  document.getElementById('shot-close')?.addEventListener('click', close);
  view?.addEventListener('click', (e) => {
    if (e.target === view) close();
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && view && !view.classList.contains('hidden')) close();
  });
</script>
