---
/**
 * Слой движения для всей страницы: инерционный скролл, появление блоков,
 * счётчики цифр и параллакс. Всё выключается при prefers-reduced-motion.
 */
---

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce) {
    (async () => {
      const [{ default: Lenis }, { gsap }, { ScrollTrigger }] = await Promise.all([
        import('lenis'),
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);

      gsap.registerPlugin(ScrollTrigger);

      // --- Инерционный скролл: главный источник ощущения «дорого» ---
      const lenis = new Lenis({ duration: 1.05, smoothWheel: true, touchMultiplier: 1.6 });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((t) => lenis.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);

      // Якорные ссылки должны попадать в цель через Lenis, а не мимо
      document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((a) => {
        const url = new URL(a.href, location.href);
        if (url.pathname !== location.pathname || url.hash.length < 2) return;
        a.addEventListener('click', (e) => {
          const target = document.querySelector(url.hash);
          if (!target) return;
          e.preventDefault();
          lenis.scrollTo(target as HTMLElement, { offset: -70, duration: 1.3 });
        });
      });

      // --- Строки списков идут волной, а не все разом ---
      document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((group) => {
        gsap.fromTo(
          group.children,
          { y: 26, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.7,
            ease: 'power3.out',
            stagger: 0.055,
            scrollTrigger: { trigger: group, start: 'top 86%', once: true },
          },
        );
      });


      // --- Магнитные кнопки: тянутся к курсору и отпускают с инерцией ---
      if (!matchMedia('(pointer: coarse)').matches) {
        document.querySelectorAll<HTMLElement>('.mag').forEach((el) => {
          const qx = gsap.quickTo(el, 'x', { duration: 0.5, ease: 'power3.out' });
          const qy = gsap.quickTo(el, 'y', { duration: 0.5, ease: 'power3.out' });
          el.addEventListener('pointermove', (e) => {
            const b = el.getBoundingClientRect();
            qx((e.clientX - b.left - b.width / 2) * 0.28);
            qy((e.clientY - b.top - b.height / 2) * 0.42);
          });
          el.addEventListener('pointerleave', () => { qx(0); qy(0); });
        });

        // --- Панели ловят блик под курсором ---
        document.querySelectorAll<HTMLElement>('.panel, .glow-follow').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const b = el.getBoundingClientRect();
            el.style.setProperty('--gx', e.clientX - b.left + 'px');
            el.style.setProperty('--gy', e.clientY - b.top + 'px');
          });
        });
      }

      // --- Цифры досчитываются на глазах ---
      document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        // Счётчик переписывает textContent, поэтому работает только с теми
        // элементами, внутри которых нет вёрстки — иначе он снесёт разметку.
        if (el.children.length > 0) return;
        const raw = el.textContent ?? '';
        const num = parseFloat(raw.replace(/[^\d.,]/g, '').replace(/\s/g, '').replace(',', '.'));
        if (!isFinite(num)) return;
        const prefix = raw.slice(0, raw.search(/[\d]/));
        const suffix = raw.slice(raw.search(/[\d]/) + String(num).length);
        const obj = { v: 0 };
        gsap.to(obj, {
          v: num,
          duration: 1.6,
          ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 90%', once: true },
          onUpdate: () => {
            const shown = num % 1 === 0 ? Math.round(obj.v).toLocaleString(document.documentElement.lang) : obj.v.toFixed(1);
            el.textContent = prefix + shown + suffix;
          },
        });
      });

    })();
  }
</script>
