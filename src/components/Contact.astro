---
import { site, url, type Locale } from '../data/site';
import { tr } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Личные контакты на странице не показываются — единственный вход это форма.
// Что произойдёт после отправки, человек должен понимать заранее.
const afterSend =
  locale === 'ru'
    ? [
        'Отвечаю в течение рабочего дня, обычно быстрее',
        'На первом созвоне честно говорю, берусь или нет',
        'Ваши данные никуда не передаются и не идут в рассылки',
      ]
    : [
        'I reply within one business day, usually sooner',
        'On the first call I tell you honestly whether I take it',
        'Your details go nowhere else and into no mailing list',
      ];

// Резервный адрес на случай, если сервис форм не ответит. В разметке лежит
// кодированным, чтобы сборщики адресов его не выцепили: расшифровка только в браузере.
const mailFallback = Buffer.from(site.email, 'utf-8').toString('base64');

const budgets =
  locale === 'ru'
    ? ['до 100 000 ₽', '100 000 — 300 000 ₽', '300 000 — 700 000 ₽', 'больше 700 000 ₽', 'пока не знаю']
    : ['under €1,000', '€1,000 — €3,000', '€3,000 — €7,000', 'over €7,000', 'not sure yet'];
---

<section id={locale === 'ru' ? 'kontakt' : 'contact'} class="on-dark scroll-mt-20 bg-ink/55 py-20 text-steel-100 md:py-28">
  <div class="shell grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
    <div>
      <p class="plate !text-cyan">{tr('contactPlate', locale)}</p>
      <h2 class="mt-6 text-big text-steel-50">{tr('contactTitle', locale)}</h2>
      <p class="mt-6 max-w-md text-[1.02rem] leading-relaxed text-steel-300">{tr('contactLead', locale)}</p>

      <ul class="mt-10 space-y-4 border-t border-steel-300/20 pt-8">
        {
          afterSend.map((line) => (
            <li class="flex items-start gap-3 text-[0.95rem] leading-snug text-steel-300">
              <span class="mt-2 h-1 w-3 shrink-0 rounded-full bg-gradient-to-r from-cyan to-violet" aria-hidden="true" />
              {line}
            </li>
          ))
        }
      </ul>
    </div>

    <form
      id="brief-form"
      class="grid gap-5 border border-steel-300/25 panel rounded-2xl p-6 md:p-9"
      data-endpoint={site.formEndpoint}
      data-key={site.formAccessKey}
      data-mail={site.formAccessKey ? undefined : site.email}
      data-mailb64={mailFallback}
      data-relay={site.telegramRelay || undefined}
      novalidate
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="f-name" class="plate !text-steel-300">{tr('formName', locale)}</label>
          <input id="f-name" name="name" type="text" required class="field" autocomplete="name" />
        </div>
        <div>
          <label for="f-contact" class="plate !text-steel-300">{tr('formContact', locale)}</label>
          <input id="f-contact" name="contact" type="text" required class="field" autocomplete="email" />
        </div>
      </div>

      <div>
        <label for="f-budget" class="plate !text-steel-300">{tr('formBudget', locale)}</label>
        <select id="f-budget" name="budget" class="field">
          {budgets.map((b) => <option value={b}>{b}</option>)}
        </select>
      </div>

      <div>
        <label for="f-task" class="plate !text-steel-300">{tr('formTask', locale)}</label>
        <textarea id="f-task" name="task" rows="5" required class="field resize-y" placeholder={tr('formTaskHint', locale)}
        ></textarea>
      </div>

      <!-- Ловушка для ботов -->
      <input type="checkbox" name="botcheck" tabindex="-1" class="hidden" aria-hidden="true" />

      <label class="group flex cursor-pointer items-start gap-3">
        <input type="checkbox" id="f-consent" name="consent" required class="peer sr-only" />
        <span
          aria-hidden="true"
          class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center border border-steel-300/50 transition-colors group-hover:border-steel-50 peer-checked:border-brass peer-checked:bg-brass"
        >
          <span class="tick text-[0.7rem] leading-none font-bold text-steel-50">✓</span>
        </span>
        <span class="text-[0.8rem] leading-relaxed text-steel-300">
          {locale === 'ru' ? 'Согласен на обработку' : 'I agree to the processing of my'}{' '}
          <a
            href={url(locale === 'ru' ? '/politika/' : '/en/privacy/')}
            class="underline decoration-brass underline-offset-2 transition-colors hover:text-brass"
          >
            {locale === 'ru' ? 'персональных данных' : 'personal data'}
          </a>{' '}
          {locale === 'ru' ? 'для ответа на заявку' : 'in order to receive a reply'}
        </span>
      </label>

      <button type="submit" class="btn !border-brass !bg-brass !text-steel-50 justify-center hover:!bg-brass-200">
        {tr('formSend', locale)}
      </button>

      <p id="form-status" role="status" aria-live="polite" class="hidden font-mono text-[0.8rem] text-moss-200"></p>
      <p class="text-[0.76rem] leading-relaxed text-steel-300/60">{tr('formPrivacy', locale)}</p>
    </form>
  </div>
</section>

<style>
  .field {
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.75rem 0.9rem;
    background: var(--color-ink);
    border: 1px solid color-mix(in oklab, var(--color-steel-300) 30%, transparent);
    color: var(--color-steel-50);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    transition: border-color 0.2s ease;
  }
  .field::placeholder {
    color: color-mix(in oklab, var(--color-steel-300) 55%, transparent);
  }
  .field:focus {
    border-color: var(--color-brass);
    outline: none;
  }
  .field:user-invalid {
    border-color: #b4522f;
  }
  .tick {
    transform: scale(0);
    transition: transform 0.2s var(--ease-station);
  }
  input:checked ~ span .tick {
    transform: scale(1);
  }
</style>

<script>
  const form = document.getElementById('brief-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    if (data.get('botcheck')) return; // ловушка сработала — это бот
    data.delete('consent'); // факт согласия проверен браузером, в письме он не нужен

    const ru = document.documentElement.lang === 'ru';
    const endpoint = form.dataset.endpoint;
    const key = form.dataset.key;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;

    const show = (text: string, ok: boolean) => {
      if (!status) return;
      status.textContent = text;
      status.classList.remove('hidden');
      status.style.color = ok ? 'var(--color-moss-200)' : '#e0885f';
    };

    // Готовое письмо со всем, что человек уже набрал, — ничего не пропадает
    const draftMail = () => {
      const b64 = form.dataset.mailb64;
      const addr = form.dataset.mail || (b64 ? atob(b64) : '');
      const body = [
        `${ru ? 'Имя' : 'Name'}: ${data.get('name')}`,
        `${ru ? 'Связь' : 'Contact'}: ${data.get('contact')}`,
        `${ru ? 'Бюджет' : 'Budget'}: ${data.get('budget')}`,
        '',
        String(data.get('task') ?? ''),
      ].join('\n');
      return `mailto:${addr}?subject=${encodeURIComponent(ru ? 'Заявка с сайта' : 'New enquiry')}&body=${encodeURIComponent(body)}`;
    };

    // Отправка не прошла — предлагаем выход, а не сообщаем о тупике
    const showFallback = () => {
      if (!status) return;
      status.textContent = ru
        ? 'Сервис отправки не ответил. Заявка не потеряна — откройте письмо, всё уже заполнено: '
        : 'The form service did not respond. Nothing is lost — open the email, it is already filled in: ';
      status.classList.remove('hidden');
      status.style.color = '#e0885f';
      const a = document.createElement('a');
      a.href = draftMail();
      a.textContent = ru ? 'открыть письмо' : 'open the email';
      a.className = 'underline underline-offset-4 hover:text-brass';
      status.appendChild(a);
    };

    // Заявка уходит в Telegram параллельно с почтой. Ошибка одного канала
    // не должна ронять отправку — поэтому результат не ждём и не проверяем здесь.
    const relay = form.dataset.relay;
    const toTelegram = () => {
      if (!relay) return;
      const payload = Object.fromEntries(data.entries());
      fetch(relay, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        keepalive: true,
      }).catch(() => {
        /* канал не обязателен: письмо на почту всё равно уйдёт */
      });
    };

    // Ключ задан — отправляем в фоне, посетителю ничего делать не нужно.
    if (key && endpoint) {
      btn.disabled = true;
      btn.textContent = ru ? 'Отправляю…' : 'Sending…';
      toTelegram();
      try {
        const name = String(data.get('name') ?? '').trim();
        const contact = String(data.get('contact') ?? '').trim();

        data.append('access_key', key);
        data.append('subject', ru ? `Заявка с сайта — ${name}` : `New enquiry — ${name}`);
        data.append('from_name', name || (ru ? 'Заявка с сайта' : 'Website enquiry'));
        // Если оставили почту — ответить можно будет прямо из письма
        if (/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(contact)) data.append('replyto', contact);
        const res = await fetch(endpoint, { method: 'POST', body: data });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        show(ru ? 'Отправлено. Отвечу в течение рабочего дня.' : 'Sent. I’ll reply within one business day.', true);
      } catch {
        showFallback();
      } finally {
        btn.disabled = false;
        btn.textContent = ru ? 'Отправить' : 'Send';
      }
      return;
    }

    toTelegram();

    // Запасной путь без сервера: открываем почтовый клиент с готовым письмом.
    window.location.href = draftMail();

    show(ru ? 'Открыл почтовый клиент — осталось нажать «Отправить».' : 'Opened your mail client — just hit send.', true);
  });
</script>
