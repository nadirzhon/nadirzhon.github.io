---
import { site, url, type Locale } from '../data/site';
import { tr } from '../data/i18n';
import { orderedServices } from '../data/services';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Выбор направления делает заявку осмысленной ещё до текста: человек не обязан
// формулировать, к какой услуге относится его задача — он просто указывает пальцем.
const serviceCards = orderedServices.map((s) => ({
  code: s.code,
  title: s.title[locale],
  tagline: s.tagline[locale],
  timeline: s.timeline[locale],
  href: url(locale === 'ru' ? `/uslugi/${s.slug.ru}/` : `/en/services/${s.slug.en}/`),
}));

// Личные контакты на странице не показываются — единственный вход это форма.
// Что произойдёт после отправки, человек должен понимать заранее.
const afterSend =
  locale === 'ru'
    ? [
        'Отвечаю в течение рабочего дня, обычно быстрее',
        'На первом созвоне честно говорю, берусь или нет',
        'Ваши данные никуда не передаются и не идут в рассылки',
      ]
    : [
        'I reply within one business day, usually sooner',
        'On the first call I tell you honestly whether I take it',
        'Your details go nowhere else and into no mailing list',
      ];

// Резервный адрес на случай, если сервис форм не ответит. В разметке лежит
// кодированным, чтобы сборщики адресов его не выцепили: расшифровка только в браузере.
const mailFallback = Buffer.from(site.email, 'utf-8').toString('base64');

const budgets =
  locale === 'ru'
    ? ['до 100 000 ₽', '100 000 — 300 000 ₽', '300 000 — 700 000 ₽', 'больше 700 000 ₽', 'пока не знаю']
    : ['under €1,000', '€1,000 — €3,000', '€3,000 — €7,000', 'over €7,000', 'not sure yet'];
---

<section id={locale === 'ru' ? 'kontakt' : 'contact'} class="on-dark scroll-mt-20 bg-ink/55 py-20 text-steel-100 md:py-28">
  <div class="shell grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
    {/* Форма выше левой колонки: без «липкости» под условиями работы
        оставалась бы пустая половина экрана */}
    <div class="contact-aside">
      <p class="plate !text-cyan">{tr('contactPlate', locale)}</p>
      <h2 class="mt-6 text-big text-steel-50">{tr('contactTitle', locale)}</h2>
      <p class="mt-6 max-w-md text-[1.02rem] leading-relaxed text-steel-300">{tr('contactLead', locale)}</p>

      <ul class="mt-10 space-y-4 border-t border-steel-300/20 pt-8">
        {
          afterSend.map((line) => (
            <li class="flex items-start gap-3 text-[0.95rem] leading-snug text-steel-300">
              <span class="mt-2 h-1 w-3 shrink-0 rounded-full bg-gradient-to-r from-cyan to-violet" aria-hidden="true" />
              {line}
            </li>
          ))
        }
      </ul>

      {/* Рабочие условия: клиент должен понимать, когда ему ответят и с кем
          он имеет дело, ещё до того, как что-то отправит */}
      <dl class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-steel-300/15 bg-steel-300/10 sm:grid-cols-2">
        <div class="bg-ink-800/80 px-5 py-4">
          <dt class="plate">{locale === 'ru' ? 'Отвечаю' : 'Reply'}</dt>
          <dd class="mt-1.5 text-[0.9rem] text-steel-100">
            {locale === 'ru' ? site.work.reply : site.work.replyEn}
          </dd>
        </div>
        <div class="bg-ink-800/80 px-5 py-4">
          <dt class="plate">{locale === 'ru' ? 'Часы работы' : 'Hours'}</dt>
          <dd class="mt-1.5 text-[0.9rem] text-steel-100">
            {locale === 'ru' ? site.work.hours : site.work.hoursEn}
            <span class="block font-mono text-[0.72rem] text-slate-1">{site.work.tz}</span>
          </dd>
        </div>
        <div class="bg-ink-800/80 px-5 py-4">
          <dt class="plate">{locale === 'ru' ? 'Языки' : 'Languages'}</dt>
          <dd class="mt-1.5 text-[0.9rem] text-steel-100">{site.work.languages}</dd>
        </div>
        <div class="bg-ink-800/80 px-5 py-4">
          <dt class="plate">{locale === 'ru' ? 'Работаю по договору' : 'Contract'}</dt>
          <dd class="mt-1.5 text-[0.9rem] text-steel-100">
            {
              site.work.legalForm
                ? (locale === 'ru' ? site.work.legalForm : site.work.legalFormEn || site.work.legalForm)
                : locale === 'ru' ? 'Всегда, с любой суммы' : 'Always, at any budget'
            }
            {site.work.inn && (
              <span class="block font-mono text-[0.72rem] text-slate-1">ИНН {site.work.inn}</span>
            )}
          </dd>
        </div>
      </dl>

      <p class="mt-6 text-[0.86rem] leading-relaxed text-slate-1">
        {
          locale === 'ru'
            ? 'Перед стартом подписываем договор. Правила работы — границы, оплата, права на код — описаны на отдельной странице.'
            : 'We sign a contract before starting. The rules — scope, payment, rights to the code — are on a separate page.'
        }
        <a href={url(locale === 'ru' ? '/usloviya/' : '/en/terms/')} class="link-sweep ml-1 text-steel-100">
          {locale === 'ru' ? 'Условия работы' : 'Terms of engagement'}
        </a>
      </p>
    </div>

    <form
      id="brief-form"
      class="grid gap-5 border border-steel-300/25 panel rounded-2xl p-6 md:p-9"
      data-endpoint={site.formEndpoint}
      data-key={site.formAccessKey}
      data-mail={site.formAccessKey ? undefined : site.email}
      data-mailb64={mailFallback}
      data-relay={site.telegramRelay || undefined}
      data-metrika={site.metrika || undefined}
      novalidate
    >
      {/* Полоса заполнения: видно, сколько осталось, — форма перестаёт быть ямой */}
      <div class="progress" aria-hidden="true"><span id="form-progress"></span></div>

      <!-- 01 — направление -->
      <div id="service-step" data-missing-msg={tr('formServiceMissing', locale)}>
        <p class="step"><span class="step__n">01</span>{tr('formStepService', locale)}</p>

        <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <span id="service-label" class="plate !text-steel-300">{tr('formService', locale)}</span>
          <a
            id="service-more"
            href="#"
            class="link-sweep hidden font-mono text-[0.7rem] tracking-widest whitespace-nowrap text-slate-1 uppercase hover:text-steel-100"
          >
            {tr('formServiceMore', locale)} <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="mt-3 grid gap-2.5 sm:grid-cols-2" role="radiogroup" aria-labelledby="service-label">
          {
            serviceCards.map((s) => (
              <label class="svc">
                <input
                  type="radio"
                  name="service"
                  class="svc__input"
                  value={`${s.code} · ${s.title}`}
                  data-code={s.code}
                  data-tagline={s.tagline}
                  data-timeline={s.timeline}
                  data-href={s.href}
                />
                <span class="svc__box">
                  <span class="svc__code">{s.code}</span>
                  <span class="svc__tick" aria-hidden="true">✓</span>
                  <span class="svc__title">{s.title}</span>
                </span>
              </label>
            ))
          }
          <label class="svc sm:col-span-2">
            <input
              type="radio"
              name="service"
              class="svc__input"
              value={tr('formServiceOther', locale)}
              data-code="—"
              data-tagline={tr('formServiceOtherNote', locale)}
            />
            <span class="svc__box">
              <span class="svc__code">S-00</span>
              <span class="svc__tick" aria-hidden="true">✓</span>
              <span class="svc__title">{tr('formServiceOther', locale)}</span>
            </span>
          </label>
        </div>

        <p id="service-note" class="mt-3 min-h-[1.4rem] font-mono text-[0.74rem] leading-relaxed text-slate-1">
          {tr('formServiceHint', locale)}
        </p>
      </div>

      <!-- 02 — контакты -->
      <div>
        <p class="step"><span class="step__n">02</span>{tr('formStepContacts', locale)}</p>

        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="f-name" class="plate !text-steel-300">{tr('formName', locale)}</label>
            <input id="f-name" name="name" type="text" required class="field" autocomplete="name" />
          </div>
          <div>
            <label for="f-contact" class="plate !text-steel-300">{tr('formContact', locale)}</label>
            <input id="f-contact" name="contact" type="text" required class="field" autocomplete="email" />
          </div>
        </div>

        <div class="mt-5">
          <label for="f-budget" class="plate !text-steel-300">{tr('formBudget', locale)}</label>
          <select id="f-budget" name="budget" class="field">
            {budgets.map((b) => <option value={b}>{b}</option>)}
          </select>
        </div>
      </div>

      <!-- 03 — задача -->
      <div>
        <p class="step"><span class="step__n">03</span>{tr('formStepTask', locale)}</p>

        {/* Заголовок шага уже назвал это поле — вторая подпись была бы шумом */}
        <label for="f-task" class="sr-only">{tr('formTask', locale)}</label>
        <textarea id="f-task" name="task" rows="5" required class="field resize-y" placeholder={tr('formTaskHint', locale)}
        ></textarea>
      </div>

      <!-- Ловушка для ботов -->
      <input type="checkbox" name="botcheck" tabindex="-1" class="hidden" aria-hidden="true" />

      <label class="group flex cursor-pointer items-start gap-3">
        <input type="checkbox" id="f-consent" name="consent" required class="peer sr-only" />
        <span
          aria-hidden="true"
          class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center border border-steel-300/50 transition-colors group-hover:border-steel-50 peer-checked:border-brass peer-checked:bg-brass"
        >
          <span class="tick text-[0.7rem] leading-none font-bold text-steel-50">✓</span>
        </span>
        <span class="text-[0.8rem] leading-relaxed text-steel-300">
          {locale === 'ru' ? 'Согласен на обработку' : 'I agree to the processing of my'}{' '}
          <a
            href={url(locale === 'ru' ? '/politika/' : '/en/privacy/')}
            class="underline decoration-brass underline-offset-2 transition-colors hover:text-brass"
          >
            {locale === 'ru' ? 'персональных данных' : 'personal data'}
          </a>{' '}
          {locale === 'ru' ? 'для ответа на заявку' : 'in order to receive a reply'}
        </span>
      </label>

      <button type="submit" class="btn btn-primary mag justify-center">
        {tr('formSend', locale)}
      </button>

      <p id="form-status" role="status" aria-live="polite" class="hidden font-mono text-[0.8rem] text-moss-200"></p>
      <p class="text-[0.76rem] leading-relaxed text-steel-300/60">{tr('formPrivacy', locale)}</p>
    </form>
  </div>
</section>

<style>
  .field {
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.75rem 0.9rem;
    background: var(--color-ink);
    border: 1px solid color-mix(in oklab, var(--color-steel-300) 30%, transparent);
    color: var(--color-steel-50);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    transition: border-color 0.2s ease;
  }
  .field::placeholder {
    color: color-mix(in oklab, var(--color-steel-300) 55%, transparent);
  }
  .field:focus {
    border-color: var(--color-brass);
    outline: none;
  }
  .field:user-invalid {
    border-color: #b4522f;
  }
  .tick {
    transform: scale(0);
    transition: transform 0.2s var(--ease-station);
  }
  input:checked ~ span .tick {
    transform: scale(1);
  }

  /* Левая колонка едет вместе с формой — но только если она целиком
     помещается в экран. Иначе заголовок уезжал бы под шапку. */
  @media (min-width: 1024px) and (min-height: 980px) {
    .contact-aside {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }

  /* Нумерованные шаги: форма читается как маршрут, а не как анкета */
  .step {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-slate-1);
  }
  .step__n {
    color: var(--color-cyan);
  }
  .step::after {
    content: '';
    flex: 1;
    height: 1px;
    background: color-mix(in oklab, var(--color-steel-300) 16%, transparent);
  }

  .progress {
    height: 2px;
    background: color-mix(in oklab, var(--color-steel-300) 14%, transparent);
    overflow: hidden;
  }
  .progress span {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(96deg, var(--color-cyan), var(--color-violet) 60%, var(--color-brass));
    transition: width 0.5s var(--ease-station);
  }

  /* Плитка направления. Сам input лежит поверх плитки и остаётся
     фокусируемым — стрелки и Tab работают как в обычной группе радио. */
  .svc {
    position: relative;
    display: block;
  }
  .svc__input {
    position: absolute;
    inset: 0;
    margin: 0;
    appearance: none;
    cursor: pointer;
    z-index: 1;
  }
  .svc__box {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'code tick'
      'title title';
    gap: 0.45rem 0.6rem;
    height: 100%;
    padding: 0.8rem 0.95rem 0.9rem;
    border: 1px solid color-mix(in oklab, var(--color-steel-300) 22%, transparent);
    background: color-mix(in oklab, var(--color-ink) 70%, transparent);
    transition:
      border-color 0.3s var(--ease-station),
      background 0.3s var(--ease-station),
      transform 0.3s var(--ease-station);
  }
  /* На телефоне тот же выбор занимает вдвое меньше высоты:
     код, название и отметка встают в одну строку */
  @media (max-width: 639px) {
    .svc__box {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'code title tick';
      align-items: center;
      gap: 0 0.75rem;
      padding: 0.7rem 0.85rem;
    }
    .svc__title {
      margin-top: 0;
    }
  }
  .svc__code {
    grid-area: code;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.18em;
    color: var(--color-slate-1);
    transition: color 0.3s var(--ease-station);
  }
  .svc__title {
    grid-area: title;
    display: block;
    font-size: 0.92rem;
    line-height: 1.3;
    color: var(--color-steel-200);
    transition: color 0.3s var(--ease-station);
  }
  .svc__tick {
    grid-area: tick;
    display: grid;
    place-items: center;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 999px;
    background: linear-gradient(120deg, var(--color-cyan), var(--color-violet));
    color: var(--color-void);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1;
    transform: scale(0);
    transition: transform 0.25s var(--ease-back);
  }
  .svc__input:hover ~ .svc__box {
    border-color: color-mix(in oklab, var(--color-steel-300) 45%, transparent);
    background: color-mix(in oklab, var(--color-ink-700) 75%, transparent);
    transform: translateY(-1px);
  }
  .svc__input:focus-visible ~ .svc__box {
    outline: 2px solid var(--color-cyan);
    outline-offset: 2px;
  }
  .svc__input:checked ~ .svc__box {
    border-color: color-mix(in oklab, var(--color-cyan) 55%, transparent);
    background: color-mix(in oklab, var(--color-cyan) 8%, transparent);
  }
  .svc__input:checked ~ .svc__box .svc__code {
    color: var(--color-cyan);
  }
  .svc__input:checked ~ .svc__box .svc__title {
    color: var(--color-steel-50);
  }
  .svc__input:checked ~ .svc__box .svc__tick {
    transform: scale(1);
  }
  /* Направление не выбрано, а человек уже жмёт «Отправить» */
  #service-step[data-invalid] .svc__box {
    border-color: #b4522f;
  }
  @media (prefers-reduced-motion: reduce) {
    .svc__box,
    .svc__tick,
    .progress span {
      transition: none;
    }
    .svc__input:hover ~ .svc__box {
      transform: none;
    }
  }
</style>

<script>
  const form = document.getElementById('brief-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  // --- Выбор направления -------------------------------------------------
  const step = document.getElementById('service-step');
  const note = document.getElementById('service-note');
  const more = document.getElementById('service-more') as HTMLAnchorElement | null;
  const bar = document.getElementById('form-progress');
  const radios = Array.from(
    form?.querySelectorAll<HTMLInputElement>('input[name="service"]') ?? [],
  );
  const hint = note?.textContent ?? '';

  // Полоса заполнения считает то, без чего заявку не отправить
  const progress = () => {
    if (!form || !bar) return;
    const filled = [
      radios.some((r) => r.checked),
      !!(form.querySelector<HTMLInputElement>('[name="name"]')?.value.trim()),
      !!(form.querySelector<HTMLInputElement>('[name="contact"]')?.value.trim()),
      !!(form.querySelector<HTMLTextAreaElement>('[name="task"]')?.value.trim()),
      !!(form.querySelector<HTMLInputElement>('#f-consent')?.checked),
    ].filter(Boolean).length;
    bar.style.width = `${(filled / 5) * 100}%`;
  };

  // Под сеткой всегда стоит строка о том, что именно выбрано, — выбор виден словами
  const paintService = () => {
    const picked = radios.find((r) => r.checked);
    step?.removeAttribute('data-invalid');
    if (!picked) {
      if (note) note.textContent = hint;
      more?.classList.add('hidden');
      return;
    }
    const timeline = picked.dataset.timeline;
    if (note) note.textContent = [picked.dataset.tagline, timeline].filter(Boolean).join(' · ');
    if (more && picked.dataset.href) {
      more.href = picked.dataset.href;
      more.classList.remove('hidden');
    } else {
      more?.classList.add('hidden');
    }
  };

  radios.forEach((r) =>
    r.addEventListener('change', () => {
      paintService();
      progress();
    }),
  );
  form?.addEventListener('input', progress);
  form?.addEventListener('change', progress);

  // Пришли со страницы услуги — направление уже выбрано за человека
  try {
    const code = sessionStorage.getItem('autonoma.service');
    if (code) {
      const match = radios.find((r) => r.dataset.code === code);
      if (match) match.checked = true;
    }
  } catch {}
  paintService();
  progress();

  // Если человек пришёл со страницы услуги и отметил там нужные блоки,
  // подставляем их в текст заявки — пересказывать руками не нужно.
  try {
    const raw = sessionStorage.getItem('autonoma.scope');
    const task = form?.querySelector<HTMLTextAreaElement>('[name="task"]');
    if (raw && task && !task.value.trim()) {
      const picked = JSON.parse(raw) as string[];
      if (Array.isArray(picked) && picked.length) {
        const ru = document.documentElement.lang === 'ru';
        task.value =
          (ru ? 'Из конструктора на странице услуги:\n' : 'From the scope builder on the service page:\n') +
          picked.map((t) => '— ' + t).join('\n') +
          '\n\n';
        task.focus();
        task.setSelectionRange(task.value.length, task.value.length);
      }
    }
  } catch {}

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const ru = document.documentElement.lang === 'ru';

    const show = (text: string, ok: boolean) => {
      if (!status) return;
      status.textContent = text;
      status.classList.remove('hidden');
      status.style.color = ok ? 'var(--color-moss-200)' : '#e0885f';
    };

    // Цель для Метрики и Директа. Считается только состоявшаяся заявка:
    // по кликам реклама оптимизироваться не умеет, по заявкам — умеет.
    const goal = () => {
      const id = form.dataset.metrika;
      const ym = (window as any).ym;
      if (id && typeof ym === 'function') ym(Number(id), 'reachGoal', 'zayavka');
    };

    // Радио скрыто под плиткой, поэтому браузер о нём ничего не скажет —
    // проверяем сами и говорим об этом там, где человек смотрит.
    if (!radios.some((r) => r.checked)) {
      step?.setAttribute('data-invalid', '');
      show(step?.dataset.missingMsg ?? '', false);
      step?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    if (!form.reportValidity()) return;

    const data = new FormData(form);
    if (data.get('botcheck')) return; // ловушка сработала — это бот
    data.delete('consent'); // факт согласия проверен браузером, в письме он не нужен

    const endpoint = form.dataset.endpoint;
    const key = form.dataset.key;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;

    // Готовое письмо со всем, что человек уже набрал, — ничего не пропадает
    const draftMail = () => {
      const b64 = form.dataset.mailb64;
      const addr = form.dataset.mail || (b64 ? atob(b64) : '');
      const body = [
        `${ru ? 'Направление' : 'Direction'}: ${data.get('service')}`,
        `${ru ? 'Имя' : 'Name'}: ${data.get('name')}`,
        `${ru ? 'Связь' : 'Contact'}: ${data.get('contact')}`,
        `${ru ? 'Бюджет' : 'Budget'}: ${data.get('budget')}`,
        '',
        String(data.get('task') ?? ''),
      ].join('\n');
      const subject = `${ru ? 'Заявка с сайта' : 'New enquiry'} — ${data.get('service')}`;
      return `mailto:${addr}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    };

    // Отправка не прошла — предлагаем выход, а не сообщаем о тупике
    const showFallback = () => {
      if (!status) return;
      status.textContent = ru
        ? 'Сервис отправки не ответил. Заявка не потеряна — откройте письмо, всё уже заполнено: '
        : 'The form service did not respond. Nothing is lost — open the email, it is already filled in: ';
      status.classList.remove('hidden');
      status.style.color = '#e0885f';
      const a = document.createElement('a');
      a.href = draftMail();
      a.textContent = ru ? 'открыть письмо' : 'open the email';
      a.className = 'underline underline-offset-4 hover:text-brass';
      status.appendChild(a);
    };

    // Заявка уходит в Telegram параллельно с почтой. Ошибка одного канала
    // не должна ронять отправку — поэтому результат не ждём и не проверяем здесь.
    const relay = form.dataset.relay;
    const toTelegram = () => {
      if (!relay) return;
      const payload = Object.fromEntries(data.entries());
      fetch(relay, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        keepalive: true,
      }).catch(() => {
        /* канал не обязателен: письмо на почту всё равно уйдёт */
      });
    };

    // Ключ задан — отправляем в фоне, посетителю ничего делать не нужно.
    if (key && endpoint) {
      btn.disabled = true;
      btn.textContent = ru ? 'Отправляю…' : 'Sending…';
      toTelegram();
      try {
        const name = String(data.get('name') ?? '').trim();
        const contact = String(data.get('contact') ?? '').trim();
        // Направление в теме письма: видно, о чём заявка, ещё в списке входящих
        const service = String(data.get('service') ?? '').trim();

        data.append('access_key', key);
        data.append(
          'subject',
          ru ? `Заявка с сайта — ${service} — ${name}` : `New enquiry — ${service} — ${name}`,
        );
        data.append('from_name', name || (ru ? 'Заявка с сайта' : 'Website enquiry'));
        // Если оставили почту — ответить можно будет прямо из письма
        if (/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(contact)) data.append('replyto', contact);
        const res = await fetch(endpoint, { method: 'POST', body: data });
        if (!res.ok) throw new Error(String(res.status));
        goal();
        form.reset();
        // Форма пуста — плитки, подсказка и полоса должны это показывать
        try { sessionStorage.removeItem('autonoma.service'); } catch {}
        paintService();
        progress();
        show(ru ? 'Отправлено. Отвечу в течение рабочего дня.' : 'Sent. I’ll reply within one business day.', true);
      } catch {
        showFallback();
      } finally {
        btn.disabled = false;
        btn.textContent = ru ? 'Отправить' : 'Send';
      }
      return;
    }

    toTelegram();

    // Запасной путь без сервера: открываем почтовый клиент с готовым письмом.
    window.location.href = draftMail();

    show(ru ? 'Открыл почтовый клиент — осталось нажать «Отправить».' : 'Opened your mail client — just hit send.', true);
  });
</script>
