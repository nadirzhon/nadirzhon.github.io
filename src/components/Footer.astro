---
import { site, url, type Locale } from '../data/site';
import { tr } from '../data/i18n';
import { orderedServices } from '../data/services';
import ContactLinks from './ContactLinks.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();
const base = locale === 'ru' ? '/uslugi' : '/en/services';
const contactHref = locale === 'ru' ? '/#kontakt' : '/en/#contact';
---

<footer class="on-dark bg-ink text-steel-200">
  <div class="rule-ticks opacity-25"></div>
  <div class="shell grid gap-10 py-16 md:grid-cols-[1.4fr_1fr_1fr] md:py-20">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="grid h-8 w-8 place-items-center border border-steel-300 font-mono text-[0.7rem] font-bold">
          {site.brandMark}
        </span>
        <span class="font-display text-[0.95rem] font-bold text-steel-50">{site.brand}</span>
      </div>
      <p class="mt-5 max-w-xs text-[0.9rem] leading-relaxed text-steel-300">{tr('footerLine', locale)}</p>

      {/* Прямые каналы связи — помимо формы. Почты деобфусцируются в браузере. */}
      <div class="mt-6">
        <ContactLinks locale={locale} variant="footer" />
      </div>

      <div class="mt-6">
        <a href={url(contactHref)} class="btn btn-ghost !px-4 !py-2">
          {tr('navContact', locale)} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div>
      <p class="plate !text-cyan">{tr('navServices', locale)}</p>
      <ul class="mt-4 space-y-2.5">
        {
          orderedServices.map((s) => (
            <li>
              <a
                href={url(`${base}/${s.slug[locale]}/`)}
                class="text-[0.9rem] text-steel-200 transition-colors hover:text-brass"
              >
                {s.title[locale]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="plate !text-cyan">{locale === 'ru' ? 'Разделы' : 'Sections'}</p>
      <ul class="mt-4 space-y-2.5">
        <li>
          <a
            href={url(locale === 'ru' ? '/keysy/' : '/en/work/')}
            class="text-[0.9rem] transition-colors hover:text-brass">{tr('navCases', locale)}</a
          >
        </li>
        <li>
          <a
            href={url(locale === 'ru' ? '/blog/' : '/en/journal/')}
            class="text-[0.9rem] transition-colors hover:text-brass">{tr('navBlog', locale)}</a
          >
        </li>
        <li>
          <a
            href={url(locale === 'ru' ? '/o-mne/' : '/en/about/')}
            class="text-[0.9rem] transition-colors hover:text-brass">{tr('navAbout', locale)}</a
          >
        </li>
        <li>
          <a
            href={url(locale === 'ru' ? '/#ceny' : '/en/#pricing')}
            class="text-[0.9rem] transition-colors hover:text-brass">{tr('navPrices', locale)}</a
          >
        </li>
        <li>
          <a
            href={url(locale === 'ru' ? '/#kontakt' : '/en/#contact')}
            class="text-[0.9rem] transition-colors hover:text-brass">{tr('navContact', locale)}</a
          >
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-steel-300/15">
    <div class="shell flex flex-col gap-2 py-6 font-mono text-[0.7rem] tracking-wider text-steel-300 sm:flex-row sm:justify-between">
      <span>© {year} {site.brand}. {tr('footerRights', locale)}.</span>
      <span class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a href={url(locale === 'ru' ? '/usloviya/' : '/en/terms/')} class="link-sweep transition-colors hover:text-cyan">
          {locale === 'ru' ? 'Условия работы' : 'Terms'}
        </a>
        <a href={url(locale === 'ru' ? '/politika/' : '/en/privacy/')} class="link-sweep transition-colors hover:text-cyan">
          {locale === 'ru' ? 'Обработка персональных данных' : 'Privacy policy'}
        </a>
      </span>
    </div>
  </div>
</footer>

<script>
  // Собираем рабочий mailto в браузере, чтобы почты не было в статичном HTML.
  // Обрабатываем все ссылки с data-mailb64 на странице (футер и блок контактов).
  for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-mailb64]')) {
    try {
      const email = atob(a.dataset.mailb64 || '');
      if (!email) continue;
      a.href = 'mailto:' + email;
      // Где нужен адрес текстом (data-mail-show), показываем сам email.
      if (a.dataset.mailShow === '1') a.textContent = email;
    } catch {}
  }
</script>
