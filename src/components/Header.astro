---
import { site, url, type Locale } from '../data/site';
import { tr } from '../data/i18n';

interface Props {
  locale: Locale;
  altPath: string;
  /** Страница открывается тёмным героем — шапка стартует прозрачной */
  darkHero?: boolean;
}
const { locale, altPath, darkHero = false } = Astro.props;
const home = url(locale === 'ru' ? '/' : '/en/');

const nav = [
  { label: tr('navServices', locale), href: url(locale === 'ru' ? '/#uslugi' : '/en/#services') },
  { label: tr('navCases', locale), href: url(locale === 'ru' ? '/keysy/' : '/en/work/') },
  { label: tr('navMethod', locale), href: url(locale === 'ru' ? '/#metod' : '/en/#method') },
  { label: tr('navPrices', locale), href: url(locale === 'ru' ? '/#ceny' : '/en/#pricing') },
  { label: tr('navBlog', locale), href: url(locale === 'ru' ? '/blog/' : '/en/journal/') },
  { label: tr('navAbout', locale), href: url(locale === 'ru' ? '/o-mne/' : '/en/about/') },
];
const contactHref = url(locale === 'ru' ? '/#kontakt' : '/en/#contact');
---

<header
  id="site-header"
  class:list={['sticky top-0 z-50 backdrop-blur-xl', darkHero && 'over-hero']}
  data-dark-hero={darkHero ? '' : undefined}
>
  <div class="shell flex h-16 items-center justify-between gap-4 md:h-[4.5rem]">
    <a href={home} class="group flex items-center gap-2.5" aria-label={site.brand}>
      <span
        class="grid h-8 w-8 place-items-center rounded-md border border-steel-300/30 font-mono text-[0.7rem] font-bold tracking-tight transition-all duration-300 group-hover:border-transparent group-hover:bg-gradient-to-br group-hover:from-cyan group-hover:to-violet group-hover:text-void"
      >
        {site.brandMark}
      </span>
      <span class="font-display text-[0.95rem] font-bold tracking-[-0.02em]">{site.brand}</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label={locale === 'ru' ? 'Основное меню' : 'Main'}>
      {
        nav.map((i) => (
          <a
            href={i.href}
            class="relative py-1 text-[0.9rem] font-medium text-steel-300 transition-colors hover:text-steel-50 after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-brass after:transition-all hover:after:w-full"
          >
            {i.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={url(altPath)}
        class="border border-slate-1/40 px-2.5 py-1.5 font-mono text-[0.7rem] font-medium tracking-widest transition-colors hover:border-ink hover:bg-ink hover:text-steel-50"
        hreflang={locale === 'ru' ? 'en' : 'ru'}
      >
        {tr('langSwitch', locale)}
      </a>
      <a href={contactHref} class="btn btn-primary hidden !px-4 !py-2.5 sm:inline-flex">
        {tr('navContact', locale)}
      </a>
      <button
        type="button"
        id="menu-btn"
        class="grid h-9 w-9 place-items-center border border-slate-1/40 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={locale === 'ru' ? 'Меню' : 'Menu'}
      >
        <span class="relative block h-px w-4 bg-current before:absolute before:-top-1.5 before:h-px before:w-4 before:bg-current
          after:absolute after:top-1.5 after:h-px after:w-4 after:bg-current"></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-slate-1/20 bg-ink-800 lg:hidden">
    <nav class="shell flex flex-col py-2">
      {
        nav.map((i) => (
          <a href={i.href} class="border-b border-slate-1/15 py-3.5 text-[0.95rem] font-medium">
            {i.label}
          </a>
        ))
      }
      <a href={contactHref} class="btn btn-primary my-4 justify-center">{tr('navContact', locale)}</a>
    </nav>
  </div>
</header>

<style is:global>
  /* На страницах с тёмным героем шапка лежит поверх, а не над ним */
  #site-header[data-dark-hero] {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
  }

  #site-header {
    background: color-mix(in oklab, var(--color-void) 72%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--color-steel-300) 12%, transparent);
    transition:
      background-color 0.45s var(--ease-station),
      border-color 0.45s var(--ease-station),
      color 0.45s var(--ease-station);
  }

  /* Над тёмным героем шапка растворяется и светлеет */
  #site-header.over-hero {
    background: transparent;
    border-color: transparent;
    color: var(--color-steel-50);
  }
  #site-header.over-hero a,
  #site-header.over-hero span,
  #site-header.over-hero button {
    color: var(--color-steel-50);
  }
  #site-header.over-hero a > span:first-child,
  #site-header.over-hero a[hreflang] {
    border-color: color-mix(in oklab, var(--color-steel-50) 55%, transparent);
  }
  #site-header.over-hero .btn-primary {
    color: var(--color-void) !important;
  }
  #site-header.over-hero [aria-label='Меню'] span,
  #site-header.over-hero [aria-label='Menu'] span {
    background: var(--color-steel-50);
  }
  #site-header.over-hero [aria-label='Меню'] span::before,
  #site-header.over-hero [aria-label='Меню'] span::after,
  #site-header.over-hero [aria-label='Menu'] span::before,
  #site-header.over-hero [aria-label='Menu'] span::after {
    background: var(--color-steel-50);
  }
</style>

<script>
  // Пока тёмный герой под шапкой — шапка прозрачная.
  // Раньше это считалось от innerHeight и держалось на допущении, что первый
  // экран ровно в высоту окна. Теперь смотрим на сам герой: при любой его
  // высоте — хоть полёт камеры, хоть короткий блок — поведение одинаковое.
  const header = document.getElementById('site-header');
  if (header && header.dataset.darkHero !== undefined) {
    const hero = document.getElementById('hero-dark');
    if (hero) {
      new IntersectionObserver(
        ([e]) => header.classList.toggle('over-hero', e.isIntersecting),
        // Герой считается «под шапкой», пока его низ не поднялся выше её края
        { rootMargin: '-90px 0px 0px 0px', threshold: 0 },
      ).observe(hero);
    } else {
      header.classList.remove('over-hero');
    }
  }

  const btn = document.getElementById('menu-btn');
  const panel = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
  panel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      panel.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    }),
  );
</script>
