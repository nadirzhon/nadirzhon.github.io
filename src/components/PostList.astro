---
import { getCollection } from 'astro:content';
import { url, type Locale } from '../data/site';
import { tr } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const posts = (await getCollection('posts', (p) => p.data.lang === locale && !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const base = locale === 'ru' ? '/blog' : '/en/journal';
const dateFmt = new Intl.DateTimeFormat(locale === 'ru' ? 'ru-RU' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

{
  posts.length === 0 ? (
    <p class="border border-dashed border-slate-1/40 p-8 text-center text-slate-1">
      {locale === 'ru' ? 'Записей пока нет.' : 'No entries yet.'}
    </p>
  ) : (
    <ul class="border-t border-slate-1/25">
      {posts.map((p) => (
        <li class="reveal group border-b border-slate-1/25">
          <a
            href={url(`${base}/${p.id.replace(/-(ru|en)$/, '')}/`)}
            class="grid gap-x-8 gap-y-3 py-8 transition-[padding] duration-300 group-hover:px-3 md:grid-cols-[9rem_1fr]"
          >
            <div class="font-mono text-[0.72rem] tracking-widest text-slate-1 uppercase">
              <div>{dateFmt.format(p.data.date)}</div>
              <div class="mt-1.5 text-slate-1/70">
                {p.data.readingTime} {tr('minRead', locale)}
              </div>
            </div>

            <div>
              <h2 class="text-[1.35rem] leading-tight transition-opacity group-hover:opacity-80 md:text-[1.6rem]">
                {p.data.title}
              </h2>
              <p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-steel-300">{p.data.description}</p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {p.data.tags.map((tag) => (
                  <span class="border border-slate-1/30 px-2 py-0.5 font-mono text-[0.65rem] text-slate-1">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )
}
