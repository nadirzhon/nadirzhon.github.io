---
/**
 * Услуги как витрина продукта, а не строчка в списке.
 *
 * Каждая услуга — отдельный кадр во всю высоту экрана: что именно человек
 * получает на руки, за какой срок и на чём это собрано. Цену не показываем:
 * она собирается под задачу после разведки, а не выбирается из прайса.
 * Кадры едут вбок, пока страница листается вниз, — прокрутка одна, поэтому
 * никто не «теряется» и не пропускает половину направлений.
 *
 * Справа у каждой услуги свой каркасный объект: он не декоративный, а
 * подобран по смыслу — замкнутый контур для автоматизации, гранёная сфера
 * для диалога, тор для рыночного цикла.
 */
import { url, type Locale } from '../data/site';
import { tr } from '../data/i18n';
import { orderedServices } from '../data/services';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const base = locale === 'ru' ? '/uslugi' : '/en/services';

const items = orderedServices;
const hint =
  locale === 'ru'
    ? 'Листайте вниз — направления идут одно за другим'
    : 'Keep scrolling — disciplines come one after another';
const gotLabel = (n: number) =>
  locale === 'ru' ? `${n} ${n === 1 ? 'позиция' : n < 5 ? 'позиции' : 'позиций'} на руки` : `${n} deliverables`;
---

<section
  id={locale === 'ru' ? 'uslugi' : 'services'}
  class="svc-pin on-dark relative bg-ink/55 text-steel-100"

>
  <div class="svc-stage relative flex h-[100svh] flex-col overflow-hidden">
    <!-- Каркасный объект текущей услуги -->
    <canvas
      id="svc-canvas"
      aria-hidden="true"
      class="pointer-events-none absolute top-0 right-0 hidden h-full w-[46%] opacity-0 transition-opacity duration-1000 will-change-transform lg:block"
    ></canvas>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 hidden bg-[linear-gradient(100deg,#05070c_36%,rgba(5,7,12,0.58)_62%,transparent_88%)] lg:block"
    >
    </div>

    <!-- Шапка блока -->
    <header class="shell relative z-10 flex shrink-0 flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pt-24 pb-5">
      <h2 class="flex items-baseline gap-4 text-[1.35rem] leading-none md:text-[1.7rem]">
        <span class="plate !text-cyan">{tr('servicesPlate', locale)}</span>
        {tr('servicesTitle', locale)}
      </h2>
      <p class="hidden font-mono text-[0.66rem] tracking-wider text-steel-300/60 uppercase md:block">
        {hint}
      </p>
    </header>

    <!-- Лента кадров -->
    <div class="svc-viewport relative z-10 flex-1 overflow-hidden">
      <div class="svc-track flex h-full">
        {
          items.map((s, i) => (
            <article class="svc-panel flex h-full w-screen shrink-0 flex-col justify-center">
              <div class="shell w-full">
                <div class="max-w-[38rem] lg:max-w-[32rem] xl:max-w-[38rem]">
                  <div class="flex items-baseline gap-4">
                    <span class="font-mono text-[0.72rem] tracking-widest text-cyan">{s.code}</span>
                    <span class="h-px flex-1 bg-steel-300/20" />
                    <span class="font-mono text-[0.72rem] tracking-widest text-steel-300/60">
                      {String(i + 1).padStart(2, '0')} / {String(items.length).padStart(2, '0')}
                    </span>
                  </div>

                  <h3 class="mt-4 font-display text-[1.6rem] leading-[1.05] font-bold tracking-tight md:text-[2.2rem]">
                    {s.title[locale]}
                  </h3>
                  <p class="svc-tagline mt-3 text-[1rem] text-steel-300 md:text-[1.08rem]">{s.tagline[locale]}</p>

                  <p class="plate mt-7 flex items-center gap-3 !text-steel-300/70">
                    {tr('serviceGet', locale)}
                    <span class="h-px w-6 bg-gradient-to-r from-cyan to-violet" />
                    <span class="grad-text">{gotLabel(s.deliverables[locale].length)}</span>
                  </p>

                  <ul class="mt-3.5 grid gap-2">
                    {s.deliverables[locale].map((d, di) => (
                      <li
                        class="svc-line flex gap-3 text-[0.93rem] leading-snug text-steel-100/90 md:text-[0.97rem]"
                        style={`--li:${di}`}
                      >
                        <span aria-hidden="true" class="mt-2 h-1 w-3 shrink-0 rounded-full bg-gradient-to-r from-cyan to-violet" />
                        <span>{d}</span>
                      </li>
                    ))}
                  </ul>

                  <dl class="mt-7 flex flex-wrap gap-x-10 gap-y-3 border-t border-steel-300/15 pt-4">
                    <div>
                      <dt class="plate !text-steel-300/60">{tr('serviceTerm', locale)}</dt>
                      <dd class="mt-1.5 font-mono text-[0.84rem] text-steel-100">{s.timeline[locale]}</dd>
                    </div>
                    <div class="min-w-[12rem]">
                      <dt class="plate !text-steel-300/60">{tr('serviceStack', locale)}</dt>
                      <dd class="mt-1.5 font-mono text-[0.78rem] leading-relaxed text-steel-300">
                        {s.stack.join(' · ')}
                      </dd>
                    </div>
                  </dl>

                  <a
                    href={url(`${base}/${s.slug[locale]}/`)}
                    class="btn btn-ghost mag mt-6"
                  >
                    {tr('serviceMore', locale)}
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Индикатор: где мы в ленте -->
    <div class="shell relative z-10 shrink-0 pt-3 pb-7">
      <div class="flex items-center gap-5">
        <div class="h-px flex-1 bg-steel-300/15">
          <div id="svc-bar" class="h-px w-0 bg-gradient-to-r from-cyan to-violet transition-[width] duration-200 ease-out"></div>
        </div>
        <ul class="flex gap-2" aria-hidden="true">
          {items.map(() => <li class="svc-dot h-1.5 w-1.5 rounded-full bg-steel-300/25 transition-colors duration-300" />)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Состав работ проявляется построчно. Пять пунктов, вспыхнувших разом,
     глаз воспринимает как блок и пропускает; идущие волной — читает. */
  .svc-panel .svc-line {
    opacity: 0;
    transform: translateY(10px);
  }
  .svc-panel.is-live .svc-line {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s var(--ease-station),
      transform 0.55s var(--ease-station);
    transition-delay: calc(0.16s + var(--li) * 0.075s);
  }

  /* Заголовок и подзаголовок кадра идут первыми, до состава */
  .svc-panel h3,
  .svc-panel .svc-tagline {
    opacity: 0;
    transform: translateY(14px);
  }
  .svc-panel.is-live h3,
  .svc-panel.is-live .svc-tagline {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.55s var(--ease-station),
      transform 0.6s var(--ease-station);
  }
  .svc-panel.is-live .svc-tagline { transition-delay: 0.08s; }

  @media (prefers-reduced-motion: reduce) {
    .svc-panel .svc-line,
    .svc-panel h3,
    .svc-panel .svc-tagline {
      opacity: 1;
      transform: none;
    }
  }

  /* На низком экране (ноутбук 13", окно с панелями) кадр всё равно должен
     помещаться целиком: поджимаем шрифты и отступы, а не режем содержимое. */
  @media (min-width: 1024px) and (max-height: 900px) {
    .svc-pin .svc-panel h3 {
      font-size: 1.75rem;
    }
    .svc-pin .svc-panel li {
      font-size: 0.88rem;
    }
    .svc-pin .svc-panel ul {
      gap: 0.4rem;
    }
    .svc-pin .svc-panel dl {
      margin-top: 1.1rem;
      padding-top: 0.8rem;
    }
    .svc-pin .svc-panel .btn {
      margin-top: 1rem;
      padding-block: 0.7rem;
    }
  }

  /* Без пиннинга (телефон, планшет, prefers-reduced-motion) кадры
     превращаются в обычные карточки — контент остаётся весь. */
  @media (max-width: 1023px) {
    .svc-pin .svc-stage {
      height: auto;
      overflow: visible;
    }
    .svc-pin .svc-viewport {
      overflow: visible;
    }
    .svc-pin .svc-track {
      display: grid;
      gap: 1px;
      background: color-mix(in oklab, var(--color-steel-300) 14%, transparent);
      height: auto;
    }
    .svc-pin .svc-panel {
      width: 100%;
      height: auto;
      background: var(--color-ink);
      padding-block: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-pin .svc-stage {
      height: auto;
      overflow: visible;
    }
    .svc-pin .svc-viewport {
      overflow: visible;
    }
    .svc-pin .svc-track {
      display: grid;
      height: auto;
    }
    .svc-pin .svc-panel {
      width: 100%;
      height: auto;
      padding-block: 3rem;
    }
    #svc-canvas {
      display: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('.svc-pin');
  const stage = section?.querySelector<HTMLElement>('.svc-stage');
  const track = section?.querySelector<HTMLElement>('.svc-track');
  const bar = section?.querySelector<HTMLElement>('#svc-bar') ?? null;
  const dots = Array.from(section?.querySelectorAll<HTMLElement>('.svc-dot') ?? []);
  const canvas = (section?.querySelector('#svc-canvas') ?? null) as HTMLCanvasElement | null;

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = matchMedia('(min-width: 1024px)');

  /* ─── Каркасные объекты услуг ────────────────────────────────────────── */
  let setShape: ((i: number) => void) | null = null;

  const bootShapes = async () => {
    if (!canvas || reduce) return;
    const THREE = await import('three');

    // Раньше форма была облаком случайных точек и читалась как туман.
    // Теперь это настоящий каркас: рёбра фигуры режутся на отрезки, и
    // рисуются линиями. Порядок отрезков одинаков у всех форм — поэтому
    // каркас может перетекать в каркас, а не гаснуть и зажигаться заново.
    const SEGMENTS = 1400;  // отрезков в каркасе; одинаково для всех форм

    const sampleEdges = (geo: any): Float32Array => {
      const edges = new THREE.EdgesGeometry(geo, 1);
      const src = edges.getAttribute('position').array as Float32Array;
      const edgeCount = src.length / 6;
      // Две вершины на отрезок: LineSegments читает их парами
      const out = new Float32Array(SEGMENTS * 6);

      for (let i = 0; i < SEGMENTS; i++) {
        // Берём ребро целиком, а не его кусок: иначе каркас рвётся на штрихи.
        // Рёбра выбираются равномерно по списку, поэтому одинаковый индекс
        // у разных фигур означает «примерно то же место каркаса» — и переход
        // выглядит деформацией одного объекта, а не подменой.
        const e = Math.floor((i * edgeCount) / SEGMENTS) % edgeCount;
        const o = e * 6;
        const k = i * 6;
        out[k]     = src[o];
        out[k + 1] = src[o + 1];
        out[k + 2] = src[o + 2];
        out[k + 3] = src[o + 3];
        out[k + 4] = src[o + 4];
        out[k + 5] = src[o + 5];
      }
      edges.dispose();
      geo.dispose();
      return out;
    };

    // Форма подобрана под смысл услуги, а не «какая красивее»
    const shapes = [
      sampleEdges(new THREE.TorusKnotGeometry(1.15, 0.36, 96, 12)),   // S-01 замкнутый контур
      sampleEdges(new THREE.IcosahedronGeometry(1.65, 1)),            // S-02 гранёный диалог
      sampleEdges(new THREE.BoxGeometry(2.1, 1.5, 1.5, 3, 2, 2)),     // S-03 сетка страниц
      sampleEdges(new THREE.CapsuleGeometry(0.78, 1.5, 6, 18)),       // S-04 корпус телефона
      sampleEdges(new THREE.DodecahedronGeometry(1.6, 0)),            // S-05 ядро системы
      sampleEdges(new THREE.TorusGeometry(1.25, 0.42, 14, 40)),       // S-06 рыночный цикл
    ];

    const cur = new Float32Array(shapes[0]);
    const from = new Float32Array(shapes[0]);
    let to = shapes[0];
    let mix = 1;

    const VERTS = SEGMENTS * 2;
    const seed = new Float32Array(VERTS);
    // Затравка одинакова у обеих вершин отрезка — иначе линия мерцает по длине
    for (let i = 0; i < SEGMENTS; i++) {
      const v = Math.random();
      seed[i * 2] = v;
      seed[i * 2 + 1] = v;
    }

    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(cur, 3));
    geo.setAttribute('aSeed', new THREE.BufferAttribute(seed, 1));

    const uniforms = {
      uTime: { value: 0 },
      uDpr: { value: Math.min(devicePixelRatio, 2) },
      uBurst: { value: 0 },
      uCyan: { value: new THREE.Color(0x25e8c8) },
      uSteel: { value: new THREE.Color(0xeef2fa) },
      uViolet: { value: new THREE.Color(0x6e5bff) },
    };

    const mat = new THREE.ShaderMaterial({
      uniforms,
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      vertexShader: `
        uniform float uTime, uBurst;
        attribute float aSeed;
        varying float vSeed, vDepth, vBurst;
        void main() {
          // Каркас дышит: лёгкое смещение по своей фазе, чтобы объект
          // не выглядел мёртвой моделью из редактора
          vec3 pos = position;
          float ph = uTime * 0.6 + aSeed * 6.28;
          pos += normalize(pos + 0.0001) * sin(ph) * 0.018;

          // Смена услуги — не перетекание, а пересборка: каркас разлетается
          // наружу и собирается заново. Каждое ребро уходит по своему
          // направлению, поэтому объект распадается на детали, а не раздувается.
          if (uBurst > 0.001) {
            vec3 dir = normalize(pos + vec3(
              sin(aSeed * 51.7), cos(aSeed * 33.1), sin(aSeed * 71.3)
            ) * 0.55 + 0.0001);
            pos += dir * uBurst * (1.5 + aSeed * 3.2);
          }

          vec4 mv = modelViewMatrix * vec4(pos, 1.0);
          gl_Position = projectionMatrix * mv;
          vSeed = aSeed;
          vDepth = -mv.z;
          vBurst = uBurst;
        }
      `,
      fragmentShader: `
        uniform vec3 uCyan, uSteel, uViolet;
        varying float vSeed, vDepth, vBurst;
        void main() {
          // Ближние рёбра стальные, дальние уходят в фиолет — появляется глубина
          float d = clamp((vDepth - 3.0) / 5.5, 0.0, 1.0);
          vec3 col = mix(uSteel, uCyan, vSeed);
          col = mix(col, uViolet, d * 0.8);
          // На пике разлёта детали вспыхивают, но линии становятся тоньше по
          // прозрачности — иначе разлетевшийся каркас превращается в кашу
          col = mix(col, uSteel, vBurst * 0.5);
          float a = (1.0 - d * 0.55) * 0.9 * (1.0 - vBurst * 0.45);
          gl_FragColor = vec4(col, a);
        }
      `,
    });

    const wire = new THREE.LineSegments(geo, mat);
    const group = new THREE.Group();
    group.add(wire);
    group.position.y = -0.35;
    const scene = new THREE.Scene();
    scene.add(group);

    const camera = new THREE.PerspectiveCamera(46, 1, 0.1, 100);
    camera.position.z = 8.4;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false });
    renderer.setClearColor(0x000000, 0);

    const resize = () => {
      const w = canvas.clientWidth || 1;
      const h = canvas.clientHeight || 1;
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      uniforms.uDpr.value = Math.min(devicePixelRatio, 2);
    };
    resize();
    addEventListener('resize', resize, { passive: true });

    let active = 0;
    setShape = (i: number) => {
      if (i === active) return;
      active = i;
      from.set(cur);
      to = shapes[i];
      mix = 0;
    };

    let mx = 0, my = 0, tx = 0, ty = 0;
    addEventListener(
      'pointermove',
      (e) => {
        const r = canvas.getBoundingClientRect();
        if (r.width === 0) return;
        tx = ((e.clientX - r.left) / r.width - 0.5) * 1.2;
        ty = ((e.clientY - r.top) / r.height - 0.5) * 1.2;
      },
      { passive: true }
    );

    const clock = new THREE.Clock();
    let onScreen = true;
    new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; }, { threshold: 0 }).observe(canvas);

    const posAttr = geo.getAttribute('position');
    const tick = () => {
      requestAnimationFrame(tick);
      if (!onScreen) return;
      const dt = Math.min(clock.getDelta(), 0.05);
      uniforms.uTime.value = clock.getElapsedTime();

      if (mix < 1) {
        mix = Math.min(1, mix + dt * 1.35);
        const e = 1 - Math.pow(1 - mix, 3);
        for (let i = 0; i < cur.length; i++) cur[i] = from[i] + (to[i] - from[i]) * e;
        posAttr.needsUpdate = true;
        // Разлёт нарастает и спадает по синусу: ноль в начале и в конце,
        // пик — ровно там, где старая форма уже не читается, а новая ещё нет
        uniforms.uBurst.value = Math.sin(mix * Math.PI) * 0.95;
      } else if (uniforms.uBurst.value !== 0) {
        uniforms.uBurst.value = 0;
      }

      mx += (tx - mx) * 0.07;
      my += (ty - my) * 0.07;
      // Наклон за курсором заметный, но с демпфером: объект отзывается,
      // а не дёргается вслед за каждым движением мыши
      group.rotation.y += dt * 0.2 + (mx * 1.1 - group.rotation.y) * 0.012;
      group.rotation.x += (my * 0.75 - group.rotation.x) * 0.06;
      group.rotation.z += (mx * 0.18 - group.rotation.z) * 0.06;
      // Небольшой отъезд камеры на пике разлёта — детали помещаются в кадр
      group.scale.setScalar(1 - uniforms.uBurst.value * 0.2);

      renderer.render(scene, camera);
    };
    canvas.style.opacity = '1';
    tick();
  };

  /* ─── Пиннинг ленты ──────────────────────────────────────────────────── */
  const allPanels = Array.from(section?.querySelectorAll<HTMLElement>('.svc-panel') ?? []);

  const setActive = (i: number) => {
    dots.forEach((d, k) => {
      d.classList.toggle('bg-cyan', k === i);
      d.classList.toggle('bg-steel-300/25', k !== i);
    });
    // Кадр «оживает» только когда камера на нём: строки состава идут волной,
    // а не вспыхивают заранее за пределами экрана
    allPanels.forEach((el, k) => el.classList.toggle('is-live', k === i));
    setShape?.(i);
  };

  const canvasEl = section?.querySelector<HTMLElement>('#svc-canvas') ?? null;
  const headEl = section?.querySelector<HTMLElement>('header') ?? null;

  const bootPin = async () => {
    if (!section || !stage || !track || reduce || !wide.matches) return;
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([import('gsap'), import('gsap/ScrollTrigger')]);
    gsap.registerPlugin(ScrollTrigger);

    const panels = Array.from(track.children) as HTMLElement[];
    const distance = () => track.scrollWidth - innerWidth;

    gsap.to(track, {
      x: () => -distance(),
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: () => '+=' + distance(),
        pin: stage,
        scrub: 0.7,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          const p = self.progress;
          if (bar) bar.style.width = (p * 100).toFixed(1) + '%';
          setActive(Math.min(panels.length - 1, Math.round(p * (panels.length - 1))));

          // Каркас отстаёт от ленты и слегка уходит вглубь к концу маршрута —
          // получается ощущение, что кадры едут мимо объекта, а не вместе с ним
          if (canvasEl) {
            canvasEl.style.transform =
              `translate3d(${(p * 64).toFixed(1)}px, 0, 0) scale(${(1 + p * 0.06).toFixed(3)})`;
          }
          // Шапка блока уезжает совсем чуть-чуть: она якорь, а не участник
          if (headEl) headEl.style.transform = `translate3d(${(p * -26).toFixed(1)}px, 0, 0)`;
        },
      },
    });
  };

  const start = () => {
    bootShapes().catch(() => {
      // Без WebGL остаётся текст — блок не разваливается
    });
    bootPin().catch(() => {});
  };

  if (section) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          start();
        }
      },
      { rootMargin: '400px' }
    );
    io.observe(section);
    if (reduce || !wide.matches) {
      // Плоский список: все кадры видимы сразу, иначе текст просто не покажется
      allPanels.forEach((el) => el.classList.add('is-live'));
    } else {
      setActive(0);
    }
  }
</script>
