---
import { url, type Locale } from '../data/site';
import { tr } from '../data/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Валютные параметры расчёта. floor — нижняя граница стоимости проекта.
const cfg =
  locale === 'ru'
    ? { cur: '₽', loc: 'ru-RU', rate: { min: 300, max: 4000, step: 50, def: 900 }, floor: 90000 }
    : { cur: '€', loc: 'en-US', rate: { min: 10, max: 120, step: 2, def: 30 }, floor: 900 };

const sliders = [
  { id: 'people', label: tr('calcPeople', locale), min: 1, max: 40, step: 1, def: 4, suffix: '' },
  { id: 'hours', label: tr('calcHours', locale), min: 1, max: 40, step: 1, def: 12, suffix: locale === 'ru' ? ' ч' : ' h' },
  { id: 'rate', label: tr('calcRate', locale), ...cfg.rate, suffix: ` ${cfg.cur}` },
  { id: 'auto', label: tr('calcAuto', locale), min: 10, max: 90, step: 5, def: 60, suffix: '%' },
];

const outputs = [
  { id: 'out-cost', label: tr('calcResultYear', locale), accent: false },
  { id: 'out-saved', label: tr('calcResultSaved', locale), accent: true },
  { id: 'out-hours', label: tr('calcResultHours', locale), accent: false },
];
const ctaHref = url(locale === 'ru' ? '/#kontakt' : '/en/#contact');
---

<section
  id={locale === 'ru' ? 'raschet' : 'calculator'}
  class="on-dark relative scroll-mt-20 overflow-hidden bg-ink/55 py-20 text-steel-100 md:py-28"
>
  <div class="rule-ticks absolute top-0 right-0 left-0 opacity-25"></div>

  <div class="shell">
    <div class="reveal grid gap-6 md:grid-cols-[auto_1fr] md:gap-14">
      <p class="plate !text-cyan md:pt-3">{tr('calcPlate', locale)}</p>
      <div>
        <h2 class="text-big text-steel-50">{tr('calcTitle', locale)}</h2>
        <p class="mt-5 max-w-2xl text-[1.02rem] leading-relaxed text-steel-300">{tr('calcLead', locale)}</p>
      </div>
    </div>

    <div class="reveal mt-14 grid gap-10 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
      <!-- Регуляторы -->
      <div class="space-y-8" data-cur={cfg.cur} data-loc={cfg.loc} data-floor={cfg.floor}>
        {
          sliders.map((s) => (
            <div>
              <div class="flex items-baseline justify-between gap-4">
                <label for={s.id} class="text-[0.92rem] text-steel-200">
                  {s.label}
                </label>
                <output
                  id={`${s.id}-val`}
                  for={s.id}
                  class="font-mono text-[1.05rem] font-bold text-brass tabular-nums"
                >
                  {s.def}
                  {s.suffix}
                </output>
              </div>
              <input
                type="range"
                id={s.id}
                class="calc-range mt-3 w-full"
                min={s.min}
                max={s.max}
                step={s.step}
                value={s.def}
                data-suffix={s.suffix}
              />
              <div class="mt-1.5 flex justify-between font-mono text-[0.65rem] text-steel-300/60">
                <span>{s.min}{s.suffix}</span>
                <span>{s.max}{s.suffix}</span>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Табло -->
      <div class="panel rounded-2xl">
        <div class="flex items-center justify-between border-b border-steel-300/20 px-5 py-3">
          <span class="plate !text-steel-300">{locale === 'ru' ? 'Показания' : 'Readout'}</span>
          <span class="flex items-center gap-1.5 font-mono text-[0.65rem] tracking-wider text-moss-200">
            <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-moss-200"></span>
            {locale === 'ru' ? 'СЧЁТ ИДЁТ' : 'LIVE'}
          </span>
        </div>

        <dl class="divide-y divide-steel-300/15">
          {
            outputs.map((o) => (
              <div class="flex items-baseline justify-between gap-5 px-5 py-5">
                <dt class="max-w-[52%] text-[0.88rem] leading-snug text-steel-300">{o.label}</dt>
                <dd
                  id={o.id}
                  class:list={[
                    'font-display text-[1.5rem] font-bold tabular-nums md:text-[1.85rem]',
                    o.accent ? 'grad-text' : 'text-steel-50',
                  ]}
                >
                  —
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="flex items-center gap-5 px-5 pt-3 pb-5">
          <div class="relative shrink-0">
            <svg width="88" height="88" viewBox="0 0 120 120" class="-rotate-90" aria-hidden="true">
              <circle class="calc-ring-track" cx="60" cy="60" r="52" fill="none" stroke-width="10" />
              <circle
                id="out-ring"
                cx="60"
                cy="60"
                r="52"
                fill="none"
                stroke-width="10"
                stroke-linecap="round"
                stroke="url(#calcGrad)"
                stroke-dasharray="326.7"
                stroke-dashoffset="130.7"
                style="transition: stroke-dashoffset 0.5s var(--ease-station, ease)"
              />
              <defs>
                <linearGradient id="calcGrad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="var(--color-cyan)" />
                  <stop offset="1" stop-color="var(--color-violet)" />
                </linearGradient>
              </defs>
            </svg>
            <span
              id="out-ring-label"
              class="absolute inset-0 grid place-items-center font-mono text-[1rem] font-bold text-steel-50 tabular-nums"
              >60%</span
            >
          </div>
          <div class="min-w-0">
            <p class="plate !text-steel-300">{locale === 'ru' ? 'Автоматизируется' : 'Automated'}</p>
            <p class="mt-2 text-[0.76rem] leading-relaxed text-steel-300/70">{tr('calcFormula', locale)}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="reveal mt-10">
      <a href={ctaHref} class="btn btn-ghost">{tr('calcCta', locale)} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .calc-range {
    appearance: none;
    height: 6px;
    border-radius: 999px;
    /* Заливка до бегунка задаётся из JS через --fill; за ней — приглушённый трек */
    background: linear-gradient(
      90deg,
      var(--color-brass) 0 var(--fill, 50%),
      color-mix(in oklab, var(--color-steel-300) 28%, transparent) var(--fill, 50%) 100%
    );
    cursor: pointer;
    outline: none;
  }
  .calc-range::-webkit-slider-thumb {
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: radial-gradient(circle at 50% 40%, #fff2cf, var(--color-brass) 60%);
    border: 2px solid var(--color-ink);
    box-shadow:
      0 0 0 1px var(--color-brass),
      0 0 14px color-mix(in oklab, var(--color-brass) 70%, transparent);
    cursor: grab;
    transition: transform 0.18s var(--ease-back, cubic-bezier(0.34, 1.56, 0.64, 1)),
      box-shadow 0.18s ease;
  }
  .calc-range:hover::-webkit-slider-thumb {
    transform: scale(1.1);
  }
  .calc-range:active::-webkit-slider-thumb {
    transform: scale(1.22);
    box-shadow:
      0 0 0 1px var(--color-brass),
      0 0 22px color-mix(in oklab, var(--color-brass) 90%, transparent);
    cursor: grabbing;
  }
  .calc-range:focus-visible::-webkit-slider-thumb {
    outline: 2px solid var(--color-cyan);
    outline-offset: 3px;
  }
  .calc-range::-moz-range-progress {
    height: 6px;
    border-radius: 999px;
    background: var(--color-brass);
  }
  .calc-range::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border: 2px solid var(--color-ink);
    border-radius: 999px;
    background: radial-gradient(circle at 50% 40%, #fff2cf, var(--color-brass) 60%);
    box-shadow: 0 0 0 1px var(--color-brass), 0 0 14px color-mix(in oklab, var(--color-brass) 70%, transparent);
    cursor: grab;
  }
  /* Пульс на строке экономии при пересчёте */
  @keyframes calc-pop {
    0% { transform: scale(1); }
    35% { transform: scale(1.06); }
    100% { transform: scale(1); }
  }
  .calc-pop { animation: calc-pop 0.4s var(--ease-station, ease); }
  .calc-ring-track { stroke: color-mix(in oklab, var(--color-steel-300) 20%, transparent); }
  @media (prefers-reduced-motion: reduce) {
    .calc-pop { animation: none; }
    .calc-range::-webkit-slider-thumb { transition: none; }
  }
</style>

<script>
  // Расчёт стоимости рутины. Формула открыта и продублирована в тексте под табло.
  const WEEKS = 47; // рабочих недель в году за вычетом отпуска и праздников

  const panel = document.querySelector<HTMLElement>('[data-floor]');
  if (panel) {
    const cur = panel.dataset.cur!;
    const loc = panel.dataset.loc!;
    const floor = Number(panel.dataset.floor);

    const el = (id: string) => document.getElementById(id)!;
    const ids = ['people', 'hours', 'rate', 'auto'] as const;
    const inputs = Object.fromEntries(ids.map((i) => [i, el(i) as HTMLInputElement])) as Record<
      (typeof ids)[number],
      HTMLInputElement
    >;

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const money = (n: number) =>
      loc === 'ru-RU'
        ? `${Math.round(n).toLocaleString('ru-RU')} ${cur}`
        : `${cur}${Math.round(n).toLocaleString('en-US')}`;

    // Плавный «набег» числа к новому значению — цифры не прыгают, а перетекают.
    const anims = new Map<HTMLElement, { raf: number; cur: number }>();
    function animateNum(elm: HTMLElement, target: number, fmt: (n: number) => string) {
      const state = anims.get(elm) ?? { raf: 0, cur: target };
      const from = state.cur;
      if (reduce || from === target) {
        if (state.raf) cancelAnimationFrame(state.raf);
        elm.textContent = fmt(target);
        anims.set(elm, { raf: 0, cur: target });
        return;
      }
      if (state.raf) cancelAnimationFrame(state.raf);
      const start = performance.now();
      const dur = 380;
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / dur);
        const e = 1 - Math.pow(1 - t, 3); // easeOutCubic
        const v = from + (target - from) * e;
        elm.textContent = fmt(v);
        if (t < 1) {
          anims.set(elm, { raf: requestAnimationFrame(tick), cur: v });
        } else {
          elm.textContent = fmt(target);
          anims.set(elm, { raf: 0, cur: target });
        }
      };
      anims.set(elm, { raf: requestAnimationFrame(tick), cur: from });
    }

    const CIRC = 2 * Math.PI * 52; // длина окружности кольца автоматизации
    const ring = el('out-ring') as unknown as SVGCircleElement;
    const ringLabel = el('out-ring-label');
    const saved = el('out-saved');
    let popTimer = 0;

    function render() {
      const people = +inputs.people.value;
      const hours = +inputs.hours.value;
      const rate = +inputs.rate.value;
      const auto = +inputs.auto.value / 100;

      for (const id of ids) {
        const input = inputs[id];
        const out = el(`${id}-val`);
        const v = +input.value;
        out.textContent = (id === 'rate' ? v.toLocaleString(loc) : String(v)) + (input.dataset.suffix ?? '');
        // Заливка трека до бегунка
        const pct = ((v - +input.min) / (+input.max - +input.min)) * 100;
        input.style.setProperty('--fill', `${pct}%`);
      }

      const annual = people * hours * rate * WEEKS;
      const savedVal = annual * auto;
      const hoursBack = people * hours * WEEKS * auto;

      animateNum(el('out-cost'), annual, money);
      animateNum(saved, savedVal, money);
      animateNum(el('out-hours'), hoursBack, (n) => Math.round(n).toLocaleString(loc));

      // Кольцо автоматизации
      ring.style.strokeDashoffset = String(CIRC * (1 - auto));
      ringLabel.textContent = `${Math.round(auto * 100)}%`;

      // Короткий пульс на строке экономии — глаз ловит, что число ожило
      if (!reduce) {
        saved.classList.remove('calc-pop');
        clearTimeout(popTimer);
        // reflow, чтобы анимация перезапустилась
        void saved.offsetWidth;
        saved.classList.add('calc-pop');
        popTimer = window.setTimeout(() => saved.classList.remove('calc-pop'), 420);
      }
    }

    ids.forEach((i) => inputs[i].addEventListener('input', render));
    render();
  }
</script>
