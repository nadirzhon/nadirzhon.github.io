---
import { url, type Locale } from '../data/site';
import { tr } from '../data/i18n';
import { orderedServices, type Service } from '../data/services';

interface Props {
  service: Service;
  locale: Locale;
}
const { service: s, locale } = Astro.props;
const base = locale === 'ru' ? '/uslugi' : '/en/services';
const home = url(locale === 'ru' ? '/' : '/en/');
const contact = url(locale === 'ru' ? '/#kontakt' : '/en/#contact');
const fmt = (n: number) =>
  locale === 'ru' ? `${n.toLocaleString('ru-RU')} ₽` : `€${Math.round(n / 100).toLocaleString('en-US')}`;
const others = orderedServices.filter((o) => o.code !== s.code).slice(0, 4);
---

<article>
  <!-- Заголовок -->
  <section class="border-b border-slate-1/20 py-14 md:py-20">
    <div class="shell">
      <nav class="flex items-center gap-2 font-mono text-[0.7rem] tracking-widest text-slate-1 uppercase">
        <a href={home} class="transition-colors hover:text-ink">{tr('backHome', locale)}</a>
        <span aria-hidden="true">/</span>
        <span>{s.code}</span>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
        <div>
          <h1 class="text-big">{s.title[locale]}</h1>
          <p class="mt-4 font-display text-[1.15rem] leading-snug font-medium text-brass md:text-[1.35rem]">
            {s.tagline[locale]}
          </p>
          <p class="mt-7 max-w-2xl text-[1.02rem] leading-relaxed text-slate-2">{s.intro[locale]}</p>
          <a href={contact} class="btn btn-primary mt-9">{tr('navContact', locale)} <span aria-hidden="true">→</span></a>
        </div>

        <aside class="self-start border border-slate-1/30 bg-steel-100/60">
          <dl class="divide-y divide-slate-1/20">
            <div class="px-6 py-5">
              <dt class="plate">{tr('serviceFrom', locale)}</dt>
              <dd class="mt-2 font-display text-[1.7rem] font-bold">{fmt(s.priceFrom)}</dd>
            </div>
            <div class="px-6 py-5">
              <dt class="plate">{tr('serviceTerm', locale)}</dt>
              <dd class="mt-2 text-[0.95rem] text-slate-2">{s.timeline[locale]}</dd>
            </div>
            <div class="px-6 py-5">
              <dt class="plate">{tr('serviceWho', locale)}</dt>
              <dd class="mt-2 text-[0.95rem] leading-relaxed text-slate-2">{s.forWhom[locale]}</dd>
            </div>
            <div class="px-6 py-5">
              <dt class="plate">{tr('serviceStack', locale)}</dt>
              <dd class="mt-3 flex flex-wrap gap-1.5">
                {
                  s.stack.map((x) => (
                    <span class="border border-slate-1/30 px-2 py-1 font-mono text-[0.66rem] text-slate-1">{x}</span>
                  ))
                }
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- Смета: база плюс допы -->
  <section class="border-b border-slate-1/20 py-16 md:py-24">
    <div class="shell grid gap-8 md:grid-cols-[auto_1fr] md:gap-14">
      <p class="plate md:pt-3">{tr('serviceAddons', locale)}</p>

      <div>
        <p class="max-w-2xl text-[1rem] leading-relaxed text-slate-2">{tr('serviceAddonsLead', locale)}</p>

        <div id="quote" class="mt-9 grid gap-8 lg:grid-cols-[1fr_20rem] lg:gap-12" data-base={s.priceFrom} data-locale={locale}>
          <div>
            <!-- База: всегда включена, снять нельзя -->
            <div class="flex items-start gap-4 border-y border-slate-1/25 bg-steel-100/60 px-4 py-4">
              <span aria-hidden="true" class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center bg-brass text-[0.7rem] leading-none font-bold text-ink">
                ✓
              </span>
              <span class="flex-1">
                <span class="block text-[0.98rem] leading-snug font-semibold">{tr('serviceBase', locale)}</span>
                <span class="mt-1 block text-[0.92rem] leading-snug text-slate-2">{s.baseScope[locale]}</span>
              </span>
              <span class="font-mono text-[0.85rem] whitespace-nowrap">{fmt(s.priceFrom)}</span>
            </div>

            <!-- Допы -->
            <ul class="border-b border-slate-1/25">
              {
                s.addons.map((a) => (
                  <li class="border-t border-slate-1/25">
                    <label class="group flex cursor-pointer items-start gap-4 px-4 py-4">
                      <input type="checkbox" class="peer sr-only" data-price={a.price} />
                      <span
                        aria-hidden="true"
                        class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center border border-slate-1/50 transition-colors group-hover:border-ink peer-checked:border-brass peer-checked:bg-brass"
                      >
                        <span class="tick text-[0.7rem] leading-none font-bold text-ink">✓</span>
                      </span>
                      <span class="flex-1 text-[0.96rem] leading-snug text-slate-2 transition-colors peer-checked:text-ink">
                        {a.title[locale]}
                      </span>
                      <span class="font-mono text-[0.85rem] whitespace-nowrap text-slate-1">+{fmt(a.price)}</span>
                    </label>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Итог -->
          <aside class="self-start border border-ink bg-ink p-6 text-steel-100 lg:sticky lg:top-24">
            <p class="plate !text-brass">{tr('serviceTotal', locale)}</p>
            <p id="quote-total" class="mt-3 font-display text-[2rem] leading-none font-bold text-steel-50">
              {fmt(s.priceFrom)}
            </p>
            <p id="quote-parts" class="mt-3 font-mono text-[0.72rem] tracking-wider text-steel-300">
              {locale === 'ru' ? 'база + 0 допов' : 'base + 0 add-ons'}
            </p>
            <p class="mt-5 text-[0.85rem] leading-relaxed text-steel-300">{tr('serviceTotalHint', locale)}</p>
            <a href={contact} class="btn mt-6 w-full justify-center !border-brass !bg-brass !text-ink hover:!bg-brass-200">
              {tr('navContact', locale)}
            </a>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- Что получаете -->
  <section class="border-b border-slate-1/20 py-16 md:py-24">
    <div class="shell grid gap-8 md:grid-cols-[auto_1fr] md:gap-14">
      <p class="plate md:pt-3">{tr('serviceGet', locale)}</p>
      <ul class="max-w-3xl divide-y divide-slate-1/20 border-y border-slate-1/20">
        {
          s.deliverables[locale].map((d, i) => (
            <li class="reveal flex gap-6 py-5">
              <span class="font-mono text-[0.75rem] text-brass">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-[1rem] leading-relaxed text-slate-2">{d}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    s.caveat && (
      <section class="on-dark bg-ink py-14 text-steel-100 md:py-16">
        <div class="shell grid gap-6 md:grid-cols-[auto_1fr] md:gap-14">
          <p class="plate !text-brass md:pt-1">{tr('serviceHonest', locale)}</p>
          <p class="max-w-3xl text-[1.02rem] leading-relaxed text-steel-200">{s.caveat[locale]}</p>
        </div>
      </section>
    )
  }

  <!-- Соседние услуги -->
  <section class="border-t border-slate-1/20 py-16 md:py-20">
    <div class="shell">
      <p class="plate">{tr('servicesPlate', locale)}</p>
      <ul class="mt-7 grid gap-px bg-slate-1/25 sm:grid-cols-2 lg:grid-cols-4">
        {
          others.map((o) => (
            <li>
              <a href={url(`${base}/${o.slug[locale]}/`)} class="group block h-full bg-steel-50 p-6 transition-colors hover:bg-ink">
                <span class="font-mono text-[0.7rem] tracking-widest text-slate-1 group-hover:text-brass">{o.code}</span>
                <span class="mt-3 block font-display text-[1.05rem] leading-tight font-bold group-hover:text-steel-50">
                  {o.title[locale]}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</article>

<style>
  .tick {
    transform: scale(0);
    transition: transform 0.2s var(--ease-station);
  }
  input:checked ~ span .tick {
    transform: scale(1);
  }
</style>

<script>
  // Живая смета: база плюс отмеченные допы
  const quote = document.getElementById('quote');
  const total = document.getElementById('quote-total');
  const parts = document.getElementById('quote-parts');

  if (quote && total && parts) {
    const base = Number(quote.dataset.base);
    const ru = quote.dataset.locale === 'ru';
    const boxes = Array.from(quote.querySelectorAll<HTMLInputElement>('input[type=checkbox]'));

    const money = (n: number) =>
      ru ? `${n.toLocaleString('ru-RU')} ₽` : `€${Math.round(n / 100).toLocaleString('en-US')}`;

    const word = (n: number) => {
      if (!ru) return n === 1 ? 'add-on' : 'add-ons';
      const t = n % 10;
      const h = n % 100;
      if (t === 1 && h !== 11) return 'доп';
      if (t >= 2 && t <= 4 && (h < 10 || h > 20)) return 'допа';
      return 'допов';
    };

    const update = () => {
      const picked = boxes.filter((b) => b.checked);
      const sum = picked.reduce((acc, b) => acc + Number(b.dataset.price), base);
      total.textContent = money(sum);
      parts.textContent = ru
        ? `база + ${picked.length} ${word(picked.length)}`
        : `base + ${picked.length} ${word(picked.length)}`;
    };

    boxes.forEach((b) => b.addEventListener('change', update));
    update();
  }
</script>
