---
import { url, type Locale } from '../data/site';
import { tr } from '../data/i18n';
import { orderedServices, type Service } from '../data/services';

interface Props {
  service: Service;
  locale: Locale;
}
const { service: s, locale } = Astro.props;
const base = locale === 'ru' ? '/uslugi' : '/en/services';
const home = url(locale === 'ru' ? '/' : '/en/');
const contact = url(locale === 'ru' ? '/#kontakt' : '/en/#contact');
const others = orderedServices.filter((o) => o.code !== s.code).slice(0, 4);
---

<article data-service-code={s.code}>
  <!-- Заголовок -->
  <section class="border-b border-slate-1/20 py-14 md:py-20">
    <div class="shell">
      <nav class="flex items-center gap-2 font-mono text-[0.7rem] tracking-widest text-slate-1 uppercase">
        <a href={home} class="transition-colors hover:text-steel-50">{tr('backHome', locale)}</a>
        <span aria-hidden="true">/</span>
        <span>{s.code}</span>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
        <div>
          <h1 class="text-big">{s.title[locale]}</h1>
          <p class="mt-4 font-display text-[1.15rem] leading-snug font-medium text-brass md:text-[1.35rem]">
            {s.tagline[locale]}
          </p>
          <p class="mt-7 max-w-2xl text-[1.02rem] leading-relaxed text-steel-300">{s.intro[locale]}</p>
          <a href={contact} class="btn btn-primary mt-9">{tr('navContact', locale)} <span aria-hidden="true">→</span></a>
        </div>

        <aside class="panel self-start rounded-2xl overflow-hidden">
          <dl class="divide-y divide-slate-1/20">
            <div class="px-6 py-5">
              <dt class="plate">{tr('serviceStart', locale)}</dt>
              <dd class="mt-2 text-[0.95rem] text-steel-300">{tr('serviceStartHint', locale)}</dd>
            </div>
            <div class="px-6 py-5">
              <dt class="plate">{tr('serviceTerm', locale)}</dt>
              <dd class="mt-2 text-[0.95rem] text-steel-300">{s.timeline[locale]}</dd>
            </div>
            <div class="px-6 py-5">
              <dt class="plate">{tr('serviceWho', locale)}</dt>
              <dd class="mt-2 text-[0.95rem] leading-relaxed text-steel-300">{s.forWhom[locale]}</dd>
            </div>
            <div class="px-6 py-5">
              <dt class="plate">{tr('serviceStack', locale)}</dt>
              <dd class="mt-3 flex flex-wrap gap-1.5">
                {
                  s.stack.map((x) => (
                    <span class="border border-slate-1/30 px-2 py-1 font-mono text-[0.66rem] text-slate-1">{x}</span>
                  ))
                }
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- Конструктор объёма: база плюс блоки. Денег здесь нет намеренно -->
  <section class="border-b border-slate-1/20 py-16 md:py-24">
    <div class="shell grid gap-8 md:grid-cols-[auto_1fr] md:gap-14">
      <p class="plate md:pt-3">{tr('serviceAddons', locale)}</p>

      <div>
        <p class="max-w-2xl text-[1rem] leading-relaxed text-steel-300">{tr('serviceAddonsLead', locale)}</p>

        <div id="quote" class="mt-9 grid gap-8 lg:grid-cols-[1fr_20rem] lg:gap-12" data-locale={locale}>
          <div>
            <!-- База: всегда включена, снять нельзя -->
            <div class="flex items-start gap-4 rounded-xl border border-cyan/25 bg-cyan/5 px-4 py-4">
              <span aria-hidden="true" class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-md bg-gradient-to-br from-cyan to-violet text-[0.7rem] leading-none font-bold text-void">
                ✓
              </span>
              <span class="flex-1">
                <span class="block text-[0.98rem] leading-snug font-semibold">{tr('serviceBase', locale)}</span>
                <span class="mt-1 block text-[0.92rem] leading-snug text-steel-300">{s.baseScope[locale]}</span>
              </span>
              
            </div>

            <!-- Блоки по необходимости -->
            <ul class="border-b border-slate-1/25">
              {
                s.addons.map((a) => (
                  <li class="border-t border-slate-1/25">
                    <label class="group flex cursor-pointer items-start gap-4 px-4 py-4">
                      <input type="checkbox" class="peer sr-only" data-addon={a.title[locale]} />
                      <span
                        aria-hidden="true"
                        class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center border border-slate-1/50 transition-colors group-hover:border-ink peer-checked:border-transparent peer-checked:bg-cyan"
                      >
                        <span class="tick text-[0.7rem] leading-none font-bold text-void">✓</span>
                      </span>
                      <span class="flex-1 text-[0.96rem] leading-snug text-steel-300 transition-colors peer-checked:text-steel-50">
                        {a.title[locale]}
                      </span>
                      
                    </label>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Итог -->
          <aside class="panel self-start rounded-2xl p-6 text-steel-100 lg:sticky lg:top-24">
            <p class="plate !text-cyan">{tr('serviceTotal', locale)}</p>
            <p id="quote-total" class="mt-3 font-display text-[2rem] leading-none font-bold text-steel-50">
              1
            </p>
            <p id="quote-parts" class="mt-3 font-mono text-[0.72rem] tracking-wider text-steel-300">
              {locale === 'ru' ? 'база + 0 допов' : 'base + 0 add-ons'}
            </p>
            <p class="mt-5 text-[0.85rem] leading-relaxed text-steel-300">{tr('serviceTotalHint', locale)}</p>
            <a href={contact} class="btn btn-primary mag mt-6 w-full justify-center">
              {tr('navContact', locale)}
            </a>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- Что получаете -->
  <section class="border-b border-slate-1/20 py-16 md:py-24">
    <div class="shell grid gap-8 md:grid-cols-[auto_1fr] md:gap-14">
      <p class="plate md:pt-3">{tr('serviceGet', locale)}</p>
      <ul class="max-w-3xl divide-y divide-slate-1/20 border-y border-slate-1/20">
        {
          s.deliverables[locale].map((d, i) => (
            <li class="reveal flex gap-6 py-5">
              <span class="font-mono text-[0.75rem] text-brass">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-[1rem] leading-relaxed text-steel-300">{d}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    s.caveat && (
      <section class="on-dark bg-ink py-14 text-steel-100 md:py-16">
        <div class="shell grid gap-6 md:grid-cols-[auto_1fr] md:gap-14">
          <p class="plate !text-cyan md:pt-1">{tr('serviceHonest', locale)}</p>
          <p class="max-w-3xl text-[1.02rem] leading-relaxed text-steel-200">{s.caveat[locale]}</p>
        </div>
      </section>
    )
  }

  <!-- Соседние услуги -->
  <section class="border-t border-slate-1/20 py-16 md:py-20">
    <div class="shell">
      <p class="plate">{tr('servicesPlate', locale)}</p>
      <ul class="mt-7 grid gap-3 md:gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          others.map((o) => (
            <li>
              <a href={url(`${base}/${o.slug[locale]}/`)} class="group block h-full panel rounded-2xl p-6 transition-colors hover:bg-ink">
                <span class="font-mono text-[0.7rem] tracking-widest text-slate-1 group-hover:text-brass">{o.code}</span>
                <span class="mt-3 block font-display text-[1.05rem] leading-tight font-bold group-hover:text-steel-50">
                  {o.title[locale]}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</article>

<style>
  .tick {
    transform: scale(0);
    transition: transform 0.2s var(--ease-station);
  }
  input:checked ~ span .tick {
    transform: scale(1);
  }
</style>

<script>
  // Живой объём работ: база плюс отмеченные блоки
  const quote = document.getElementById('quote');
  const total = document.getElementById('quote-total');
  const parts = document.getElementById('quote-parts');

  if (quote && total && parts) {
    const ru = quote.dataset.locale === 'ru';
    const boxes = Array.from(quote.querySelectorAll<HTMLInputElement>('input[type=checkbox]'));

    const word = (n: number) => {
      if (!ru) return n === 1 ? 'block' : 'blocks';
      const t = n % 10;
      const h = n % 100;
      if (t === 1 && h !== 11) return 'блок';
      if (t >= 2 && t <= 4 && (h < 10 || h > 20)) return 'блока';
      return 'блоков';
    };

    // Считаем объём, а не деньги: сумма называется после разбора задачи
    const update = () => {
      const picked = boxes.filter((b) => b.checked);
      const n = picked.length + 1; // база входит всегда
      total.textContent = String(n);
      parts.textContent = ru
        ? `${word(n)} в работе: база + ${picked.length}`
        : `${word(n)} in scope: base + ${picked.length}`;
      // Выбранное уезжает в форму заявки — человеку не нужно перепечатывать
      const names = picked.map((b) => b.dataset.addon).filter(Boolean);
      try { sessionStorage.setItem('autonoma.scope', JSON.stringify(names)); } catch {}
    };

    boxes.forEach((b) => b.addEventListener('change', update));
    update();
  }

  // Уходя отсюда в форму заявки, человек не должен заново выбирать направление:
  // запоминаем услугу, с которой он пришёл, — форма отметит её сама.
  const page = document.querySelector<HTMLElement>('[data-service-code]');
  const code = page?.dataset.serviceCode;
  if (code) {
    document
      .querySelectorAll<HTMLAnchorElement>('a[href*="#kontakt"], a[href*="#contact"]')
      .forEach((a) =>
        a.addEventListener('click', () => {
          try { sessionStorage.setItem('autonoma.service', code); } catch {}
        }),
      );
  }
</script>
